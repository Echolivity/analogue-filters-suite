;\nHistory H_os_R_upa2(0.0);\nHistory H_os_R_upa3(0.0);\nHistory H_os_R_upa4(0.0);\nHistory H_os_R_upa5(0.0);\nHistory H_os_R_upb0(0.0);\nHistory H_os_R_upb1(0.0);\nHistory H_os_R_upb2(0.0);\nHistory H_os_R_upb3(0.0);\nHistory H_os_R_upb4(0.0);\nHistory H_os_R_upb5(0.0);\nHistory H_os_R_dna0(0.0);\nHistory H_os_R_dna1(0.0);\nHistory H_os_R_dna2(0.0);\nHistory H_os_R_dna3(0.0);\nHistory H_os_R_dna4(0.0);\nHistory H_os_R_dna5(0.0);\nHistory H_os_R_dnb0(0.0);\nHistory H_os_R_dnb1(0.0);\nHistory H_os_R_dnb2(0.0);\nHistory H_os_R_dnb3(0.0);\nHistory H_os_R_dnb4(0.0);\nHistory H_os_R_dnb5(0.0);\nHistory H_dc_R_x(0.0);\nHistory H_dc_R_y(0.0);\nHistory H_l_lc(14.287712379549449);\nHistory H_l_rz(0);\nHistory H_l_drv(0);\nHistory H_l_cmp(1.0);\nHistory H_l_chr(0);\nHistory H_l_en(1);\nHistory H_l_ti(1);\nHistory H_l_w0(1);\nHistory H_l_w1(0);\nHistory H_l_w2(0);\nHistory H_l_w3(0);\nHistory H_l_cur(2);\nHistory H_l_prev(2);\nHistory H_l_fade(1);\nHistory H_h_lc(4.321928094887363);\nHistory H_h_rz(0);\nHistory H_h_drv(0);\nHistory H_h_cmp(1.0);\nHistory H_h_chr(0);\nHistory H_h_en(1);\nHistory H_h_ti(0);\nHistory H_h_w0(1);\nHistory H_h_w1(0);\nHistory H_h_w2(0);\nHistory H_h_w3(0);\nHistory H_h_cur(1);\nHistory H_h_prev(1);\nHistory H_h_fade(1);\nHistory H_cur_order(0);\nHistory H_cur_os(0);\nHistory H_duck(1);\nHistory H_og(1);\nHistory H_init(0);\n\n// ---------- helpers ----------\n// TPT one-pole lowpass. returns lp, new_state\nf_op(x, s, G) {\n\tv = (x - s) * G;\n\tlp = v + s;\n\treturn lp, lp + v;\n}\n\n// secant gain of tanh: tanh(v)/v  (1 at v=0)\nf_tg(v) {\n\ta = abs(v);\n\tr = 1 - a * a * 0.333333333;\n\tif (a > 0.001) {\n\t\tr = tanh(v) / v;\n\t}\n\treturn r;\n}\n\n// secant gain of an asymmetric diode-like curve with unit slope at 0\n// curve: (tanh(v + b) - tanh(b)) / (1 - tanh(b)^2), b = 0.35\nf_dg(v) {\n\ta = abs(v);\n\tr = 1 - 0.3363755443363322 * v;\n\tif (a > 0.001) {\n\t\tr = (tanh(v + 0.35) - 0.3363755443363322) / (v * 0.8868514931724362);\n\t}\n\treturn max(r, 0);\n}\n\n// secant gain of algebraic hard-knee sigmoid v/sqrt(1+v^2)\nf_ag(v) {\n\treturn 1 / sqrt(1 + v * v);\n}\n\n// asymmetric soft clip with unit slope at 0\nf_asym(x) {\n\treturn (tanh(x + 0.35) - 0.3363755443363322) / 0.8868514931724362;\n}\n\n// ---------- TPT state-variable filter (Zavalishin) ----------\n// returns hp, bp, lp, new_s1, new_s2\nf_svf(x, s1, s2, g, R) {\n\th = (x - (2 * R + g) * s1 - s2) / (1 + 2 * R * g + g * g);\n\tb = g * h + s1;\n\tl = g * b + s2;\n\treturn h, b, l, g * h + b, g * b + l;\n}\n\n// ---------- 4x4 tridiagonal solve (Thomas algorithm) ----------\n// rows: [B1 C1 . .], [A2 B2 C2 .], [. A3 B3 C3], [. . A4 B4]\nf_tri4(d1, d2, d3, d4, B1, C1, A2, B2, C2, A3, B3, C3, A4, B4) {\n\tc1 = C1 / B1;\n\te1 = d1 / B1;\n\tm2 = B2 - A2 * c1;\n\tc2 = C2 / m2;\n\te2 = (d2 - A2 * e1) / m2;\n\tm3 = B3 - A3 * c2;\n\tc3 = C3 / m3;\n\te3 = (d3 - A3 * e2) / m3;\n\ty4 = (d4 - A4 * e3) / (B4 - A4 * c3);\n\ty3 = e3 - c3 * y4;\n\ty2 = e2 - c2 * y3;\n\ty1 = e1 - c1 * y2;\n\treturn y1, y2, y3, y4;\n}\n\n// ================= MODEL 01: Sherman Filterbank-inspired =================\n// No schematic is public. Structure follows the published description: input\n// overdrive stage -> filter 1 -> filter 2 in series (24 dB when tuned equal),\n// filter 2 more resonant than filter 1. Plus a saturated feedback path\n// (output -> input, unit delay) for the Filterbank's howl.\n// R1: filter-1 damping (mild); Rt: filter-2 damping (to self-oscillation).\n// ti: 0 = filter 2 alone (12 dB), 1 = filter 1 -> filter 2 (24 dB)\n// returns y, y, s1a, s2a, ba, s1b, s2b, bb, yprev\nf_sherman(x, s1a, s2a, ba, s1b, s2b, bb, yp, g, R1, Rt, fb, ti, hp) {\n\tu = f_asym(1.6 * (x + fb * yp)) * 0.625;\n\tRa = 1 - (1 - R1) * f_tg(ba);\n\th1, b1, l1, n1a, n2a = f_svf(u, s1a, s2a, g, Ra);\n\to1 = hp > 0.5 ? h1 : l1;\n\tRb = 1 - (1 - Rt) * f_ag(bb * 2);\n\ti2 = u + ti * (o1 - u);\n\th2, b2, l2, n1b, n2b = f_svf(i2, s1b, s2b, g, Rb);\n\to2 = hp > 0.5 ? h2 : l2;\n\tynext = tanh(o2);\n\treturn o2, o2, fixdenorm(n1a), fixdenorm(n2a), b1, fixdenorm(n1b), fixdenorm(n2b), b2, ynext;\n}\n\n// ================= MODEL 02: Korg 35 (MS-20 Mk1)-inspired =================\n// Sallen-Key style: LP1 -> sum -> LP2 -> y ; y*K -> HP1 -> sum   (lowpass)\n//                   HP1 -> sum -> HP2 -> y ; y*K -> LP1 -> sum   (highpass)\n// Zero-delay-feedback solve, tanh in the loop, and diode-style limiting of\n// the feedback gain K (secant of tanh at level L, from previous output).\n// returns y, s1, s2, s3, yprev\nf_k35lp(x, s1, s2, s3, yp, g, K0, L) {\n\tG = g / (1 + g);\n\tig = 1 / (1 + g);\n\tK = K0 * f_tg(K0 * yp / L);\n\ty1, n1 = f_op(x, s1, G);\n\tu = (y1 + ig * (K * ig * s2 - s3)) / (1 - K * G * ig);\n\tu = 0.85 * tanh(u * 1.17647058824);\n\ty, n2 = f_op(u, s2, G);\n\tl3, n3 = f_op(K * y, s3, G);\n\treturn y, fixdenorm(n1), fixdenorm(n2), fixdenorm(n3), y;\n}\n\nf_k35hp(x, s1, s2, s3, yp, g, K0, L) {\n\tG = g / (1 + g);\n\tig = 1 / (1 + g);\n\tK = K0 * f_tg(K0 * yp / L);\n\tl1, n1 = f_op(x, s1, G);\n\ty1 = x - l1;\n\tu = (y1 + ig * (s3 - G * K * s2)) / (1 - K * G * ig);\n\tu = 0.85 * tanh(u * 1.17647058824);\n\tl2, n2 = f_op(u, s2, G);\n\ty = u - l2;\n\tl3, n3 = f_op(K * y, s3, G);\n\treturn y, fixdenorm(n1), fixdenorm(n2), fixdenorm(n3), y;\n}\n\n// ================= MODEL 03: Moog transistor ladder-inspired =================\n// Circuit: each ladder stage is a transistor differential pair loaded by a\n// capacitor, so each stage obeys  dy_i/dt = w (tanh(y_{i-1}) - tanh(y_i)),\n// driven by the input pair tanh(x - k y4)  (Huovilainen, DAFx-04).\n// Solved here with zero-delay feedback: every tanh is replaced by its secant\n// gain at the previous sample (T = tanh(v)/v), which makes each stage\n// linear for the current sample, so the global feedback is solved exactly.\n// hs scales the stage pairs' saturation (CHARACTER: STAGE SAT).\n// returns y12, y24, s1..s4, p0..p4\nf_ladder(x, s1, s2, s3, s4, p0, p1, p2, p3, p4, g, k, bc, hs, hp) {\n\tT0 = f_tg(1.4 * p0);\n\tT1 = f_tg(1.4 * hs * p1);\n\tT2 = f_tg(1.4 * hs * p2);\n\tT3 = f_tg(1.4 * hs * p3);\n\tT4 = f_tg(1.4 * hs * p4);\n\ti1 = 1 / (1 + g * T1);\n\ti2 = 1 / (1 + g * T2);\n\ti3 = 1 / (1 + g * T3);\n\ti4 = 1 / (1 + g * T4);\n\tG1 = g * T0 * i1;\n\tG2 = g * T1 * i2;\n\tG3 = g * T2 * i3;\n\tG4 = g * T3 * i4;\n\tS = G2 * G3 * G4 * s1 * i1 + G3 * G4 * s2 * i2 + G4 * s3 * i3 + s4 * i4;\n\tu = (x * (1 + k * bc) - k * S) / (1 + k * G1 * G2 * G3 * G4);\n\ty1 = G1 * u + s1 * i1;\n\ty2 = G2 * y1 + s2 * i2;\n\ty3 = G3 * y2 + s3 * i3;\n\ty4 = G4 * y3 + s4 * i4;\n\to12 = y2;\n\to24 = y4;\n\tif (hp > 0.5) {\n\t\to12 = u - 2 * y1 + y2;\n\t\to24 = u - 4 * y1 + 6 * y2 - 4 * y3 + y4;\n\t}\n\treturn o12, o24, fixdenorm(2 * y1 - s1), fixdenorm(2 * y2 - s2), fixdenorm(2 * y3 - s3), fixdenorm(2 * y4 - s4), u, y1, y2, y3, y4;\n}\n\n// ================= MODEL 04: Steiner-Parker Synthacon-inspired =================\n// Circuit (Steiner, Electronic Design 25, 1974; CGS35 notes): a Sallen-Key\n// network whose two resistors are biased diode strings (voltage-controlled\n// resistors), with Q set by the gain K of a non-inverting amplifier\n// (self-oscillation at K = 3, Q constant while sweeping). LP, BP and HP are\n// obtained by injecting the signal at three different points of the SAME\n// network:  xl -> R1 (LP),  xb -> feedback node of C1 (BP),  xh -> C2 (HP).\n// Linear: H_LP = K/D, H_BP = K s/D, H_HP = K s(s+2)/D,  D = s^2 + (3-K)s + 1.\n// Nonlinear: diode-string currents saturate (tanh secant of the voltage\n// across each string), the amplifier clips (hard-knee sigmoid secant on K).\n// Zero-delay 2x2 trapezoidal solve per sample.\n// returns y, s1, s2, d1, d2, vb\nf_steiner(xl, xb, xh, s1, s2, d1p, d2p, vbp, g, K) {\n\tt1 = f_tg(d1p * 0.7);\n\tt2 = f_tg(d2p * 0.7);\n\tKe = K * f_ag(K * vbp * 0.7);\n\ta11 = 1 + g * (t1 + t2);\n\ta12 = -g * (t1 * Ke + t2 * (Ke - 1));\n\ta21 = g * t2;\n\ta22 = 1 - g * t2 * (Ke - 1);\n\tc2 = g * t2 * ((Ke - 1) * xh + xb);\n\tb1 = g * t1 * (Ke * xh + xb - xl) + c2 + s1;\n\tb2 = c2 + s2;\n\tidet = 1 / (a11 * a22 - a12 * a21);\n\tq1 = (b1 * a22 - a12 * b2) * idet;\n\tq2 = (a11 * b2 - a21 * b1) * idet;\n\tvB = q2 + xh;\n\tvA = Ke * vB + xb - q1;\n\treturn Ke * vB, fixdenorm(2 * q1 - s1), fixdenorm(2 * q2 - s2), xl - vA, vA - vB, vB;\n}\n\n// ================= MODEL 05: Oberheim SEM-inspired =================\n// Circuit: 2-pole state-variable filter whose integrators are CA3080 OTAs\n// driving capacitors; an OTA's output current is gm*tanh(vin/2Vt), so each\n// integrator's input saturates. Damping (resonance pot) never reaches zero:\n// no self-oscillation. Mode knob mixes LP and HP (notch at the centre).\n// Secant-linearised OTA gains (g1, g2) inside a zero-delay SVF solve.\n// m: LP->notch (LPF stage) or HP->notch (HPF stage)\n// returns y, s1, s2, hprev, bprev\nf_sem(x, s1, s2, hpp, bpp, g, R, m, hp) {\n\tu = 2 * tanh(0.5 * x);\n\tg1 = g * f_tg(hpp * 0.6);\n\tg2 = g * f_tg(bpp * 0.6);\n\th = (u - (2 * R + g2) * s1 - s2) / (1 + 2 * R * g1 + g1 * g2);\n\tb = g1 * h + s1;\n\tl = g2 * b + s2;\n\ty = hp > 0.5 ? h + m * l : l + m * h;\n\treturn y, fixdenorm(2 * b - s1), fixdenorm(2 * l - s2), h, b;\n}\n\n// ================= MODEL 06: Roland TB-303-inspired (diode ladder) =================\n// Circuit (Stinchcombe 2008, \"TB-303 configuration\": one diode at the top of\n// the ladder, bottom capacitor C/2): current-driven 4-node RC ladder whose\n// rungs are diode pairs. Linear core:\n//   0.5 v1' = u - (v1-v2);  v2' = (v1-v2)-(v2-v3);  v3' = (v2-v3)-(v3-v4);\n//   v4' = (v3-v4) - v4\n// -> denominator s^4 + 6.727 s^3 + 14.142 s^2 + 9.514 s + 1 (after scaling),\n// self-oscillation at k = 17, w = sqrt(2). Feedback drives the input pair\n// through a one-pole highpass (as in the 303). Nonlinear: input pair tanh,\n// each diode rung's conductance follows the tanh secant of its voltage.\n// returns y, s1..s4, v1..v4, sf, sc\nf_diode(x, s1, s2, s3, s4, v1p, v2p, v3p, v4p, sf, sc, g, k, Gf, bc) {\n\tt1 = f_tg(0.5 * (v1p - v2p));\n\tt2 = f_tg(0.5 * (v2p - v3p));\n\tt3 = f_tg(0.5 * (v3p - v4p));\n\tt4 = f_tg(0.5 * v4p);\n\tB1 = 1 + 2 * g * t1;\n\tC1 = -2 * g * t1;\n\tA2 = -g * t1;\n\tB2 = 1 + g * (t1 + t2);\n\tC2 = -g * t2;\n\tA3 = -g * t2;\n\tB3 = 1 + g * (t2 + t3);\n\tC3 = -g * t3;\n\tA4 = -g * t3;\n\tB4 = 1 + g * (t3 + t4);\n\ta1, a2, a3, a4 = f_tri4(2 * g, 0, 0, 0, B1, C1, A2, B2, C2, A3, B3, C3, A4, B4);\n\tb1, b2, b3, b4 = f_tri4(s1, s2, s3, s4, B1, C1, A2, B2, C2, A3, B3, C3, A4, B4);\n\txi = tanh(x);\n\tlc, nsc = f_op(xi, sc, Gf);\n\txc = xi + k * bc * (xi - lc);\n\tigf = 1 - Gf;\n\tu = (xc - k * igf * (b4 - sf)) / (1 + k * igf * a4);\n\tu = 2 * tanh(0.5 * u);\n\ty1 = b1 + u * a1;\n\ty2 = b2 + u * a2;\n\ty3 = b3 + u * a3;\n\ty4 = b4 + u * a4;\n\tlf, nsf = f_op(y4, sf, Gf);\n\treturn y4, fixdenorm(2 * y1 - s1), fixdenorm(2 * y2 - s2), fixdenorm(2 * y3 - s3), fixdenorm(2 * y4 - s4), y1, y2, y3, y4, fixdenorm(nsf), fixdenorm(nsc);\n}\n\n// ---------- 2x polyphase IIR half-band (5+5 first-order allpasses) ----------\n// one allpass chain step: returns y, z0..z5 (z0 = x[n-1] of section 1, zi = y[n-1] of section i)\nf_ap5(x, z0, z1, z2, z3, z4, z5, c1, c2, c3, c4, c5) {\n\ty1 = c1 * (x - z1) + z0;\n\ty2 = c2 * (y1 - z2) + z1;\n\ty3 = c3 * (y2 - z3) + z2;\n\ty4 = c4 * (y3 - z4) + z3;\n\ty5 = c5 * (y4 - z5) + z4;\n\treturn y5, x, y1, y2, y3, y4, y5;\n}\n\n// ======================= MAIN =======================\nfs = samplerate;\ncur_order = H_cur_order;\ncur_os = H_cur_os;\novs = cur_os > 0.5 ? 2 : 1;\nfso = fs * ovs;\na_cut = 1 - exp(-1 / (0.006 * fs));\na_par = 1 - exp(-1 / (0.015 * fs));\na_mix = 1 - exp(-1 / (0.010 * fs));\nfstep = 1 / (0.025 * fs);\ndstep = 1 / (0.004 * fs);\nx_L = in1;\nx_R = in2;\n\n// ---- load state ----\nl_L_sh_s1a = H_l_L_sh_s1a;\nl_L_sh_s2a = H_l_L_sh_s2a;\nl_L_sh_ba = H_l_L_sh_ba;\nl_L_sh_s1b = H_l_L_sh_s1b;\nl_L_sh_s2b = H_l_L_sh_s2b;\nl_L_sh_bb = H_l_L_sh_bb;\nl_L_sh_yp = H_l_L_sh_yp;\nl_R_sh_s1a = H_l_R_sh_s1a;\nl_R_sh_s2a = H_l_R_sh_s2a;\nl_R_sh_ba = H_l_R_sh_ba;\nl_R_sh_s1b = H_l_R_sh_s1b;\nl_R_sh_s2b = H_l_R_sh_s2b;\nl_R_sh_bb = H_l_R_sh_bb;\nl_R_sh_yp = H_l_R_sh_yp;\nl_L_k3_s1 = H_l_L_k3_s1;\nl_L_k3_s2 = H_l_L_k3_s2;\nl_L_k3_s3 = H_l_L_k3_s3;\nl_L_k3_yp = H_l_L_k3_yp;\nl_R_k3_s1 = H_l_R_k3_s1;\nl_R_k3_s2 = H_l_R_k3_s2;\nl_R_k3_s3 = H_l_R_k3_s3;\nl_R_k3_yp = H_l_R_k3_yp;\nl_L_ld_s1 = H_l_L_ld_s1;\nl_L_ld_s2 = H_l_L_ld_s2;\nl_L_ld_s3 = H_l_L_ld_s3;\nl_L_ld_s4 = H_l_L_ld_s4;\nl_L_ld_p0 = H_l_L_ld_p0;\nl_L_ld_p1 = H_l_L_ld_p1;\nl_L_ld_p2 = H_l_L_ld_p2;\nl_L_ld_p3 = H_l_L_ld_p3;\nl_L_ld_p4 = H_l_L_ld_p4;\nl_R_ld_s1 = H_l_R_ld_s1;\nl_R_ld_s2 = H_l_R_ld_s2;\nl_R_ld_s3 = H_l_R_ld_s3;\nl_R_ld_s4 = H_l_R_ld_s4;\nl_R_ld_p0 = H_l_R_ld_p0;\nl_R_ld_p1 = H_l_R_ld_p1;\nl_R_ld_p2 = H_l_R_ld_p2;\nl_R_ld_p3 = H_l_R_ld_p3;\nl_R_ld_p4 = H_l_R_ld_p4;\nl_L_st_s1 = H_l_L_st_s1;\nl_L_st_s2 = H_l_L_st_s2;\nl_L_st_d1 = H_l_L_st_d1;\nl_L_st_d2 = H_l_L_st_d2;\nl_L_st_vb = H_l_L_st_vb;\nl_R_st_s1 = H_l_R_st_s1;\nl_R_st_s2 = H_l_R_st_s2;\nl_R_st_d1 = H_l_R_st_d1;\nl_R_st_d2 = H_l_R_st_d2;\nl_R_st_vb = H_l_R_st_vb;\nl_L_se_s1 = H_l_L_se_s1;\nl_L_se_s2 = H_l_L_se_s2;\nl_L_se_hq = H_l_L_se_hq;\nl_L_se_bq = H_l_L_se_bq;\nl_R_se_s1 = H_l_R_se_s1;\nl_R_se_s2 = H_l_R_se_s2;\nl_R_se_hq = H_l_R_se_hq;\nl_R_se_bq = H_l_R_se_bq;\nl_L_di_s1 = H_l_L_di_s1;\nl_L_di_s2 = H_l_L_di_s2;\nl_L_di_s3 = H_l_L_di_s3;\nl_L_di_s4 = H_l_L_di_s4;\nl_L_di_v1 = H_l_L_di_v1;\nl_L_di_v2 = H_l_L_di_v2;\nl_L_di_v3 = H_l_L_di_v3;\nl_L_di_v4 = H_l_L_di_v4;\nl_L_di_sf = H_l_L_di_sf;\nl_L_di_sc = H_l_L_di_sc;\nl_R_di_s1 = H_l_R_di_s1;\nl_R_di_s2 = H_l_R_di_s2;\nl_R_di_s3 = H_l_R_di_s3;\nl_R_di_s4 = H_l_R_di_s4;\nl_R_di_v1 = H_l_R_di_v1;\nl_R_di_v2 = H_l_R_di_v2;\nl_R_di_v3 = H_l_R_di_v3;\nl_R_di_v4 = H_l_R_di_v4;\nl_R_di_sf = H_l_R_di_sf;\nl_R_di_sc = H_l_R_di_sc;\nl_L_x0_s1 = H_l_L_x0_s1;\nl_L_x0_s2 = H_l_L_x0_s2;\nl_L_x1_s1 = H_l_L_x1_s1;\nl_L_x1_s2 = H_l_L_x1_s2;\nl_L_x2_s1 = H_l_L_x2_s1;\nl_L_x2_s2 = H_l_L_x2_s2;\nl_R_x0_s1 = H_l_R_x0_s1;\nl_R_x0_s2 = H_l_R_x0_s2;\nl_R_x1_s1 = H_l_R_x1_s1;\nl_R_x1_s2 = H_l_R_x1_s2;\nl_R_x2_s1 = H_l_R_x2_s1;\nl_R_x2_s2 = H_l_R_x2_s2;\nh_L_sh_s1a = H_h_L_sh_s1a;\nh_L_sh_s2a = H_h_L_sh_s2a;\nh_L_sh_ba = H_h_L_sh_ba;\nh_L_sh_s1b = H_h_L_sh_s1b;\nh_L_sh_s2b = H_h_L_sh_s2b;\nh_L_sh_bb = H_h_L_sh_bb;\nh_L_sh_yp = H_h_L_sh_yp;\nh_R_sh_s1a = H_h_R_sh_s1a;\nh_R_sh_s2a = H_h_R_sh_s2a;\nh_R_sh_ba = H_h_R_sh_ba;\nh_R_sh_s1b = H_h_R_sh_s1b;\nh_R_sh_s2b = H_h_R_sh_s2b;\nh_R_sh_bb = H_h_R_sh_bb;\nh_R_sh_yp = H_h_R_sh_yp;\nh_L_k3_s1 = H_h_L_k3_s1;\nh_L_k3_s2 = H_h_L_k3_s2;\nh_L_k3_s3 = H_h_L_k3_s3;\nh_L_k3_yp = H_h_L_k3_yp;\nh_R_k3_s1 = H_h_R_k3_s1;\nh_R_k3_s2 = H_h_R_k3_s2;\nh_R_k3_s3 = H_h_R_k3_s3;\nh_R_k3_yp = H_h_R_k3_yp;\nh_L_ld_s1 = H_h_L_ld_s1;\nh_L_ld_s2 = H_h_L_ld_s2;\nh_L_ld_s3 = H_h_L_ld_s3;\nh_L_ld_s4 = H_h_L_ld_s4;\nh_L_ld_p0 = H_h_L_ld_p0;\nh_L_ld_p1 = H_h_L_ld_p1;\nh_L_ld_p2 = H_h_L_ld_p2;\nh_L_ld_p3 = H_h_L_ld_p3;\nh_L_ld_p4 = H_h_L_ld_p4;\nh_R_ld_s1 = H_h_R_ld_s1;\nh_R_ld_s2 = H_h_R_ld_s2;\nh_R_ld_s3 = H_h_R_ld_s3;\nh_R_ld_s4 = H_h_R_ld_s4;\nh_R_ld_p0 = H_h_R_ld_p0;\nh_R_ld_p1 = H_h_R_ld_p1;\nh_R_ld_p2 = H_h_R_ld_p2;\nh_R_ld_p3 = H_h_R_ld_p3;\nh_R_ld_p4 = H_h_R_ld_p4;\nh_L_st_s1 = H_h_L_st_s1;\nh_L_st_s2 = H_h_L_st_s2;\nh_L_st_d1 = H_h_L_st_d1;\nh_L_st_d2 = H_h_L_st_d2;\nh_L_st_vb = H_h_L_st_vb;\nh_R_st_s1 = H_h_R_st_s1;\nh_R_st_s2 = H_h_R_st_s2;\nh_R_st_d1 = H_h_R_st_d1;\nh_R_st_d2 = H_h_R_st_d2;\nh_R_st_vb = H_h_R_st_vb;\nh_L_se_s1 = H_h_L_se_s1;\nh_L_se_s2 = H_h_L_se_s2;\nh_L_se_hq = H_h_L_se_hq;\nh_L_se_bq = H_h_L_se_bq;\nh_R_se_s1 = H_h_R_se_s1;\nh_R_se_s2 = H_h_R_se_s2;\nh_R_se_hq = H_h_R_se_hq;\nh_R_se_bq = H_h_R_se_bq;\nh_L_x0_s1 = H_h_L_x0_s1;\nh_L_x0_s2 = H_h_L_x0_s2;\nh_L_x1_s1 = H_h_L_x1_s1;\nh_L_x1_s2 = H_h_L_x1_s2;\nh_L_x2_s1 = H_h_L_x2_s1;\nh_L_x2_s2 = H_h_L_x2_s2;\nh_R_x0_s1 = H_h_R_x0_s1;\nh_R_x0_s2 = H_h_R_x0_s2;\nh_R_x1_s1 = H_h_R_x1_s1;\nh_R_x1_s2 = H_h_R_x1_s2;\nh_R_x2_s1 = H_h_R_x2_s1;\nh_R_x2_s2 = H_h_R_x2_s2;\nos_L_upa0 = H_os_L_upa0;\nos_L_upa1 = H_os_L_upa1;\nos_L_upa2 = H_os_L_upa2;\nos_L_upa3 = H_os_L_upa3;\nos_L_upa4 = H_os_L_upa4;\nos_L_upa5 = H_os_L_upa5;\nos_L_upb0 = H_os_L_upb0;\nos_L_upb1 = H_os_L_upb1;\nos_L_upb2 = H_os_L_upb2;\nos_L_upb3 = H_os_L_upb3;\nos_L_upb4 = H_os_L_upb4;\nos_L_upb5 = H_os_L_upb5;\nos_L_dna0 = H_os_L_dna0;\nos_L_dna1 = H_os_L_dna1;\nos_L_dna2 = H_os_L_dna2;\nos_L_dna3 = H_os_L_dna3;\nos_L_dna4 = H_os_L_dna4;\nos_L_dna5 = H_os_L_dna5;\nos_L_dnb0 = H_os_L_dnb0;\nos_L_dnb1 = H_os_L_dnb1;\nos_L_dnb2 = H_os_L_dnb2;\nos_L_dnb3 = H_os_L_dnb3;\nos_L_dnb4 = H_os_L_dnb4;\nos_L_dnb5 = H_os_L_dnb5;\ndc_L_x = H_dc_L_x;\ndc_L_y = H_dc_L_y;\nos_R_upa0 = H_os_R_upa0;\nos_R_upa1 = H_os_R_upa1;\nos_R_upa2 = H_os_R_upa2;\nos_R_upa3 = H_os_R_upa3;\nos_R_upa4 = H_os_R_upa4;\nos_R_upa5 = H_os_R_upa5;\nos_R_upb0 = H_os_R_upb0;\nos_R_upb1 = H_os_R_upb1;\nos_R_upb2 = H_os_R_upb2;\nos_R_upb3 = H_os_R_upb3;\nos_R_upb4 = H_os_R_upb4;\nos_R_upb5 = H_os_R_upb5;\nos_R_dna0 = H_os_R_dna0;\nos_R_dna1 = H_os_R_dna1;\nos_R_dna2 = H_os_R_dna2;\nos_R_dna3 = H_os_R_dna3;\nos_R_dna4 = H_os_R_dna4;\nos_R_dna5 = H_os_R_dna5;\nos_R_dnb0 = H_os_R_dnb0;\nos_R_dnb1 = H_os_R_dnb1;\nos_R_dnb2 = H_os_R_dnb2;\nos_R_dnb3 = H_os_R_dnb3;\nos_R_dnb4 = H_os_R_dnb4;\nos_R_dnb5 = H_os_R_dnb5;\ndc_R_x = H_dc_R_x;\ndc_R_y = H_dc_R_y;\n\n// ================= stage LPF controls =================\nl_lc = H_l_lc + a_cut * (log2(clamp(l_cut, 20, 20000)) - H_l_lc);\nl_rz = H_l_rz + a_par * (clamp(l_res, 0, 100) * 0.01 - H_l_rz);\nl_drv = H_l_drv + a_par * (clamp(l_drive, 0, 100) * 0.01 - H_l_drv);\nl_cmp = H_l_cmp + a_par * (clamp(l_comp, 0, 100) * 0.01 - H_l_cmp);\nl_chr = H_l_chr + a_par * (clamp(l_char, 0, 100) * 0.01 - H_l_chr);\nl_fc = exp2(l_lc);\nl_fcc = min(l_fc, 0.45 * fso);\nl_gw = tan(pi * l_fcc / fso);\nl_ent = l_on > 0.5 ? 1 : 0;\nl_en = H_l_en + a_mix * (l_ent - H_l_en);\nif (l_ent < 0.5 && l_en < 0.0001) {\n\tl_en = 0;\n}\nif (l_ent > 0.5 && l_en > 0.9999) {\n\tl_en = 1;\n}\nl_det = clamp((20000 - l_fc) * 0.00025, 0, 1);\nl_wet = l_en * l_det;\nl_run = l_wet > 0 ? 1 : 0;\nl_d = 0.25 * exp2(5 * l_drv);\nl_id = 1 / l_d;\nl_osc = l_id * exp2(5 * l_drv * (1 - 0.5 * l_cmp));\nl_msel = clamp(floor(l_model + 0.5), 0, 5);\nl_cur = H_l_cur;\nl_prev = H_l_prev;\nl_fade = H_l_fade;\nif (l_msel != l_cur) {\n\tl_prev = l_cur;\n\tl_cur = l_msel;\n\tl_fade = 0;\n}\nl_fade = min(1, l_fade + fstep);\nl_ssel = clamp(floor(l_slope + 0.5), 0, 3);\nl_tit = l_ssel > 0.5 ? 1 : 0;\nl_n12 = (l_cur == 1 || l_cur == 3 || l_cur == 4) ? 1 : 0;\nl_next = l_n12 > 0.5 ? l_ssel : max(0, l_ssel - 1);\nl_ti = H_l_ti + a_mix * (l_tit - H_l_ti);\nl_w0 = H_l_w0 + a_mix * ((l_next == 0 ? 1 : 0) - H_l_w0);\nl_w1 = H_l_w1 + a_mix * ((l_next == 1 ? 1 : 0) - H_l_w1);\nl_w2 = H_l_w2 + a_mix * ((l_next == 2 ? 1 : 0) - H_l_w2);\nl_w3 = H_l_w3 + a_mix * ((l_next == 3 ? 1 : 0) - H_l_w3);\nl_xa = (l_w1 + l_w2 + l_w3) > 0.00001 ? 1 : 0;\nl_xb = (l_w2 + l_w3) > 0.00001 ? 1 : 0;\nl_xc = l_w3 > 0.00001 ? 1 : 0;\nl_gx = l_gw;\nl_ash = (l_run > 0.5 && (l_cur == 0 || (l_prev == 0 && l_fade < 1))) ? 1 : 0;\nl_msh = (l_cur == 0 ? l_fade : 0) + ((l_prev == 0 && l_cur != 0) ? 1 - l_fade : 0);\nl_ak3 = (l_run > 0.5 && (l_cur == 1 || (l_prev == 1 && l_fade < 1))) ? 1 : 0;\nl_mk3 = (l_cur == 1 ? l_fade : 0) + ((l_prev == 1 && l_cur != 1) ? 1 - l_fade : 0);\nl_ald = (l_run > 0.5 && (l_cur == 2 || (l_prev == 2 && l_fade < 1))) ? 1 : 0;\nl_mld = (l_cur == 2 ? l_fade : 0) + ((l_prev == 2 && l_cur != 2) ? 1 - l_fade : 0);\nl_ast = (l_run > 0.5 && (l_cur == 3 || (l_prev == 3 && l_fade < 1))) ? 1 : 0;\nl_mst = (l_cur == 3 ? l_fade : 0) + ((l_prev == 3 && l_cur != 3) ? 1 - l_fade : 0);\nl_ase = (l_run > 0.5 && (l_cur == 4 || (l_prev == 4 && l_fade < 1))) ? 1 : 0;\nl_mse = (l_cur == 4 ? l_fade : 0) + ((l_prev == 4 && l_cur != 4) ? 1 - l_fade : 0);\nl_adi = (l_run > 0.5 && (l_cur == 5 || (l_prev == 5 && l_fade < 1))) ? 1 : 0;\nl_mdi = (l_cur == 5 ? l_fade : 0) + ((l_prev == 5 && l_cur != 5) ? 1 - l_fade : 0);\n// coefficients: Sherman Filterbank-inspired\nl_sh_g = l_gw;\nl_sh_R1 = 0.3 + 0.7 * (1 - l_rz) * (1 - l_rz);\nl_sh_R = 0.8 * (1 - l_rz) * (1 - l_rz) - 0.08 * pow(l_rz, 30);\nl_sh_fb = 0.92 * l_chr;\n// coefficients: Korg 35 (MS-20 Mk1)-inspired\nl_k3_g = l_gw;\nl_k3_K = 0.05 + 2.03 * pow(l_rz, 1.1);\nl_k3_L = 4 * exp2(-4 * l_chr);\n// coefficients: Moog transistor ladder-inspired\nl_ld_g = l_gw;\nl_ld_k = 4.3 * pow(l_rz, 1.3);\nl_ld_bc = l_cmp * 1;\nl_ld_hs = 1 + 2 * l_chr;\n// coefficients: Steiner-Parker Synthacon-inspired\nl_st_g = l_gw;\nl_st_K = 1 + 2.1 * pow(l_rz, 1.3);\nl_st_kd = 1 / pow(l_st_K, l_cmp);\n// coefficients: Oberheim SEM-inspired\nl_se_g = l_gw;\nl_se_R = pow(20, -l_rz);\n// coefficients: Roland TB-303-inspired (diode ladder)\nl_di_k = 19.549999999999997 * pow(l_rz, 1.8);\nl_di_g = l_gw / (0.1494 + 1.2648 * sqrt(min(l_di_k / 17.0, 1.06)));\nl_di_gf = tan(pi * min(8 * exp2(5.2 * l_chr), 0.45 * fso) / fso);\nl_di_Gf = l_di_gf / (1 + l_di_gf);\nif (l_ash < 0.5) {\n\tl_L_sh_s1a = 0;\n\tl_L_sh_s2a = 0;\n\tl_L_sh_ba = 0;\n\tl_L_sh_s1b = 0;\n\tl_L_sh_s2b = 0;\n\tl_L_sh_bb = 0;\n\tl_L_sh_yp = 0;\n\tl_R_sh_s1a = 0;\n\tl_R_sh_s2a = 0;\n\tl_R_sh_ba = 0;\n\tl_R_sh_s1b = 0;\n\tl_R_sh_s2b = 0;\n\tl_R_sh_bb = 0;\n\tl_R_sh_yp = 0;\n}\nif (l_ak3 < 0.5) {\n\tl_L_k3_s1 = 0;\n\tl_L_k3_s2 = 0;\n\tl_L_k3_s3 = 0;\n\tl_L_k3_yp = 0;\n\tl_R_k3_s1 = 0;\n\tl_R_k3_s2 = 0;\n\tl_R_k3_s3 = 0;\n\tl_R_k3_yp = 0;\n}\nif (l_ald < 0.5) {\n\tl_L_ld_s1 = 0;\n\tl_L_ld_s2 = 0;\n\tl_L_ld_s3 = 0;\n\tl_L_ld_s4 = 0;\n\tl_L_ld_p0 = 0;\n\tl_L_ld_p1 = 0;\n\tl_L_ld_p2 = 0;\n\tl_L_ld_p3 = 0;\n\tl_L_ld_p4 = 0;\n\tl_R_ld_s1 = 0;\n\tl_R_ld_s2 = 0;\n\tl_R_ld_s3 = 0;\n\tl_R_ld_s4 = 0;\n\tl_R_ld_p0 = 0;\n\tl_R_ld_p1 = 0;\n\tl_R_ld_p2 = 0;\n\tl_R_ld_p3 = 0;\n\tl_R_ld_p4 = 0;\n}\nif (l_ast < 0.5) {\n\tl_L_st_s1 = 0;\n\tl_L_st_s2 = 0;\n\tl_L_st_d1 = 0;\n\tl_L_st_d2 = 0;\n\tl_L_st_vb = 0;\n\tl_R_st_s1 = 0;\n\tl_R_st_s2 = 0;\n\tl_R_st_d1 = 0;\n\tl_R_st_d2 = 0;\n\tl_R_st_vb = 0;\n}\nif (l_ase < 0.5) {\n\tl_L_se_s1 = 0;\n\tl_L_se_s2 = 0;\n\tl_L_se_hq = 0;\n\tl_L_se_bq = 0;\n\tl_R_se_s1 = 0;\n\tl_R_se_s2 = 0;\n\tl_R_se_hq = 0;\n\tl_R_se_bq = 0;\n}\nif (l_adi < 0.5) {\n\tl_L_di_s1 = 0;\n\tl_L_di_s2 = 0;\n\tl_L_di_s3 = 0;\n\tl_L_di_s4 = 0;\n\tl_L_di_v1 = 0;\n\tl_L_di_v2 = 0;\n\tl_L_di_v3 = 0;\n\tl_L_di_v4 = 0;\n\tl_L_di_sf = 0;\n\tl_L_di_sc = 0;\n\tl_R_di_s1 = 0;\n\tl_R_di_s2 = 0;\n\tl_R_di_s3 = 0;\n\tl_R_di_s4 = 0;\n\tl_R_di_v1 = 0;\n\tl_R_di_v2 = 0;\n\tl_R_di_v3 = 0;\n\tl_R_di_v4 = 0;\n\tl_R_di_sf = 0;\n\tl_R_di_sc = 0;\n}\nif (l_xa < 0.5 || l_run < 0.5) {\n\tl_L_x0_s1 = 0;\n\tl_L_x0_s2 = 0;\n\tl_R_x0_s1 = 0;\n\tl_R_x0_s2 = 0;\n}\nif (l_xb < 0.5 || l_run < 0.5) {\n\tl_L_x1_s1 = 0;\n\tl_L_x1_s2 = 0;\n\tl_R_x1_s1 = 0;\n\tl_R_x1_s2 = 0;\n}\nif (l_xc < 0.5 || l_run < 0.5) {\n\tl_L_x2_s1 = 0;\n\tl_L_x2_s2 = 0;\n\tl_R_x2_s1 = 0;\n\tl_R_x2_s2 = 0;\n}\n\n// ================= stage HPF controls =================\nh_lc = H_h_lc + a_cut * (log2(clamp(h_cut, 20, 2000)) - H_h_lc);\nh_rz = H_h_rz + a_par * (clamp(h_res, 0, 100) * 0.01 - H_h_rz);\nh_drv = H_h_drv + a_par * (clamp(h_drive, 0, 100) * 0.01 - H_h_drv);\nh_cmp = H_h_cmp + a_par * (clamp(h_comp, 0, 100) * 0.01 - H_h_cmp);\nh_chr = H_h_chr + a_par * (clamp(h_char, 0, 100) * 0.01 - H_h_chr);\nh_fc = exp2(h_lc);\nh_fcc = min(h_fc, 0.45 * fso);\nh_gw = tan(pi * h_fcc / fso);\nh_ent = h_on > 0.5 ? 1 : 0;\nh_en = H_h_en + a_mix * (h_ent - H_h_en);\nif (h_ent < 0.5 && h_en < 0.0001) {\n\th_en = 0;\n}\nif (h_ent > 0.5 && h_en > 0.9999) {\n\th_en = 1;\n}\nh_det = clamp((h_fc - 20) * 0.2, 0, 1);\nh_wet = h_en * h_det;\nh_run = h_wet > 0 ? 1 : 0;\nh_d = 0.25 * exp2(5 * h_drv);\nh_id = 1 / h_d;\nh_osc = h_id * exp2(5 * h_drv * (1 - 0.5 * h_cmp));\nh_msel = clamp(floor(h_model + 0.5), 0, 4);\nh_cur = H_h_cur;\nh_prev = H_h_prev;\nh_fade = H_h_fade;\nif (h_msel != h_cur) {\n\th_prev = h_cur;\n\th_cur = h_msel;\n\th_fade = 0;\n}\nh_fade = min(1, h_fade + fstep);\nh_ssel = clamp(floor(h_slope + 0.5), 0, 3);\nh_tit = h_ssel > 0.5 ? 1 : 0;\nh_n12 = (h_cur == 1 || h_cur == 3 || h_cur == 4) ? 1 : 0;\nh_next = h_n12 > 0.5 ? h_ssel : max(0, h_ssel - 1);\nh_ti = H_h_ti + a_mix * (h_tit - H_h_ti);\nh_w0 = H_h_w0 + a_mix * ((h_next == 0 ? 1 : 0) - H_h_w0);\nh_w1 = H_h_w1 + a_mix * ((h_next == 1 ? 1 : 0) - H_h_w1);\nh_w2 = H_h_w2 + a_mix * ((h_next == 2 ? 1 : 0) - H_h_w2);\nh_w3 = H_h_w3 + a_mix * ((h_next == 3 ? 1 : 0) - H_h_w3);\nh_xa = (h_w1 + h_w2 + h_w3) > 0.00001 ? 1 : 0;\nh_xb = (h_w2 + h_w3) > 0.00001 ? 1 : 0;\nh_xc = h_w3 > 0.00001 ? 1 : 0;\nh_gx = h_gw;\nh_ash = (h_run > 0.5 && (h_cur == 0 || (h_prev == 0 && h_fade < 1))) ? 1 : 0;\nh_msh = (h_cur == 0 ? h_fade : 0) + ((h_prev == 0 && h_cur != 0) ? 1 - h_fade : 0);\nh_ak3 = (h_run > 0.5 && (h_cur == 1 || (h_prev == 1 && h_fade < 1))) ? 1 : 0;\nh_mk3 = (h_cur == 1 ? h_fade : 0) + ((h_prev == 1 && h_cur != 1) ? 1 - h_fade : 0);\nh_ald = (h_run > 0.5 && (h_cur == 2 || (h_prev == 2 && h_fade < 1))) ? 1 : 0;\nh_mld = (h_cur == 2 ? h_fade : 0) + ((h_prev == 2 && h_cur != 2) ? 1 - h_fade : 0);\nh_ast = (h_run > 0.5 && (h_cur == 3 || (h_prev == 3 && h_fade < 1))) ? 1 : 0;\nh_mst = (h_cur == 3 ? h_fade : 0) + ((h_prev == 3 && h_cur != 3) ? 1 - h_fade : 0);\nh_ase = (h_run > 0.5 && (h_cur == 4 || (h_prev == 4 && h_fade < 1))) ? 1 : 0;\nh_mse = (h_cur == 4 ? h_fade : 0) + ((h_prev == 4 && h_cur != 4) ? 1 - h_fade : 0);\n// coefficients: Sherman Filterbank-inspired\nh_sh_g = h_gw;\nh_sh_R1 = 0.3 + 0.7 * (1 - h_rz) * (1 - h_rz);\nh_sh_R = 0.8 * (1 - h_rz) * (1 - h_rz) - 0.08 * pow(h_rz, 30);\nh_sh_fb = 0.92 * h_chr;\n// coefficients: Korg 35 (MS-20 Mk1)-inspired\nh_k3_g = h_gw;\nh_k3_K = 0.05 + 2.03 * pow(h_rz, 1.1);\nh_k3_L = 4 * exp2(-4 * h_chr);\n// coefficients: Moog transistor ladder-inspired\nh_ld_g = h_gw;\nh_ld_k = 4.3 * pow(h_rz, 1.3);\nh_ld_bc = h_cmp * 0;\nh_ld_hs = 1 + 2 * h_chr;\n// coefficients: Steiner-Parker Synthacon-inspired\nh_st_g = h_gw;\nh_st_K = 1 + 2.1 * pow(h_rz, 1.3);\nh_st_kd = 1 / pow(h_st_K, h_cmp);\n// coefficients: Oberheim SEM-inspired\nh_se_g = h_gw;\nh_se_R = pow(20, -h_rz);\nif (h_ash < 0.5) {\n\th_