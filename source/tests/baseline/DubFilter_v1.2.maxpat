         "code": "// Dub Filter \u2014 multi-model analogue-inspired dual filter engine\n// GENERATED by src/build_genexpr.py \u2014 edit the generator, not this file.\n// gen~ codebox: in1/in2 = stereo in, out1/out2 = stereo out.\n\nParam l_on(1, min=0, max=1);\nParam l_model(2, min=0, max=5);\nParam l_cut(20000, min=20, max=20000);\nParam l_res(0, min=0, max=100);\nParam l_slope(1, min=0, max=3);\nParam l_drive(0, min=0, max=100);\nParam l_comp(100, min=0, max=100);\nParam l_char(0, min=0, max=100);\nParam h_on(1, min=0, max=1);\nParam h_model(1, min=0, max=4);\nParam h_cut(20, min=20, max=2000);\nParam h_res(0, min=0, max=100);\nParam h_slope(0, min=0, max=3);\nParam h_drive(0, min=0, max=100);\nParam h_comp(100, min=0, max=100);\nParam h_char(0, min=0, max=100);\nParam order_sel(0, min=0, max=1);\nParam ovs_sel(0, min=0, max=1);\nParam out_db(0, min=-24, max=12);\nParam softclip(1, min=0, max=1);\nParam b_on(0, min=0, max=1);\nParam b_model(0, min=0, max=4);\nParam b_arch(0, min=0, max=2);\nParam b_freq(1000, min=30, max=12000);\nParam b_bw(2, min=0.2, max=6);\nParam b_q(0.707, min=0.5, max=10);\nParam b_res(0, min=0, max=100);\nParam b_drive(0, min=0, max=100);\nParam b_comp(100, min=0, max=100);\nParam b_mix(100, min=0, max=100);\nParam b_pos(0, min=0, max=1);\n\nHistory H_l_L_sh_s1a(0.0);\nHistory H_l_L_sh_s2a(0.0);\nHistory H_l_L_sh_ba(0.0);\nHistory H_l_L_sh_s1b(0.0);\nHistory H_l_L_sh_s2b(0.0);\nHistory H_l_L_sh_bb(0.0);\nHistory H_l_L_sh_yp(0.0);\nHistory H_l_R_sh_s1a(0.0);\nHistory H_l_R_sh_s2a(0.0);\nHistory H_l_R_sh_ba(0.0);\nHistory H_l_R_sh_s1b(0.0);\nHistory H_l_R_sh_s2b(0.0);\nHistory H_l_R_sh_bb(0.0);\nHistory H_l_R_sh_yp(0.0);\nHistory H_l_L_k3_s1(0.0);\nHistory H_l_L_k3_s2(0.0);\nHistory H_l_L_k3_s3(0.0);\nHistory H_l_L_k3_yp(0.0);\nHistory H_l_R_k3_s1(0.0);\nHistory H_l_R_k3_s2(0.0);\nHistory H_l_R_k3_s3(0.0);\nHistory H_l_R_k3_yp(0.0);\nHistory H_l_L_ld_s1(0.0);\nHistory H_l_L_ld_s2(0.0);\nHistory H_l_L_ld_s3(0.0);\nHistory H_l_L_ld_s4(0.0);\n