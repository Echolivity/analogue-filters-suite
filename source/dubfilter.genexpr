	h_L_k3_s2 = 0;
	h_L_k3_s3 = 0;
	h_L_k3_yp = 0;
	h_R_k3_s1 = 0;
	h_R_k3_s2 = 0;
	h_R_k3_s3 = 0;
	h_R_k3_yp = 0;
	h_dzk3 = 0;
}
if (h_ak3 > 0.5) {
	h_dzk3 = 1;
}
h_dzld = H_h_dzld;
if (h_ald < 0.5 && h_dzld > 0.5) {
	h_L_ld_s1 = 0;
	h_L_ld_s2 = 0;
	h_L_ld_s3 = 0;
	h_L_ld_s4 = 0;
	h_L_ld_p0 = 0;
	h_L_ld_p1 = 0;
	h_L_ld_p2 = 0;
	h_L_ld_p3 = 0;
	h_L_ld_p4 = 0;
	h_L_ld_h1 = 0;
	h_L_ld_h2 = 0;
	h_L_ld_pz = 0;
	h_R_ld_s1 = 0;
	h_R_ld_s2 = 0;
	h_R_ld_s3 = 0;
	h_R_ld_s4 = 0;
	h_R_ld_p0 = 0;
	h_R_ld_p1 = 0;
	h_R_ld_p2 = 0;
	h_R_ld_p3 = 0;
	h_R_ld_p4 = 0;
	h_R_ld_h1 = 0;
	h_R_ld_h2 = 0;
	h_R_ld_pz = 0;
	h_dzld = 0;
}
if (h_ald > 0.5) {
	h_dzld = 1;
}
h_dzst = H_h_dzst;
if (h_ast < 0.5 && h_dzst > 0.5) {
	h_L_st_s1 = 0;
	h_L_st_s2 = 0;
	h_L_st_d1 = 0;
	h_L_st_d2 = 0;
	h_L_st_vb = 0;
	h_R_st_s1 = 0;
	h_R_st_s2 = 0;
	h_R_st_d1 = 0;
	h_R_st_d2 = 0;
	h_R_st_vb = 0;
	h_dzst = 0;
}
if (h_ast > 0.5) {
	h_dzst = 1;
}
h_dzse = H_h_dzse;
if (h_ase < 0.5 && h_dzse > 0.5) {
	h_L_se_s1 = 0;
	h_L_se_s2 = 0;
	h_L_se_hq = 0;
	h_L_se_bq = 0;
	h_R_se_s1 = 0;
	h_R_se_s2 = 0;
	h_R_se_hq = 0;
	h_R_se_bq = 0;
	h_dzse = 0;
}
if (h_ase > 0.5) {
	h_dzse = 1;
}
h_dzx0 = H_h_dzx0;
if ((h_xa < 0.5 || h_run < 0.5) && h_dzx0 > 0.5) {
	h_L_x0_s1 = 0;
	h_L_x0_s2 = 0;
	h_R_x0_s1 = 0;
	h_R_x0_s2 = 0;
	h_dzx0 = 0;
}
if (h_xa > 0.5 && h_run > 0.5) {
	h_dzx0 = 1;
}
h_dzx1 = H_h_dzx1;
if ((h_xb < 0.5 || h_run < 0.5) && h_dzx1 > 0.5) {
	h_L_x1_s1 = 0;
	h_L_x1_s2 = 0;
	h_R_x1_s1 = 0;
	h_R_x1_s2 = 0;
	h_dzx1 = 0;
}
if (h_xb > 0.5 && h_run > 0.5) {
	h_dzx1 = 1;
}
h_dzx2 = H_h_dzx2;
if ((h_xc < 0.5 || h_run < 0.5) && h_dzx2 > 0.5) {
