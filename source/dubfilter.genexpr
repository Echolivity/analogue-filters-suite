l_dzx1 = H_l_dzx1;
if ((l_xb < 0.5 || l_run < 0.5) && l_dzx1 > 0.5) {
	l_L_x1_s1 = 0;
	l_L_x1_s2 = 0;
	l_R_x1_s1 = 0;
