					by, bB_R_m_s1, bB_R_m_s2, bB_R_m_s3, bB_R_m_s4, bB_R_m_p0, bB_R_m_p1, bB_R_m_p2, bB_R_m_p3, bB_R_m_p4 = f_bmm(bx, bB_R_m_s1, bB_R_m_s2, bB_R_m_s3, bB_R_m_s4, bB_R_m_p0, bB_R_m_p1, bB_R_m_p2, bB_R_m_p3, bB_R_m_p4, bB_gm, bB_k, bB_typ, bB_sc, bB_wb);
				}
				bB_R_yp = by;
				if (bB_roll > 0.5) {
					by, bB_R_ro = f_op(by, bB_R_ro, bB_Gro);
					bB_R_ro = fixdenorm(bB_R_ro);
				}
				bo_R = bo_R + b_wB * by * bB_ocmp * b_osc;
			}
			zb_R = zb_R + b_wet * (bo_R - zb_R);
		}
	}
}

// ================= output (2x downsampler when oversampling) =================
y_L = za_L;
y_R = za_R;
if (ovs > 1.5) {
	pa, os_L_dna0, os_L_dna1, os_L_dna2, os_L_dna3, os_L_dna4, os_L_dna5 = f_ap5(zb_L, os_L_dna0, os_L_dna1, os_L_dna2, os_L_dna3, os_L_dna4, os_L_dna5, 0.035979631179546, 0.270744078039831, 0.557994617257913, 0.775098715397111, 0.916958938825425);
	pb, os_L_dnb0, os_L_dnb1, os_L_dnb2, os_L_dnb3, os_L_dnb4, os_L_dnb5 = f_ap5(za_L, os_L_dnb0, os_L_dnb1, os_L_dnb2, os_L_dnb3, os_L_dnb4, os_L_dnb5, 0.134200951194299, 0.418804850254691, 0.677594451212584, 0.853151529122229, 0.972847950939362);
	y_L = 0.5 * (pa + pb);
	pa, os_R_dna0, os_R_dna1, os_R_dna2, os_R_dna3, os_R_dna4, os_R_dna5 = f_ap5(zb_R, os_R_dna0, os_R_dna1, os_R_dna2, os_R_dna3, os_R_dna4, os_R_dna5, 0.035979631179546, 0.270744078039831, 0.557994617257913, 0.775098715397111, 0.916958938825425);
	pb, os_R_dnb0, os_R_dnb1, os_R_dnb2, os_R_dnb3, os_R_dnb4, os_R_dnb5 = f_ap5(za_R, os_R_dnb0, os_R_dnb1, os_R_dnb2, os_R_dnb3, os_R_dnb4, os_R_dnb5, 0.134200951194299, 0.418804850254691, 0.677594451212584, 0.853151529122229, 0.972847950939362);
	y_R = 0.5 * (pa + pb);
}

// ---- DC blocker (1st order, 2 Hz), output gain, soft clip, duck ----
dcr = 1 - 2 * pi * 2 / fs;
og = H_og + a_par * (exp(0.11512925465 * clamp(out_db, -24, 12)) - H_og);
dy_L = y_L - dc_L_x + dcr * dc_L_y;
dc_L_x = y_L;
dc_L_y = fixdenorm(dy_L);
q_L = dy_L * og;
if (softclip > 0.5) {
	aq = abs(q_L);
	if (aq > 0.7) {
		q_L = (q_L > 0 ? 1 : -1) * (0.7 + 0.3 * tanh((aq - 0.7) / 0.3));
	}
}
q_L = q_L * duck;
q_L = q_L == q_L ? q_L : 0;
dy_R = y_R - dc_R_x + dcr * dc_R_y;
dc_R_x = y_R;
dc_R_y = fixdenorm(dy_R);
q_R = dy_R * og;
if (softclip > 0.5) {
	aq = abs(q_R);
	if (aq > 0.7) {
		q_R = (q_R > 0 ? 1 : -1) * (0.7 + 0.3 * tanh((aq - 0.7) / 0.3));
	}
}
q_R = q_R * duck;
q_R = q_R == q_R ? q_R : 0;
out1 = q_L;
out2 = q_R;

