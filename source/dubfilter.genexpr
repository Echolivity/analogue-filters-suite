	h_L_sh_s1b = 0;
	h_L_sh_s2b = 0;
	h_L_sh_bb = 0;
	h_L_sh_yp = 0;
	h_R_sh_s1a = 0;
	h_R_sh_s2a = 0;
	h_R_sh_ba = 0;
	h_R_sh_s1b = 0;
	h_R_sh_s2b = 0;
	h_R_sh_bb = 0;
	h_R_sh_yp = 0;
}
if (h_ak3 < 0.5) {
	h_L_k3_s1 = 0;
	h_L_k3_s2 = 0;
	h_L_k3_s3 = 0;
	h_L_k3_yp = 0;
	h_R_k3_s1 = 0;
	h_R_k3_s2 = 0;
	h_R_k3_s3 = 0;
	h_R_k3_yp = 0;
}
if (h_ald < 0.5) {
	h_L_ld_s1 = 0;
	h_L_ld_s2 = 0;
	h_L_ld_s3 = 0;
	h_L_ld_s4 = 0;
	h_L_ld_p0 = 0;
	h_L_ld_p1 = 0;
	h_L_ld_p2 = 0;
	h_L_ld_p3 = 0;
	h_L_ld_p4 = 0;
	h_R_ld_s1 = 0;
	h_R_ld_s2 = 0;
	h_R_ld_s3 = 0;
