dQ_O_L_cf = H_dQ_O_L_cf;
dQ_O_L_cs = H_dQ_O_L_cs;
dQ_O_L_mem = H_dQ_O_L_mem;
dQ_O_L_yp = H_dQ_O_L_yp;
