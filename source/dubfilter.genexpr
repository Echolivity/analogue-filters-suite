		if (dQ_m2 == 1) {
			if (dz_o_w > 0) {
				ou_L = q2_L * dz_o_gi;
				osc_L = (o_src < 0.5 ? dQ_O_L_yp : (o_src < 1.5 ? cin_L : key_L)) * (1 + o_a * dQ_O_L_q);
				ohl, dQ_O_L_hp = f_op(osc_L, dQ_O_L_hp, o_Ghp);
				osc_L = osc_L - ohl;
				dQ_O_L_hp = fixdenorm(dQ_O_L_hp);
				if (dz_o_emz > 0) {
				    oex = osc_L;
				    osc_L = o_eb0 * oex + dQ_O_L_he;
				    dQ_O_L_he = fixdenorm(o_eb1 * oex - o_ea1 * osc_L + dQ_O_L_e2);
				    dQ_O_L_e2 = fixdenorm(o_eb2 * oex - o_ea2 * osc_L + dQ_O_L_e3);
				    dQ_O_L_e3 = fixdenorm(o_eb3 * oex - o_ea3 * osc_L);
				}
				olv_L = abs(osc_L);
