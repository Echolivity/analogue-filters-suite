dQ_V_R_t2 = H_dQ_V_R_t2;
dQ_V_R_ms = H_dQ_V_R_ms;
dQ_V_R_gr = H_dQ_V_R_gr;
dQ_V_R_yp = H_dQ_V_R_yp;
dg_hpL = H_dg_hpL;
dg_hpR = H_dg_hpR;
dg_lpL = H_dg_lpL;
dg_lpR = H_dg_lpR;
dg_env = H_dg_env;
dg_open = H_dg_open;
dg_hold = H_dg_hold;
dg_g = H_dg_g;

// ================= stage LPF controls =================
l_lc = H_l_lc + a_cut * (log2(clamp(l_cut, 20, 20000)) - H_l_lc);
l_rz = H_l_rz + a_par * (clamp(l_res, 0, 100) * 0.01 - H_l_rz);
l_drv = H_l_drv + a_par * (clamp(l_drive, 0, 100) * 0.01 - H_l_drv);
l_cmp = H_l_cmp + a_par * (clamp(l_comp, 0, 100) * 0.01 - H_l_cmp);
l_chr = H_l_chr + a_par * (clamp(l_char, 0, 100) * 0.01 - H_l_chr);
l_fc = exp2(l_lc);
l_fcc = min(l_fc, 0.45 * fso);
l_gw = tan(pi * l_fcc / fso);
l_ent = l_on > 0.5 ? 1 : 0;
l_en = H_l_en + a_mix * (l_ent - H_l_en);
if (l_ent < 0.5 && l_en < 0.0001) {
	l_en = 0;
}
if (l_ent > 0.5 && l_en > 0.9999) {
	l_en = 1;
}
l_det = clamp((20000 - l_fc) * 0.00025, 0, 1);
l_wet = l_en * l_det;
l_run = l_wet > 0 ? 1 : 0;
l_d = 0.25 * exp2(5 * l_drv);
l_id = 1 / l_d;
l_osc = l_id * exp2(5 * l_drv * (1 - 0.5 * l_cmp));
l_msel = clamp(floor(l_model + 0.5), 0, 5);
l_cur = H_l_cur;
l_prev = H_l_prev;
l_fade = H_l_fade;
if (l_msel != l_cur) {
	l_prev = l_cur;
	l_cur = l_msel;
	l_fade = 0;
}
l_fade = min(1, l_fade + fstep);
l_ssel = clamp(floor(l_slope + 0.5), 0, 3);
l_tit = l_ssel > 0.5 ? 1 : 0;
l_n12 = (l_cur == 1 || l_cur == 3 || l_cur == 4) ? 1 : 0;
l_next = l_n12 > 0.5 ? l_ssel : max(0, l_ssel - 1);
l_ti = H_l_ti + a_mix * (l_tit - H_l_ti);
l_w0 = H_l_w0 + a_mix * ((l_next == 0 ? 1 : 0) - H_l_w0);
l_w1 = H_l_w1 + a_mix * ((l_next == 1 ? 1 : 0) - H_l_w1);
l_w2 = H_l_w2 + a_mix * ((l_next == 2 ? 1 : 0) - H_l_w2);
l_w3 = H_l_w3 + a_mix * ((l_next == 3 ? 1 : 0) - H_l_w3);
l_xa = (l_w1 + l_w2 + l_w3) > 0.00001 ? 1 : 0;
l_xb = (l_w2 + l_w3) > 0.00001 ? 1 : 0;
l_xc = l_w3 > 0.00001 ? 1 : 0;
l_gx = l_gw;
l_ash = (l_run > 0.5 && (l_cur == 0 || (l_prev == 0 && l_fade < 1))) ? 1 : 0;
l_msh = (l_cur == 0 ? l_fade : 0) + ((l_prev == 0 && l_cur != 0) ? 1 - l_fade : 0);
l_ak3 = (l_run > 0.5 && (l_cur == 1 || (l_prev == 1 && l_fade < 1))) ? 1 : 0;
l_mk3 = (l_cur == 1 ? l_fade : 0) + ((l_prev == 1 && l_cur != 1) ? 1 - l_fade : 0);
l_ald = (l_run > 0.5 && (l_cur == 2 || (l_prev == 2 && l_fade < 1))) ? 1 : 0;
l_mld = (l_cur == 2 ? l_fade : 0) + ((l_prev == 2 && l_cur != 2) ? 1 - l_fade : 0);
l_ast = (l_run > 0.5 && (l_cur == 3 || (l_prev == 3 && l_fade < 1))) ? 1 : 0;
l_mst = (l_cur == 3 ? l_fade : 0) + ((l_prev == 3 && l_cur != 3) ? 1 - l_fade : 0);
l_ase = (l_run > 0.5 && (l_cur == 4 || (l_prev == 4 && l_fade < 1))) ? 1 : 0;
l_mse = (l_cur == 4 ? l_fade : 0) + ((l_prev == 4 && l_cur != 4) ? 1 - l_fade : 0);
l_adi = (l_run > 0.5 && (l_cur == 5 || (l_prev == 5 && l_fade < 1))) ? 1 : 0;
l_mdi = (l_cur == 5 ? l_fade : 0) + ((l_prev == 5 && l_cur != 5) ? 1 - l_fade : 0);
// coefficients: Sherman Filterbank-inspired
l_sh_g = l_gw;
l_sh_R1 = 0.3 + 0.7 * (1 - l_rz) * (1 - l_rz);
l_sh_R = 0.8 * (1 - l_rz) * (1 - l_rz) - 0.08 * pow(l_rz, 30);
l_sh_fb = 0.92 * l_chr;
// coefficients: Korg 35 (MS-20 Mk1)-inspired
l_k3_g = l_gw;
l_k3_K = 0.05 + 2.03 * pow(l_rz, 1.1);
l_k3_L = 4 * exp2(-4 * l_chr);
// coefficients: Moog transistor ladder-inspired
l_ld_g = l_gw;
l_ld_k = 4.3 * pow(l_rz, 1.3);
l_ld_bc = l_cmp * 1;
l_ld_hs = 1 + 2 * l_chr;
// coefficients: Steiner-Parker Synthacon-inspired
l_st_g = l_gw;
l_st_K = 1 + 2.1 * pow(l_rz, 1.3);
l_st_kd = 1 / pow(l_st_K, l_cmp);
// coefficients: Oberheim SEM-inspired
l_se_g = l_gw;
l_se_R = pow(20, -l_rz);
// coefficients: Roland TB-303-inspired (diode ladder)
l_di_k = 19.549999999999997 * pow(l_rz, 1.8);
l_di_g = l_gw / (0.1494 + 1.2648 * sqrt(min(l_di_k / 17.0, 1.06)));
l_di_gf = tan(pi * min(8 * exp2(5.2 * l_chr), 0.45 * fso) / fso);
l_di_Gf = l_di_gf / (1 + l_di_gf);
if (l_ash < 0.5) {
	l_L_sh_s1a = 0;
	l_L_sh_s2a = 0;
	l_L_sh_ba = 0;
	l_L_sh_s1b = 0;
	l_L_sh_s2b = 0;
	l_L_sh_bb = 0;
	l_L_sh_yp = 0;
	l_R_sh_s1a = 0;
	l_R_sh_s2a = 0;
	l_R_sh_ba = 0;
	l_R_sh_s1b = 0;
	l_R_sh_s2b = 0;
	l_R_sh_bb = 0;
	l_R_sh_yp = 0;
}
if (l_ak3 < 0.5) {
	l_L_k3_s1 = 0;
	l_L_k3_s2 = 0;
	l_L_k3_s3 = 0;
	l_L_k3_yp = 0;
	l_R_k3_s1 = 0;
	l_R_k3_s2 = 0;
	l_R_k3_s3 = 0;
	l_R_k3_yp = 0;
}
if (l_ald < 0.5) {
	l_L_ld_s1 = 0;
	l_L_ld_s2 = 0;
	l_L_ld_s3 = 0;
	l_L_ld_s4 = 0;
	l_L_ld_p0 = 0;
	l_L_ld_p1 = 0;
	l_L_ld_p2 = 0;
	l_L_ld_p3 = 0;
	l_L_ld_p4 = 0;
	l_R_ld_s1 = 0;
	l_R_ld_s2 = 0;
	l_R_ld_s3 = 0;
	l_R_ld_s4 = 0;
	l_R_ld_p0 = 0;
	l_R_ld_p1 = 0;
	l_R_ld_p2 = 0;
	l_R_ld_p3 = 0;
	l_R_ld_p4 = 0;
}
if (l_ast < 0.5) {
	l_L_st_s1 = 0;
	l_L_st_s2 = 0;
	l_L_st_d1 = 0;
	l_L_st_d2 = 0;
	l_L_st_vb = 0;
	l_R_st_s1 = 0;
	l_R_st_s2 = 0;
	l_R_st_d1 = 0;
	l_R_st_d2 = 0;
	l_R_st_vb = 0;
}
if (l_ase < 0.5) {
	l_L_se_s1 = 0;
	l_L_se_s2 = 0;
	l_L_se_hq = 0;
	l_L_se_bq = 0;
	l_R_se_s1 = 0;
	l_R_se_s2 = 0;
	l_R_se_hq = 0;
	l_R_se_bq = 0;
}
if (l_adi < 0.5) {
	l_L_di_s1 = 0;
	l_L_di_s2 = 0;
	l_L_di_s3 = 0;
	l_L_di_s4 = 0;
	l_L_di_v1 = 0;
	l_L_di_v2 = 0;
	l_L_di_v3 = 0;
	l_L_di_v4 = 0;
	l_L_di_sf = 0;
	l_L_di_sc = 0;
	l_R_di_s1 = 0;
	l_R_di_s2 = 0;
	l_R_di_s3 = 0;
	l_R_di_s4 = 0;
	l_R_di_v1 = 0;
	l_R_di_v2 = 0;
	l_R_di_v3 = 0;
	l_R_di_v4 = 0;
	l_R_di_sf = 0;
	l_R_di_sc = 0;
}
if (l_xa < 0.5 || l_run < 0.5) {
	l_L_x0_s1 = 0;
	l_L_x0_s2 = 0;
	l_R_x0_s1 = 0;
	l_R_x0_s2 = 0;
}
if (l_xb < 0.5 || l_run < 0.5) {
	l_L_x1_s1 = 0;
	l_L_x1_s2 = 0;
	l_R_x1_s1 = 0;
	l_R_x1_s2 = 0;
}
if (l_xc < 0.5 || l_run < 0.5) {
	l_L_x2_s1 = 0;
	l_L_x2_s2 = 0;
	l_R_x2_s1 = 0;
	l_R_x2_s2 = 0;
}

// ================= stage HPF controls =================
h_lc = H_h_lc + a_cut * (log2(clamp(h_cut, 20, 2000)) - H_h_lc);
h_rz = H_h_rz + a_par * (clamp(h_res, 0, 100) * 0.01 - H_h_rz);
h_drv = H_h_drv + a_par * (clamp(h_drive, 0, 100) * 0.01 - H_h_drv);
h_cmp = H_h_cmp + a_par * (clamp(h_comp, 0, 100) * 0.01 - H_h_cmp);
h_chr = H_h_chr + a_par * (clamp(h_char, 0, 100) * 0.01 - H_h_chr);
h_fc = exp2(h_lc);
h_fcc = min(h_fc, 0.45 * fso);
h_gw = tan(pi * h_fcc / fso);
h_ent = h_on > 0.5 ? 1 : 0;
h_en = H_h_en + a_mix * (h_ent - H_h_en);
if (h_ent < 0.5 && h_en < 0.0001) {
	h_en = 0;
}
if (h_ent > 0.5 && h_en > 0.9999) {
	h_en = 1;
}
h_det = clamp((h_fc - 20) * 0.2, 0, 1);
h_wet = h_en * h_det;
h_run = h_wet > 0 ? 1 : 0;
h_d = 0.25 * exp2(5 * h_drv);
h_id = 1 / h_d;
h_osc = h_id * exp2(5 * h_drv * (1 - 0.5 * h_cmp));
h_msel = clamp(floor(h_model + 0.5), 0, 4);
h_cur = H_h_cur;
h_prev = H_h_prev;
h_fade = H_h_fade;
if (h_msel != h_cur) {
	h_prev = h_cur;
	h_cur = h_msel;
	h_fade = 0;
}
h_fade = min(1, h_fade + fstep);
h_ssel = clamp(floor(h_slope + 0.5), 0, 3);
h_tit = h_ssel > 0.5 ? 1 : 0;
h_n12 = (h_cur == 1 || h_cur == 3 || h_cur == 4) ? 1 : 0;
h_next = h_n12 > 0.5 ? h_ssel : max(0, h_ssel - 1);
h_ti = H_h_ti + a_mix * (h_tit - H_h_ti);
h_w0 = H_h_w0 + a_mix * ((h_next == 0 ? 1 : 0) - H_h_w0);
h_w1 = H_h_w1 + a_mix * ((h_next == 1 ? 1 : 0) - H_h_w1);
h_w2 = H_h_w2 + a_mix * ((h_next == 2 ? 1 : 0) - H_h_w2);
h_w3 = H_h_w3 + a_mix * ((h_next == 3 ? 1 : 0) - H_h_w3);
h_xa = (h_w1 + h_w2 + h_w3) > 0.00001 ? 1 : 0;
h_xb = (h_w2 + h_w3) > 0.00001 ? 1 : 0;
h_xc = h_w3 > 0.00001 ? 1 : 0;
h_gx = h_gw;
h_ash = (h_run > 0.5 && (h_cur == 0 || (h_prev == 0 && h_fade < 1))) ? 1 : 0;
h_msh = (h_cur == 0 ? h_fade : 0) + ((h_prev == 0 && h_cur != 0) ? 1 - h_fade : 0);
h_ak3 = (h_run > 0.5 && (h_cur == 1 || (h_prev == 1 && h_fade < 1))) ? 1 : 0;
h_mk3 = (h_cur == 1 ? h_fade : 0) + ((h_prev == 1 && h_cur != 1) ? 1 - h_fade : 0);
h_ald = (h_run > 0.5 && (h_cur == 2 || (h_prev == 2 && h_fade < 1))) ? 1 : 0;
h_mld = (h_cur == 2 ? h_fade : 0) + ((h_prev == 2 && h_cur != 2) ? 1 - h_fade : 0);
h_ast = (h_run > 0.5 && (h_cur == 3 || (h_prev == 3 && h_fade < 1))) ? 1 : 0;
h_mst = (h_cur == 3 ? h_fade : 0) + ((h_prev == 3 && h_cur != 3) ? 1 - h_fade : 0);
h_ase = (h_run > 0.5 && (h_cur == 4 || (h_prev == 4 && h_fade < 1))) ? 1 : 0;
h_mse = (h_cur == 4 ? h_fade : 0) + ((h_prev == 4 && h_cur != 4) ? 1 - h_fade : 0);
// coefficients: Sherman Filterbank-inspired
h_sh_g = h_gw;
h_sh_R1 = 0.3 + 0.7 * (1 - h_rz) * (1 - h_rz);
h_sh_R = 0.8 * (1 - h_rz) * (1 - h_rz) - 0.08 * pow(h_rz, 30);
h_sh_fb = 0.92 * h_chr;
// coefficients: Korg 35 (MS-20 Mk1)-inspired
h_k3_g = h_gw;
h_k3_K = 0.05 + 2.03 * pow(h_rz, 1.1);
h_k3_L = 4 * exp2(-4 * h_chr);
// coefficients: Moog transistor ladder-inspired
h_ld_g = h_gw;
h_ld_k = 4.3 * pow(h_rz, 1.3);
h_ld_bc = h_cmp * 0;
h_ld_hs = 1 + 2 * h_chr;
// coefficients: Steiner-Parker Synthacon-inspired
h_st_g = h_gw;
h_st_K = 1 + 2.1 * pow(h_rz, 1.3);
h_st_kd = 1 / pow(h_st_K, h_cmp);
// coefficients: Oberheim SEM-inspired
h_se_g = h_gw;
h_se_R = pow(20, -h_rz);
if (h_ash < 0.5) {
	h_L_sh_s1a = 0;
	h_L_sh_s2a = 0;
	h_L_sh_ba = 0;
	h_L_sh_s1b = 0;
	h_L_sh_s2b = 0;
	h_L_sh_bb = 0;
	h_L_sh_yp = 0;
	h_R_sh_s1a = 0;
	h_R_sh_s2a = 0;
	h_R_sh_ba = 0;
	h_R_sh_s1b = 0;
	h_R_sh_s2b = 0;
	h_R_sh_bb = 0;
	h_R_sh_yp = 0;
}
if (h_ak3 < 0.5) {
	h_L_k3_s1 = 0;
	h_L_k3_s2 = 0;
	h_L_k3_s3 = 0;
	h_L_k3_yp = 0;
	h_R_k3_s1 = 0;
	h_R_k3_s2 = 0;
	h_R_k3_s3 = 0;
	h_R_k3_yp = 0;
}
if (h_ald < 0.5) {
	h_L_ld_s1 = 0;
	h_L_ld_s2 = 0;
	h_L_ld_s3 = 0;
	h_L_ld_s4 = 0;
	h_L_ld_p0 = 0;
	h_L_ld_p1 = 0;
	h_L_ld_p2 = 0;
	h_L_ld_p3 = 0;
	h_L_ld_p4 = 0;
	h_R_ld_s1 = 0;
	h_R_ld_s2 = 0;
	h_R_ld_s3 = 0;
	h_R_ld_s4 = 0;
	h_R_ld_p0 = 0;
	h_R_ld_p1 = 0;
	h_R_ld_p2 = 0;
	h_R_ld_p3 = 0;
	h_R_ld_p4 = 0;
}
if (h_ast < 0.5) {
	h_L_st_s1 = 0;
	h_L_st_s2 = 0;
	h_L_st_d1 = 0;
	h_L_st_d2 = 0;
	h_L_st_vb = 0;
	h_R_st_s1 = 0;
	h_R_st_s2 = 0;
	h_R_st_d1 = 0;
	h_R_st_d2 = 0;
	h_R_st_vb = 0;
}
if (h_ase < 0.5) {
	h_L_se_s1 = 0;
	h_L_se_s2 = 0;
	h_L_se_hq = 0;
	h_L_se_bq = 0;
	h_R_se_s1 = 0;
	h_R_se_s2 = 0;
	h_R_se_hq = 0;
	h_R_se_bq = 0;
}
if (h_xa < 0.5 || h_run < 0.5) {
	h_L_x0_s1 = 0;
	h_L_x0_s2 = 0;
	h_R_x0_s1 = 0;
	h_R_x0_s2 = 0;
}
if (h_xb < 0.5 || h_run < 0.5) {
	h_L_x1_s1 = 0;
	h_L_x1_s2 = 0;
	h_R_x1_s1 = 0;
	h_R_x1_s2 = 0;
}
if (h_xc < 0.5 || h_run < 0.5) {
	h_L_x2_s1 = 0;
	h_L_x2_s2 = 0;
	h_R_x2_s1 = 0;
	h_R_x2_s2 = 0;
}

// ================= BPF controls (v1.2) =================
b_lc = H_b_lc + a_cut * (log2(clamp(b_freq, 30, 12000)) - H_b_lc);
b_bwz = H_b_bwz + a_par * (clamp(b_bw, 0.2, 6) - H_b_bwz);
b_lq = H_b_lq + a_par * (log2(clamp(b_q, 0.5, 10)) - H_b_lq);
b_rz = H_b_rz + a_par * (clamp(b_res, 0, 100) * 0.01 - H_b_rz);
b_drv = H_b_drv + a_par * (clamp(b_drive, 0, 100) * 0.01 - H_b_drv);
b_cmp = H_b_cmp + a_par * (clamp(b_comp, 0, 100) * 0.01 - H_b_cmp);
b_mxt = clamp(b_mix, 0, 100) * 0.01;
b_mx = H_b_mx + a_mix * (b_mxt - H_b_mx);
if (abs(b_mx - b_mxt) < 0.0001 && (b_mxt < 0.0001 || b_mxt > 0.9999)) {
	b_mx = b_mxt;
}
b_ent = b_on > 0.5 ? 1 : 0;
b_en = H_b_en + a_mix * (b_ent - H_b_en);
if (b_ent < 0.5 && b_en < 0.0001) {
	b_en = 0;
}
if (b_ent > 0.5 && b_en > 0.9999) {
	b_en = 1;
}
b_wet = b_en * b_mx;
b_run = b_en > 0 ? 1 : 0;
b_fc = min(exp2(b_lc), 0.45 * fso);
b_qq = exp2(b_lq);
b_d = 0.25 * exp2(5 * b_drv);
b_osc = (1 / b_d) * exp2(5 * b_drv * (1 - 0.5 * b_cmp));
b_cfg = clamp(floor(b_model + 0.5), 0, 4) * 3 + clamp(floor(b_arch + 0.5), 0, 2);
b_ca = H_b_ca;
b_cb = H_b_cb;
b_act = H_b_act;
b_fade = H_b_fade;
b_ccur = b_act < 0.5 ? b_ca : b_cb;
b_newA = 0;
b_newB = 0;
if (b_cfg != b_ccur) {
	if (b_act < 0.5) {
		b_cb = b_cfg;
		b_act = 1;
		b_newB = 1;
	} else {
		b_ca = b_cfg;
		b_act = 0;
		b_newA = 1;
	}
	b_fade = 0;
}
b_fade = min(1, b_fade + fstep);
b_wA = b_act < 0.5 ? b_fade : 1 - b_fade;
b_wB = 1 - b_wA;
// slot A: per-slot coefficients
bA_run = (b_run > 0.5 && b_wA > 0) ? 1 : 0;
bA_m = floor(b_ca / 3 + 0.001);
bA_a = b_ca - 3 * bA_m;
bA_typ = (bA_m < 0.5 ? 0.0 : (bA_m < 1.5 ? 0.0 : (bA_m < 2.5 ? 0.0 : (bA_m < 3.5 ? 1.0 : 0.0))));
bA_sc = (bA_m < 0.5 ? 0.6 : (bA_m < 1.5 ? 0.7 : (bA_m < 2.5 ? 1.0 : (bA_m < 3.5 ? 1.4 : 0.5))));
bA_rg = (bA_m < 0.5 ? 0.0 : (bA_m < 1.5 ? 1.0 : (bA_m < 2.5 ? 0.0 : (bA_m < 3.5 ? 0.0 : 0.0))));
bA_r = (bA_m < 0.5 ? 0.9 : (bA_m < 1.5 ? 1.06 : (bA_m < 2.5 ? 1.06 : (bA_m < 3.5 ? 1.06 : 1.06)))) * pow(b_rz, 1.3);
bA_k = (bA_m < 0.5 ? 3.6 : (bA_m < 1.5 ? 4.3 : (bA_m < 2.5 ? 4.3 : (bA_m < 3.5 ? 4.3 : 4.3)))) * pow(b_rz, 1.3);
bA_roll = (bA_m < 0.5 ? 0.0 : (bA_m < 1.5 ? 0.0 : (bA_m < 2.5 ? 0.0 : (bA_m < 3.5 ? 1.0 : 0.0))));
bA_gc = tan(pi * b_fc / fso);
bA_R = 0.5 / b_qq;
bA_fh = clamp(b_fc * exp2(-0.5 * b_bwz), 10, 0.45 * fso);
bA_fl = clamp(b_fc * exp2(0.5 * b_bwz), 10, 0.45 * fso);
bA_gh = tan(pi * bA_fh / fso);
bA_gl = tan(pi * bA_fl / fso);
bA_cn = 1 / (f_bmag(bA_gc / bA_gh, b_qq, 1) * f_bmag(bA_gc / bA_gl, b_qq, 0));
bA_wb = clamp((b_bwz - 1) * 0.5, 0, 1);
bA_kk = min(bA_k, 4.3);
bA_cmm = ((((0.000804 * bA_kk - 0.009901) * bA_kk + 0.039923) * bA_kk - 0.03441) * bA_kk - 0.07288) * bA_kk + 0.998285;
bA_gm = bA_gc / bA_cmm;
bA_raw = bA_a < 0.5 ? b_qq : (bA_a < 1.5 ? 1 / bA_cn : 1);
bA_ocmp = pow(bA_raw, 1 - b_cmp);
bA_gro = tan(pi * min(14000, 0.45 * fso) / fso);
bA_Gro = bA_gro / (1 + bA_gro);
if (bA_run < 0.5 || b_newA > 0.5) {
	bA_L_yp = 0;
	bA_L_ro = 0;
	bA_L_v_s1 = 0;
	bA_L_v_s2 = 0;
	bA_L_v_hq = 0;
	bA_L_v_bq = 0;
	bA_L_c_s1 = 0;
	bA_L_c_s2 = 0;
	bA_L_c_hq = 0;
	bA_L_c_bq = 0;
	bA_L_c_t1 = 0;
	bA_L_c_t2 = 0;
	bA_L_c_tq = 0;
	bA_L_c_tb = 0;
	bA_L_m_s1 = 0;
	bA_L_m_s2 = 0;
	bA_L_m_s3 = 0;
	bA_L_m_s4 = 0;
	bA_L_m_p0 = 0;
	bA_L_m_p1 = 0;
	bA_L_m_p2 = 0;
	bA_L_m_p3 = 0;
	bA_L_m_p4 = 0;
	bA_R_yp = 0;
	bA_R_ro = 0;
	bA_R_v_s1 = 0;
	bA_R_v_s2 = 0;
	bA_R_v_hq = 0;
	bA_R_v_bq = 0;
	bA_R_c_s1 = 0;
	bA_R_c_s2 = 0;
	bA_R_c_hq = 0;
	bA_R_c_bq = 0;
	bA_R_c_t1 = 0;
	bA_R_c_t2 = 0;
	bA_R_c_tq = 0;
	bA_R_c_tb = 0;
	bA_R_m_s1 = 0;
	bA_R_m_s2 = 0;
	bA_R_m_s3 = 0;
	bA_R_m_s4 = 0;
	bA_R_m_p0 = 0;
	bA_R_m_p1 = 0;
	bA_R_m_p2 = 0;
	bA_R_m_p3 = 0;
	bA_R_m_p4 = 0;
}
// slot B: per-slot coefficients
bB_run = (b_run > 0.5 && b_wB > 0) ? 1 : 0;
bB_m = floor(b_cb / 3 + 0.001);
bB_a = b_cb - 3 * bB_m;
bB_typ = (bB_m < 0.5 ? 0.0 : (bB_m < 1.5 ? 0.0 : (bB_m < 2.5 ? 0.0 : (bB_m < 3.5 ? 1.0 : 0.0))));
bB_sc = (bB_m < 0.5 ? 0.6 : (bB_m < 1.5 ? 0.7 : (bB_m < 2.5 ? 1.0 : (bB_m < 3.5 ? 1.4 : 0.5))));
bB_rg = (bB_m < 0.5 ? 0.0 : (bB_m < 1.5 ? 1.0 : (bB_m < 2.5 ? 0.0 : (bB_m < 3.5 ? 0.0 : 0.0))));
bB_r = (bB_m < 0.5 ? 0.9 : (bB_m < 1.5 ? 1.06 : (bB_m < 2.5 ? 1.06 : (bB_m < 3.5 ? 1.06 : 1.06)))) * pow(b_rz, 1.3);
bB_k = (bB_m < 0.5 ? 3.6 : (bB_m < 1.5 ? 4.3 : (bB_m < 2.5 ? 4.3 : (bB_m < 3.5 ? 4.3 : 4.3)))) * pow(b_rz, 1.3);
bB_roll = (bB_m < 0.5 ? 0.0 : (bB_m < 1.5 ? 0.0 : (bB_m < 2.5 ? 0.0 : (bB_m < 3.5 ? 1.0 : 0.0))));
bB_gc = tan(pi * b_fc / fso);
bB_R = 0.5 / b_qq;
bB_fh = clamp(b_fc * exp2(-0.5 * b_bwz), 10, 0.45 * fso);
bB_fl = clamp(b_fc * exp2(0.5 * b_bwz), 10, 0.45 * fso);
bB_gh = tan(pi * bB_fh / fso);
bB_gl = tan(pi * bB_fl / fso);
bB_cn = 1 / (f_bmag(bB_gc / bB_gh, b_qq, 1) * f_bmag(bB_gc / bB_gl, b_qq, 0));
bB_wb = clamp((b_bwz - 1) * 0.5, 0, 1);
bB_kk = min(bB_k, 4.3);
bB_cmm = ((((0.000804 * bB_kk - 0.009901) * bB_kk + 0.039923) * bB_kk - 0.03441) * bB_kk - 0.07288) * bB_kk + 0.998285;
bB_gm = bB_gc / bB_cmm;
bB_raw = bB_a < 0.5 ? b_qq : (bB_a < 1.5 ? 1 / bB_cn : 1);
bB_ocmp = pow(bB_raw, 1 - b_cmp);
bB_gro = tan(pi * min(14000, 0.45 * fso) / fso);
bB_Gro = bB_gro / (1 + bB_gro);
if (bB_run < 0.5 || b_newB > 0.5) {
	bB_L_yp = 0;
	bB_L_ro = 0;
	bB_L_v_s1 = 0;
	bB_L_v_s2 = 0;
	bB_L_v_hq = 0;
	bB_L_v_bq = 0;
	bB_L_c_s1 = 0;
	bB_L_c_s2 = 0;
	bB_L_c_hq = 0;
	bB_L_c_bq = 0;
	bB_L_c_t1 = 0;
	bB_L_c_t2 = 0;
	bB_L_c_tq = 0;
	bB_L_c_tb = 0;
	bB_L_m_s1 = 0;
	bB_L_m_s2 = 0;
	bB_L_m_s3 = 0;
	bB_L_m_s4 = 0;
	bB_L_m_p0 = 0;
	bB_L_m_p1 = 0;
	bB_L_m_p2 = 0;
	bB_L_m_p3 = 0;
	bB_L_m_p4 = 0;
	bB_R_yp = 0;
	bB_R_ro = 0;
	bB_R_v_s1 = 0;
	bB_R_v_s2 = 0;
	bB_R_v_hq = 0;
	bB_R_v_bq = 0;
	bB_R_c_s1 = 0;
	bB_R_c_s2 = 0;
	bB_R_c_hq = 0;
	bB_R_c_bq = 0;
	bB_R_c_t1 = 0;
	bB_R_c_t2 = 0;
	bB_R_c_tq = 0;
	bB_R_c_tb = 0;
	bB_R_m_s1 = 0;
	bB_R_m_s2 = 0;
	bB_R_m_s3 = 0;
	bB_R_m_s4 = 0;
	bB_R_m_p0 = 0;
	bB_R_m_p1 = 0;
	bB_R_m_p2 = 0;
	bB_R_m_p3 = 0;
	bB_R_m_p4 = 0;
}

// ================= order / oversampling switching (duck) =================
cfg_o = order_sel > 0.5 ? 1 : 0;
cfg_s = ovs_sel > 0.5 ? 1 : 0;
cfg_p = b_pos > 0.5 ? 1 : 0;
b_cur_pos = H_b_cur_pos;
pend = (cfg_o != cur_order || cfg_s != cur_os || cfg_p != b_cur_pos) ? 1 : 0;
duck = H_duck;
duck = pend > 0.5 ? max(0, duck - dstep) : min(1, duck + dstep);
new_order = cur_order;
new_os = cur_os;
new_pos = b_cur_pos;
rst = 0;
if (pend > 0.5 && duck <= 0) {
	new_order = cfg_o;
	new_os = cfg_s;
	new_pos = cfg_p;
	rst = cfg_s != cur_os ? 1 : 0;
}

// ================= input (2x upsampler when oversampling) =================
xa_L = x_L;
xb_L = 0;
xa_R = x_R;
xb_R = 0;
if (ovs > 1.5) {
	xa_L, os_L_upa0, os_L_upa1, os_L_upa2, os_L_upa3, os_L_upa4, os_L_upa5 = f_ap5(x_L, os_L_upa0, os_L_upa1, os_L_upa2, os_L_upa3, os_L_upa4, os_L_upa5, 0.035979631179546, 0.270744078039831, 0.557994617257913, 0.775098715397111, 0.916958938825425);
	xb_L, os_L_upb0, os_L_upb1, os_L_upb2, os_L_upb3, os_L_upb4, os_L_upb5 = f_ap5(x_L, os_L_upb0, os_L_upb1, os_L_upb2, os_L_upb3, os_L_upb4, os_L_upb5, 0.134200951194299, 0.418804850254691, 0.677594451212584, 0.853151529122229, 0.972847950939362);
	xa_R, os_R_upa0, os_R_upa1, os_R_upa2, os_R_upa3, os_R_upa4, os_R_upa5 = f_ap5(x_R, os_R_upa0, os_R_upa1, os_R_upa2, os_R_upa3, os_R_upa4, os_R_upa5, 0.035979631179546, 0.270744078039831, 0.557994617257913, 0.775098715397111, 0.916958938825425);
	xb_R, os_R_upb0, os_R_upb1, os_R_upb2, os_R_upb3, os_R_upb4, os_R_upb5 = f_ap5(x_R, os_R_upb0, os_R_upb1, os_R_upb2, os_R_upb3, os_R_upb4, os_R_upb5, 0.134200951194299, 0.418804850254691, 0.677594451212584, 0.853151529122229, 0.972847950939362);
}

zb_L = 0;
zb_R = 0;
// ================= processing chain, subsample a =================
if (b_cur_pos > 0.5) {
	if (b_run > 0.5) {
		bo_L = 0;
		if (bA_run > 0.5) {
			bx = xa_L * b_d;
			by = 0;
			bt = f_bsat(bA_L_yp * 3.3333333333, bA_rg);
			if (bA_a < 0.5) {
				ah, bh, ab, bb, al, bl = f_bsva(bA_L_v_s1, bA_L_v_s2, bA_L_v_hq, bA_L_v_bq, bA_gc, bA_R, bA_sc);
				nA = 2 * bA_R * ab;
				nB = 2 * bA_R * bb;
				bu = (bx + bA_r * bt * nB) / (1 - bA_r * bt * nA);
				hh, b1, l1, bA_L_v_s1, bA_L_v_s2 = f_bsvs(bu, bA_L_v_s1, bA_L_v_s2, bA_L_v_hq, bA_L_v_bq, bA_gc, bA_R, bA_sc);
				bA_L_v_hq = hh;
				bA_L_v_bq = b1;
				by = 2 * bA_R * b1;
			}
			if (bA_a > 0.5 && bA_a < 1.5) {
				ah, bh, ab, bb, al, bl = f_bsva(bA_L_c_s1, bA_L_c_s2, bA_L_c_hq, bA_L_c_bq, bA_gh, bA_R, bA_sc);
				ah2, bh2, ab2, bb2, al2, bl2 = f_bsva(bA_L_c_t1, bA_L_c_t2, bA_L_c_tq, bA_L_c_tb, bA_gl, bA_R, bA_sc);
				nA = bA_cn * al2 * ah;
				nB = bA_cn * (al2 * bh + bl2);
				bu = (bx + bA_r * bt * nB) / (1 - bA_r * bt * nA);
				hh, b1, l1, bA_L_c_s1, bA_L_c_s2 = f_bsvs(bu, bA_L_c_s1, bA_L_c_s2, bA_L_c_hq, bA_L_c_bq, bA_gh, bA_R, bA_sc);
				bA_L_c_hq = hh;
				bA_L_c_bq = b1;
				hh2, b2, l2, bA_L_c_t1, bA_L_c_t2 = f_bsvs(hh, bA_L_c_t1, bA_L_c_t2, bA_L_c_tq, bA_L_c_tb, bA_gl, bA_R, bA_sc);
				bA_L_c_tq = hh2;
				bA_L_c_tb = b2;
				by = bA_cn * l2;
			}
			if (bA_a > 1.5) {
				by, bA_L_m_s1, bA_L_m_s2, bA_L_m_s3, bA_L_m_s4, bA_L_m_p0, bA_L_m_p1, bA_L_m_p2, bA_L_m_p3, bA_L_m_p4 = f_bmm(bx, bA_L_m_s1, bA_L_m_s2, bA_L_m_s3, bA_L_m_s4, bA_L_m_p0, bA_L_m_p1, bA_L_m_p2, bA_L_m_p3, bA_L_m_p4, bA_gm, bA_k, bA_typ, bA_sc, bA_wb);
			}
			bA_L_yp = by;
			if (bA_roll > 0.5) {
				by, bA_L_ro = f_op(by, bA_L_ro, bA_Gro);
				bA_L_ro = fixdenorm(bA_L_ro);
			}
			bo_L = bo_L + b_wA * by * bA_ocmp * b_osc;
		}
		if (bB_run > 0.5) {
			bx = xa_L * b_d;
			by = 0;
			bt = f_bsat(bB_L_yp * 3.3333333333, bB_rg);
			if (bB_a < 0.5) {
				ah, bh, ab, bb, al, bl = f_bsva(bB_L_v_s1, bB_L_v_s2, bB_L_v_hq, bB_L_v_bq, bB_gc, bB_R, bB_sc);
				nA = 2 * bB_R * ab;
				nB = 2 * bB_R * bb;
				bu = (bx + bB_r * bt * nB) / (1 - bB_r * bt * nA);
				hh, b1, l1, bB_L_v_s1, bB_L_v_s2 = f_bsvs(bu, bB_L_v_s1, bB_L_v_s2, bB_L_v_hq, bB_L_v_bq, bB_gc, bB_R, bB_sc);
				bB_L_v_hq = hh;
				bB_L_v_bq = b1;
				by = 2 * bB_R * b1;
			}
			if (bB_a > 0.5 && bB_a < 1.5) {
				ah, bh, ab, bb, al, bl = f_bsva(bB_L_c_s1, bB_L_c_s2, bB_L_c_hq, bB_L_c_bq, bB_gh, bB_R, bB_sc);
				ah2, bh2, ab2, bb2, al2, bl2 = f_bsva(bB_L_c_t1, bB_L_c_t2, bB_L_c_tq, bB_L_c_tb, bB_gl, bB_R, bB_sc);
				nA = bB_cn * al2 * ah;
				nB = bB_cn * (al2 * bh + bl2);
				bu = (bx + bB_r * bt * nB) / (1 - bB_r * bt * nA);
				hh, b1, l1, bB_L_c_s1, bB_L_c_s2 = f_bsvs(bu, bB_L_c_s1, bB_L_c_s2, bB_L_c_hq, bB_L_c_bq, bB_gh, bB_R, bB_sc);
				bB_L_c_hq = hh;
				bB_L_c_bq = b1;
				hh2, b2, l2, bB_L_c_t1, bB_L_c_t2 = f_bsvs(hh, bB_L_c_t1, bB_L_c_t2, bB_L_c_tq, bB_L_c_tb, bB_gl, bB_R, bB_sc);
				bB_L_c_tq = hh2;
				bB_L_c_tb = b2;
				by = bB_cn * l2;
			}
			if (bB_a > 1.5) {
				by, bB_L_m_s1, bB_L_m_s2, bB_L_m_s3, bB_L_m_s4, bB_L_m_p0, bB_L_m_p1, bB_L_m_p2, bB_L_m_p3, bB_L_m_p4 = f_bmm(bx, bB_L_m_s1, bB_L_m_s2, bB_L_m_s3, bB_L_m_s4, bB_L_m_p0, bB_L_m_p1, bB_L_m_p2, bB_L_m_p3, bB_L_m_p4, bB_gm, bB_k, bB_typ, bB_sc, bB_wb);
			}
			bB_L_yp = by;
			if (bB_roll > 0.5) {
				by, bB_L_ro = f_op(by, bB_L_ro, bB_Gro);
				bB_L_ro = fixdenorm(bB_L_ro);
			}
			bo_L = bo_L + b_wB * by * bB_ocmp * b_osc;
		}
		xa_L = xa_L + b_wet * (bo_L - xa_L);
		bo_R = 0;
		if (bA_run > 0.5) {
			bx = xa_R * b_d;
			by = 0;
			bt = f_bsat(bA_R_yp * 3.3333333333, bA_rg);
			if (bA_a < 0.5) {
				ah, bh, ab, bb, al, bl = f_bsva(bA_R_v_s1, bA_R_v_s2, bA_R_v_hq, bA_R_v_bq, bA_gc, bA_R, bA_sc);
				nA = 2 * bA_R * ab;
				nB = 2 * bA_R * bb;
				bu = (bx + bA_r * bt * nB) / (1 - bA_r * bt * nA);
				hh, b1, l1, bA_R_v_s1, bA_R_v_s2 = f_bsvs(bu, bA_R_v_s1, bA_R_v_s2, bA_R_v_hq, bA_R_v_bq, bA_gc, bA_R, bA_sc);
				bA_R_v_hq = hh;
				bA_R_v_bq = b1;
				by = 2 * bA_R * b1;
			}
			if (bA_a > 0.5 && bA_a < 1.5) {
				ah, bh, ab, bb, al, bl = f_bsva(bA_R_c_s1, bA_R_c_s2, bA_R_c_hq, bA_R_c_bq, bA_gh, bA_R, bA_sc);
				ah2, bh2, ab2, bb2, al2, bl2 = f_bsva(bA_R_c_t1, bA_R_c_t2, bA_R_c_tq, bA_R_c_tb, bA_gl, bA_R, bA_sc);
				nA = bA_cn * al2 * ah;
				nB = bA_cn * (al2 * bh + bl2);
				bu = (bx + bA_r * bt * nB) / (1 - bA_r * bt * nA);
				hh, b1, l1, bA_R_c_s1, bA_R_c_s2 = f_bsvs(bu, bA_R_c_s1, bA_R_c_s2, bA_R_c_hq, bA_R_c_bq, bA_gh, bA_R, bA_sc);
				bA_R_c_hq = hh;
				bA_R_c_bq = b1;
				hh2, b2, l2, bA_R_c_t1, bA_R_c_t2 = f_bsvs(hh, bA_R_c_t1, bA_R_c_t2, bA_R_c_tq, bA_R_c_tb, bA_gl, bA_R, bA_sc);
				bA_R_c_tq = hh2;
				bA_R_c_tb = b2;
				by = bA_cn * l2;
			}
			if (bA_a > 1.5) {
				by, bA_R_m_s1, bA_R_m_s2, bA_R_m_s3, bA_R_m_s4, bA_R_m_p0, bA_R_m_p1, bA_R_m_p2, bA_R_m_p3, bA_R_m_p4 = f_bmm(bx, bA_R_m_s1, bA_R_m_s2, bA_R_m_s3, bA_R_m_s4, bA_R_m_p0, bA_R_m_p1, bA_R_m_p2, bA_R_m_p3, bA_R_m_p4, bA_gm, bA_k, bA_typ, bA_sc, bA_wb);
			}
			bA_R_yp = by;
			if (bA_roll > 0.5) {
				by, bA_R_ro = f_op(by, bA_R_ro, bA_Gro);
				bA_R_ro = fixdenorm(bA_R_ro);
			}
			bo_R = bo_R + b_wA * by * bA_ocmp * b_osc;
		}
		if (bB_run > 0.5) {
			bx = xa_R * b_d;
			by = 0;
			bt = f_bsat(bB_R_yp * 3.3333333333, bB_rg);
			if (bB_a < 0.5) {
				ah, bh, ab, bb, al, bl = f_bsva(bB_R_v_s1, bB_R_v_s2, bB_R_v_hq, bB_R_v_bq, bB_gc, bB_R, bB_sc);
				nA = 2 * bB_R * ab;
				nB = 2 * bB_R * bb;
				bu = (bx + bB_r * bt * nB) / (1 - bB_r * bt * nA);
				hh, b1, l1, bB_R_v_s1, bB_R_v_s2 = f_bsvs(bu, bB_R_v_s1, bB_R_v_s2, bB_R_v_hq, bB_R_v_bq, bB_gc, bB_R, bB_sc);
				bB_R_v_hq = hh;
				bB_R_v_bq = b1;
				by = 2 * bB_R * b1;
			}
			if (bB_a > 0.5 && bB_a < 1.5) {
				ah, bh, ab, bb, al, bl = f_bsva(bB_R_c_s1, bB_R_c_s2, bB_R_c_hq, bB_R_c_bq, bB_gh, bB_R, bB_sc);
				ah2, bh2, ab2, bb2, al2, bl2 = f_bsva(bB_R_c_t1, bB_R_c_t2, bB_R_c_tq, bB_R_c_tb, bB_gl, bB_R, bB_sc);
				nA = bB_cn * al2 * ah;
				nB = bB_cn * (al2 * bh + bl2);
				bu = (bx + bB_r * bt * nB) / (1 - bB_r * bt * nA);
				hh, b1, l1, bB_R_c_s1, bB_R_c_s2 = f_bsvs(bu, bB_R_c_s1, bB_R_c_s2, bB_R_c_hq, bB_R_c_bq, bB_gh, bB_R, bB_sc);
				bB_R_c_hq = hh;
				bB_R_c_bq = b1;
				hh2, b2, l2, bB_R_c_t1, bB_R_c_t2 = f_bsvs(hh, bB_R_c_t1, bB_R_c_t2, bB_R_c_tq, bB_R_c_tb, bB_gl, bB_R, bB_sc);
				bB_R_c_tq = hh2;
				bB_R_c_tb = b2;
				by = bB_cn * l2;
			}
			if (bB_a > 1.5) {
				by, bB_R_m_s1, bB_R_m_s2, bB_R_m_s3, bB_R_m_s4, bB_R_m_p0, bB_R_m_p1, bB_R_m_p2, bB_R_m_p3, bB_R_m_p4 = f_bmm(bx, bB_R_m_s1, bB_R_m_s2, bB_R_m_s3, bB_R_m_s4, bB_R_m_p0, bB_R_m_p1, bB_R_m_p2, bB_R_m_p3, bB_R_m_p4, bB_gm, bB_k, bB_typ, bB_sc, bB_wb);
			}
			bB_R_yp = by;
			if (bB_roll > 0.5) {
				by, bB_R_ro = f_op(by, bB_R_ro, bB_Gro);
				bB_R_ro = fixdenorm(bB_R_ro);
			}
			bo_R = bo_R + b_wB * by * bB_ocmp * b_osc;
		}
		xa_R = xa_R + b_wet * (bo_R - xa_R);
	}
}
hya_L = 0;
hya_R = 0;
if (cur_order > 0.5) {
	// ---- HPF stage, subsample a ----
	hya_L = xa_L;
	hya_R = xa_R;
	if (h_run > 0.5) {
		hi_L = xa_L * h_d;
		hb_L = 0;
		if (h_ash > 0.5) {
			o12, o24, h_L_sh_s1a, h_L_sh_s2a, h_L_sh_ba, h_L_sh_s1b, h_L_sh_s2b, h_L_sh_bb, h_L_sh_yp = f_sherman(hi_L, h_L_sh_s1a, h_L_sh_s2a, h_L_sh_ba, h_L_sh_s1b, h_L_sh_s2b, h_L_sh_bb, h_L_sh_yp, h_sh_g, h_sh_R1, h_sh_R, h_sh_fb, h_ti, 1);
			hb_L = hb_L + h_msh * (o12 + h_ti * (o24 - o12));
		}
		if (h_ak3 > 0.5) {
			o1, h_L_k3_s1, h_L_k3_s2, h_L_k3_s3, h_L_k3_yp = f_k35hp(hi_L, h_L_k3_s1, h_L_k3_s2, h_L_k3_s3, h_L_k3_yp, h_k3_g, h_k3_K, h_k3_L);
			hb_L = hb_L + h_mk3 * o1;
		}
		if (h_ald > 0.5) {
			o12, o24, h_L_ld_s1, h_L_ld_s2, h_L_ld_s3, h_L_ld_s4, h_L_ld_p0, h_L_ld_p1, h_L_ld_p2, h_L_ld_p3, h_L_ld_p4 = f_ladder(hi_L, h_L_ld_s1, h_L_ld_s2, h_L_ld_s3, h_L_ld_s4, h_L_ld_p0, h_L_ld_p1, h_L_ld_p2, h_L_ld_p3, h_L_ld_p4, h_ld_g, h_ld_k, h_ld_bc, h_ld_hs, 1);
			hb_L = hb_L + h_mld * (o12 + h_ti * (o24 - o12));
		}
		if (h_ast > 0.5) {
			o1, h_L_st_s1, h_L_st_s2, h_L_st_d1, h_L_st_d2, h_L_st_vb = f_steiner(hi_L * (1 - h_chr) * 0, hi_L * h_chr, hi_L * (1 - h_chr) * 1, h_L_st_s1, h_L_st_s2, h_L_st_d1, h_L_st_d2, h_L_st_vb, h_st_g, h_st_K);
			hb_L = hb_L + h_mst * o1 * h_st_kd;
		}
		if (h_ase > 0.5) {
