bB_L_v_s2 = H_bB_L_v_s2;
bB_L_v_hq = H_bB_L_v_hq;
bB_L_v_bq = H_bB_L_v_bq;
bB_L_c_s1 = H_bB_L_c_s1;
bB_L_c_s2 = H_bB_L_c_s2;
bB_L_c_hq = H_bB_L_c_hq;
bB_L_c_bq = H_bB_L_c_bq;
bB_L_c_t1 = H_bB_L_c_t1;
bB_L_c_t2 = H_bB_L_c_t2;
bB_L_c_tq = H_bB_L_c_tq;
bB_L_c_tb = H_bB_L_c_tb;
