				}
				if (bB_a > 0.5 && bB_a < 1.5) {
					ah, bh, ab, bb, al, bl = f_bsva(bB_R_c_s1, bB_R_c_s2, bB_R_c_hq, bB_R_c_bq, bB_gh, bB_R, bB_sc);
					ah2, bh2, ab2, bb2, al2, bl2 = f_bsva(bB_R_c_t1, bB_R_c_t2, bB_R_c_tq, bB_R_c_tb, bB_gl, bB_R, bB_sc);
					nA = bB_cn * al2 * ah;
					nB = bB_cn * (al2 * bh + bl2);
					bu = (bx + bB_r * bt * nB) / (1 - bB_r * bt * nA);
					hh, b1, l1, bB_R_c_s1, bB_R_c_s2 = f_bsvs(bu, bB_R_c_s1, bB_R_c_s2, bB_R_c_hq, bB_R_c_bq, bB_gh, bB_R, bB_sc);
					bB_R_c_hq = hh;
					bB_R_c_bq = b1;
					hh2, b2, l2, bB_R_c_t1, bB_R_c_t2 = f_bsvs(hh, bB_R_c_t1, bB_R_c_t2, bB_R_c_tq, bB_R_c_tb, bB_gl, bB_R, bB_sc);
					bB_R_c_tq = hh2;
					bB_R_c_tb = b2;
					by = bB_cn * l2;
				}
				if (bB_a > 1.5) {
					by, bB_R_m_s1, bB_R_m_s2, bB_R_m_s3, bB_R_m_s4, bB_R_m_p0, bB_R_m_p1, bB_R_m_p2, bB_R_m_p3, bB_R_m_p4 = f_bmm(bx, bB_R_m_s1, bB_R_m_s2, bB_R_m_s3, bB_R_m_s4, bB_R_m_p0, bB_R_m_p1, bB_R_m_p2, bB_R_m_p3, bB_R_m_p4, bB_gm, bB_k, bB_typ, bB_sc, bB_wb);
				}
				bB_R_yp = by;
				if (bB_roll > 0.5) {
					by, bB_R_ro = f_op(by, bB_R_ro, bB_Gro);
					bB_R_ro = fixdenorm(bB_R_ro);
				}
				bo_R = bo_R + b_wB * by * bB_ocmp * b_osc;
			}
			xb_R = xb_R + b_wet * (bo_R - xb_R);
		}
	}
	hyb_L = 0;
	hyb_R = 0;
	if (cur_order > 0.5) {
		// ---- HPF stage, subsample b ----
		hyb_L = xb_L;
		hyb_R = xb_R;
		if (h_run > 0.5) {
			hi_L = xb_L * h_d;
			hb_L = 0;
			if (h_ash > 0.5) {
				o12, o24, h_L_sh_s1a, h_L_sh_s2a, h_L_sh_ba, h_L_sh_s1b, h_L_sh_s2b, h_L_sh_bb, h_L_sh_yp = f_sherman(hi_L, h_L_sh_s1a, h_L_sh_s2a, h_L_sh_ba, h_L_sh_s1b, h_L_sh_s2b, h_L_sh_bb, h_L_sh_yp, h_sh_g, h_sh_R1, h_sh_R, h_sh_fb, h_ti, 1);
				hb_L = hb_L + h_msh * (o12 + h_ti * (o24 - o12));
			}
			if (h_ak3 > 0.5) {
				o1, h_L_k3_s1, h_L_k3_s2, h_L_k3_s3, h_L_k3_yp = f_k35hp(hi_L, h_L_k3_s1, h_L_k3_s2, h_L_k3_s3, h_L_k3_yp, h_k3_g, h_k3_K, h_k3_L);
				hb_L = hb_L + h_mk3 * o1;
			}
			if (h_ald > 0.5) {
				o12, o24, h_L_ld_s1, h_L_ld_s2, h_L_ld_s3, h_L_ld_s4, h_L_ld_p0, h_L_ld_p1, h_L_ld_p2, h_L_ld_p3, h_L_ld_p4 = f_ladder(hi_L, h_L_ld_s1, h_L_ld_s2, h_L_ld_s3, h_L_ld_s4, h_L_ld_p0, h_L_ld_p1, h_L_ld_p2, h_L_ld_p3, h_L_ld_p4, h_ld_g, h_ld_k, h_ld_bc, h_ld_hs, 1);
				hb_L = hb_L + h_mld * (o12 + h_ti * (o24 - o12));
			}
			if (h_ast > 0.5) {
				o1, h_L_st_s1, h_L_st_s2, h_L_st_d1, h_L_st_d2, h_L_st_vb = f_steiner(hi_L * (1 - h_chr) * 0, hi_L * h_chr, hi_L * (1 - h_chr) * 1, h_L_st_s1, h_L_st_s2, h_L_st_d1, h_L_st_d2, h_L_st_vb, h_st_g, h_st_K);
				hb_L = hb_L + h_mst * o1 * h_st_kd;
			}
			if (h_ase > 0.5) {
				o1, h_L_se_s1, h_L_se_s2, h_L_se_hq, h_L_se_bq = f_sem(hi_L, h_L_se_s1, h_L_se_s2, h_L_se_hq, h_L_se_bq, h_se_g, h_se_R, h_chr, 1);
				hb_L = hb_L + h_mse * o1;
			}
			e0 = hb_L;
			e1 = 0;
			e2 = 0;
			e3 = 0;
			if (h_xa > 0.5) {
				eh, eb, el, h_L_x0_s1, h_L_x0_s2 = f_svf(e0, h_L_x0_s1, h_L_x0_s2, h_gx, 0.7071067811865476);
				h_L_x0_s1 = fixdenorm(h_L_x0_s1);
				h_L_x0_s2 = fixdenorm(h_L_x0_s2);
				e1 = eh;
			}
			if (h_xb > 0.5) {
				eh, eb, el, h_L_x1_s1, h_L_x1_s2 = f_svf(e1, h_L_x1_s1, h_L_x1_s2, h_gx, 0.7071067811865476);
				h_L_x1_s1 = fixdenorm(h_L_x1_s1);
				h_L_x1_s2 = fixdenorm(h_L_x1_s2);
				e2 = eh;
			}
			if (h_xc > 0.5) {
				eh, eb, el, h_L_x2_s1, h_L_x2_s2 = f_svf(e2, h_L_x2_s1, h_L_x2_s2, h_gx, 0.7071067811865476);
				h_L_x2_s1 = fixdenorm(h_L_x2_s1);
				h_L_x2_s2 = fixdenorm(h_L_x2_s2);
				e3 = eh;
			}
			wet_L = (h_w0 * e0 + h_w1 * e1 + h_w2 * e2 + h_w3 * e3) * h_osc;
			hyb_L = xb_L + h_wet * (wet_L - xb_L);
			hi_R = xb_R * h_d;
			hb_R = 0;
			if (h_ash > 0.5) {
				o12, o24, h_R_sh_s1a, h_R_sh_s2a, h_R_sh_ba, h_R_sh_s1b, h_R_sh_s2b, h_R_sh_bb, h_R_sh_yp = f_sherman(hi_R, h_R_sh_s1a, h_R_sh_s2a, h_R_sh_ba, h_R_sh_s1b, h_R_sh_s2b, h_R_sh_bb, h_R_sh_yp, h_sh_g, h_sh_R1, h_sh_R, h_sh_fb, h_ti, 1);
				hb_R = hb_R + h_msh * (o12 + h_ti * (o24 - o12));
			}
			if (h_ak3 > 0.5) {
				o1, h_R_k3_s1, h_R_k3_s2, h_R_k3_s3, h_R_k3_yp = f_k35hp(hi_R, h_R_k3_s1, h_R_k3_s2, h_R_k3_s3, h_R_k3_yp, h_k3_g, h_k3_K, h_k3_L);
				hb_R = hb_R + h_mk3 * o1;
			}
			if (h_ald > 0.5) {
				o12, o24, h_R_ld_s1, h_R_ld_s2, h_R_ld_s3, h_R_ld_s4, h_R_ld_p0, h_R_ld_p1, h_R_ld_p2, h_R_ld_p3, h_R_ld_p4 = f_ladder(hi_R, h_R_ld_s1, h_R_ld_s2, h_R_ld_s3, h_R_ld_s4, h_R_ld_p0, h_R_ld_p1, h_R_ld_p2, h_R_ld_p3, h_R_ld_p4, h_ld_g, h_ld_k, h_ld_bc, h_ld_hs, 1);
				hb_R = hb_R + h_mld * (o12 + h_ti * (o24 - o12));
			}
			if (h_ast > 0.5) {
				o1, h_R_st_s1, h_R_st_s2, h_R_st_d1, h_R_st_d2, h_R_st_vb = f_steiner(hi_R * (1 - h_chr) * 0, hi_R * h_chr, hi_R * (1 - h_chr) * 1, h_R_st_s1, h_R_st_s2, h_R_st_d1, h_R_st_d2, h_R_st_vb, h_st_g, h_st_K);
				hb_R = hb_R + h_mst * o1 * h_st_kd;
			}
			if (h_ase > 0.5) {
				o1, h_R_se_s1, h_R_se_s2, h_R_se_hq, h_R_se_bq = f_sem(hi_R, h_R_se_s1, h_R_se_s2, h_R_se_hq, h_R_se_bq, h_se_g, h_se_R, h_chr, 1);
				hb_R = hb_R + h_mse * o1;
			}
			e0 = hb_R;
			e1 = 0;
			e2 = 0;
			e3 = 0;
			if (h_xa > 0.5) {
				eh, eb, el, h_R_x0_s1, h_R_x0_s2 = f_svf(e0, h_R_x0_s1, h_R_x0_s2, h_gx, 0.7071067811865476);
				h_R_x0_s1 = fixdenorm(h_R_x0_s1);
				h_R_x0_s2 = fixdenorm(h_R_x0_s2);
				e1 = eh;
			}
			if (h_xb > 0.5) {
				eh, eb, el, h_R_x1_s1, h_R_x1_s2 = f_svf(e1, h_R_x1_s1, h_R_x1_s2, h_gx, 0.7071067811865476);
				h_R_x1_s1 = fixdenorm(h_R_x1_s1);
				h_R_x1_s2 = fixdenorm(h_R_x1_s2);
				e2 = eh;
			}
			if (h_xc > 0.5) {
				eh, eb, el, h_R_x2_s1, h_R_x2_s2 = f_svf(e2, h_R_x2_s1, h_R_x2_s2, h_gx, 0.7071067811865476);
				h_R_x2_s1 = fixdenorm(h_R_x2_s1);
				h_R_x2_s2 = fixdenorm(h_R_x2_s2);
				e3 = eh;
			}
			wet_R = (h_w0 * e0 + h_w1 * e1 + h_w2 * e2 + h_w3 * e3) * h_osc;
			hyb_R = xb_R + h_wet * (wet_R - xb_R);
		}
	}
	lsrc_L = cur_order > 0.5 ? hyb_L : xb_L;
	lsrc_R = cur_order > 0.5 ? hyb_R : xb_R;
	// ---- LPF stage, subsample b ----
	lyb_L = lsrc_L;
	lyb_R = lsrc_R;
	if (l_run > 0.5) {
		li_L = lsrc_L * l_d;
		lb_L = 0;
		if (l_ash > 0.5) {
			o12, o24, l_L_sh_s1a, l_L_sh_s2a, l_L_sh_ba, l_L_sh_s1b, l_L_sh_s2b, l_L_sh_bb, l_L_sh_yp = f_sherman(li_L, l_L_sh_s1a, l_L_sh_s2a, l_L_sh_ba, l_L_sh_s1b, l_L_sh_s2b, l_L_sh_bb, l_L_sh_yp, l_sh_g, l_sh_R1, l_sh_R, l_sh_fb, l_ti, 0);
			lb_L = lb_L + l_msh * (o12 + l_ti * (o24 - o12));
		}
		if (l_ak3 > 0.5) {
			o1, l_L_k3_s1, l_L_k3_s2, l_L_k3_s3, l_L_k3_yp = f_k35lp(li_L, l_L_k3_s1, l_L_k3_s2, l_L_k3_s3, l_L_k3_yp, l_k3_g, l_k3_K, l_k3_L);
			lb_L = lb_L + l_mk3 * o1;
		}
		if (l_ald > 0.5) {
			o12, o24, l_L_ld_s1, l_L_ld_s2, l_L_ld_s3, l_L_ld_s4, l_L_ld_p0, l_L_ld_p1, l_L_ld_p2, l_L_ld_p3, l_L_ld_p4 = f_ladder(li_L, l_L_ld_s1, l_L_ld_s2, l_L_ld_s3, l_L_ld_s4, l_L_ld_p0, l_L_ld_p1, l_L_ld_p2, l_L_ld_p3, l_L_ld_p4, l_ld_g, l_ld_k, l_ld_bc, l_ld_hs, 0);
			lb_L = lb_L + l_mld * (o12 + l_ti * (o24 - o12));
		}
		if (l_ast > 0.5) {
			o1, l_L_st_s1, l_L_st_s2, l_L_st_d1, l_L_st_d2, l_L_st_vb = f_steiner(li_L * (1 - l_chr) * 1, li_L * l_chr, li_L * (1 - l_chr) * 0, l_L_st_s1, l_L_st_s2, l_L_st_d1, l_L_st_d2, l_L_st_vb, l_st_g, l_st_K);
			lb_L = lb_L + l_mst * o1 * l_st_kd;
		}
		if (l_ase > 0.5) {
			o1, l_L_se_s1, l_L_se_s2, l_L_se_hq, l_L_se_bq = f_sem(li_L, l_L_se_s1, l_L_se_s2, l_L_se_hq, l_L_se_bq, l_se_g, l_se_R, l_chr, 0);
			lb_L = lb_L + l_mse * o1;
		}
		if (l_adi > 0.5) {
			o1, l_L_di_s1, l_L_di_s2, l_L_di_s3, l_L_di_s4, l_L_di_v1, l_L_di_v2, l_L_di_v3, l_L_di_v4, l_L_di_sf, l_L_di_sc = f_diode(li_L, l_L_di_s1, l_L_di_s2, l_L_di_s3, l_L_di_s4, l_L_di_v1, l_L_di_v2, l_L_di_v3, l_L_di_v4, l_L_di_sf, l_L_di_sc, l_di_g, l_di_k, l_di_Gf, l_cmp);
			lb_L = lb_L + l_mdi * o1;
		}
		e0 = lb_L;
		e1 = 0;
		e2 = 0;
		e3 = 0;
		if (l_xa > 0.5) {
			eh, eb, el, l_L_x0_s1, l_L_x0_s2 = f_svf(e0, l_L_x0_s1, l_L_x0_s2, l_gx, 0.7071067811865476);
			l_L_x0_s1 = fixdenorm(l_L_x0_s1);
			l_L_x0_s2 = fixdenorm(l_L_x0_s2);
			e1 = el;
		}
		if (l_xb > 0.5) {
			eh, eb, el, l_L_x1_s1, l_L_x1_s2 = f_svf(e1, l_L_x1_s1, l_L_x1_s2, l_gx, 0.7071067811865476);
			l_L_x1_s1 = fixdenorm(l_L_x1_s1);
			l_L_x1_s2 = fixdenorm(l_L_x1_s2);
			e2 = el;
		}
		if (l_xc > 0.5) {
			eh, eb, el, l_L_x2_s1, l_L_x2_s2 = f_svf(e2, l_L_x2_s1, l_L_x2_s2, l_gx, 0.7071067811865476);
			l_L_x2_s1 = fixdenorm(l_L_x2_s1);
			l_L_x2_s2 = fixdenorm(l_L_x2_s2);
			e3 = el;
		}
		wet_L = (l_w0 * e0 + l_w1 * e1 + l_w2 * e2 + l_w3 * e3) * l_osc;
		lyb_L = lsrc_L + l_wet * (wet_L - lsrc_L);
		li_R = lsrc_R * l_d;
		lb_R = 0;
		if (l_ash > 0.5) {
			o12, o24, l_R_sh_s1a, l_R_sh_s2a, l_R_sh_ba, l_R_sh_s1b, l_R_sh_s2b, l_R_sh_bb, l_R_sh_yp = f_sherman(li_R, l_R_sh_s1a, l_R_sh_s2a, l_R_sh_ba, l_R_sh_s1b, l_R_sh_s2b, l_R_sh_bb, l_R_sh_yp, l_sh_g, l_sh_R1, l_sh_R, l_sh_fb, l_ti, 0);
			lb_R = lb_R + l_msh * (o12 + l_ti * (o24 - o12));
		}
		if (l_ak3 > 0.5) {
			o1, l_R_k3_s1, l_R_k3_s2, l_R_k3_s3, l_R_k3_yp = f_k35lp(li_R, l_R_k3_s1, l_R_k3_s2, l_R_k3_s3, l_R_k3_yp, l_k3_g, l_k3_K, l_k3_L);
			lb_R = lb_R + l_mk3 * o1;
		}
		if (l_ald > 0.5) {
			o12, o24, l_R_ld_s1, l_R_ld_s2, l_R_ld_s3, l_R_ld_s4, l_R_ld_p0, l_R_ld_p1, l_R_ld_p2, l_R_ld_p3, l_R_ld_p4 = f_ladder(li_R, l_R_ld_s1, l_R_ld_s2, l_R_ld_s3, l_R_ld_s4, l_R_ld_p0, l_R_ld_p1, l_R_ld_p2, l_R_ld_p3, l_R_ld_p4, l_ld_g, l_ld_k, l_ld_bc, l_ld_hs, 0);
			lb_R = lb_R + l_mld * (o12 + l_ti * (o24 - o12));
		}
		if (l_ast > 0.5) {
			o1, l_R_st_s1, l_R_st_s2, l_R_st_d1, l_R_st_d2, l_R_st_vb = f_steiner(li_R * (1 - l_chr) * 1, li_R * l_chr, li_R * (1 - l_chr) * 0, l_R_st_s1, l_R_st_s2, l_R_st_d1, l_R_st_d2, l_R_st_vb, l_st_g, l_st_K);
			lb_R = lb_R + l_mst * o1 * l_st_kd;
		}
		if (l_ase > 0.5) {
			o1, l_R_se_s1, l_R_se_s2, l_R_se_hq, l_R_se_bq = f_sem(li_R, l_R_se_s1, l_R_se_s2, l_R_se_hq, l_R_se_bq, l_se_g, l_se_R, l_chr, 0);
			lb_R = lb_R + l_mse * o1;
		}
		if (l_adi > 0.5) {
			o1, l_R_di_s1, l_R_di_s2, l_R_di_s3, l_R_di_s4, l_R_di_v1, l_R_di_v2, l_R_di_v3, l_R_di_v4, l_R_di_sf, l_R_di_sc = f_diode(li_R, l_R_di_s1, l_R_di_s2, l_R_di_s3, l_R_di_s4, l_R_di_v1, l_R_di_v2, l_R_di_v3, l_R_di_v4, l_R_di_sf, l_R_di_sc, l_di_g, l_di_k, l_di_Gf, l_cmp);
			lb_R = lb_R + l_mdi * o1;
		}
		e0 = lb_R;
		e1 = 0;
		e2 = 0;
		e3 = 0;
		if (l_xa > 0.5) {
			eh, eb, el, l_R_x0_s1, l_R_x0_s2 = f_svf(e0, l_R_x0_s1, l_R_x0_s2, l_gx, 0.7071067811865476);
			l_R_x0_s1 = fixdenorm(l_R_x0_s1);
			l_R_x0_s2 = fixdenorm(l_R_x0_s2);
			e1 = el;
		}
		if (l_xb > 0.5) {
			eh, eb, el, l_R_x1_s1, l_R_x1_s2 = f_svf(e1, l_R_x1_s1, l_R_x1_s2, l_gx, 0.7071067811865476);
			l_R_x1_s1 = fixdenorm(l_R_x1_s1);
			l_R_x1_s2 = fixdenorm(l_R_x1_s2);
			e2 = el;
		}
		if (l_xc > 0.5) {
			eh, eb, el, l_R_x2_s1, l_R_x2_s2 = f_svf(e2, l_R_x2_s1, l_R_x2_s2, l_gx, 0.7071067811865476);
			l_R_x2_s1 = fixdenorm(l_R_x2_s1);
			l_R_x2_s2 = fixdenorm(l_R_x2_s2);
			e3 = el;
		}
		wet_R = (l_w0 * e0 + l_w1 * e1 + l_w2 * e2 + l_w3 * e3) * l_osc;
		lyb_R = lsrc_R + l_wet * (wet_R - lsrc_R);
	}
	zb_L = lyb_L;
	zb_R = lyb_R;
	if (cur_order < 0.5) {
		// ---- HPF stage, subsample b ----
		hyb_L = lyb_L;
		hyb_R = lyb_R;
		if (h_run > 0.5) {
			hi_L = lyb_L * h_d;
			hb_L = 0;
