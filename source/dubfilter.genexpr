				tua, dQ_T_L_upa0, dQ_T_L_upa1, dQ_T_L_upa2, dQ_T_L_upa3, dQ_T_L_upa4, dQ_T_L_upa5 = f_ap5(tu_L, dQ_T_L_upa0, dQ_T_L_upa1, dQ_T_L_upa2, dQ_T_L_upa3, dQ_T_L_upa4, dQ_T_L_upa5, 0.03597963117954574, 0.2707440780398313, 0.5579946172579126, 0.7750987153971112, 0.9169589388254247);
				tub, dQ_T_L_upb0, dQ_T_L_upb1, dQ_T_L_upb2, dQ_T_L_upb3, dQ_T_L_upb4, dQ_T_L_upb5 = f_ap5(tu_L, dQ_T_L_upb0, dQ_T_L_upb1, dQ_T_L_upb2, dQ_T_L_upb3, dQ_T_L_upb4, dQ_T_L_upb5, 0.13420095119429867, 0.41880485025469116, 0.677594451212584, 0.8531515291222292, 0.9728479509393618);
				tya = f_tube(tua * t_k, t_b, t_ib);
				tla, dQ_T_L_ton = f_op(tya, dQ_T_L_ton, t_Gt);
				tyb = f_tube(tub * t_k, t_b, t_ib);
				tlb, dQ_T_L_ton = f_op(tyb, dQ_T_L_ton, t_Gt);
				dQ_T_L_ton = fixdenorm(dQ_T_L_ton);
				tpa, dQ_T_L_dna0, dQ_T_L_dna1, dQ_T_L_dna2, dQ_T_L_dna3, dQ_T_L_dna4, dQ_T_L_dna5 = f_ap5(tlb, dQ_T_L_dna0, dQ_T_L_dna1, dQ_T_L_dna2, dQ_T_L_dna3, dQ_T_L_dna4, dQ_T_L_dna5, 0.03597963117954574, 0.2707440780398313, 0.5579946172579126, 0.7750987153971112, 0.9169589388254247);
				tpb, dQ_T_L_dnb0, dQ_T_L_dnb1, dQ_T_L_dnb2, dQ_T_L_dnb3, dQ_T_L_dnb4, dQ_T_L_dnb5 = f_ap5(tla, dQ_T_L_dnb0, dQ_T_L_dnb1, dQ_T_L_dnb2, dQ_T_L_dnb3, dQ_T_L_dnb4, dQ_T_L_dnb5, 0.13420095119429867, 0.41880485025469116, 0.677594451212584, 0.8531515291222292, 0.9728479509393618);
				ty = 0.5 * (tpa + tpb) * t_ko;
				tqa, dQ_T_L_dda0, dQ_T_L_dda1, dQ_T_L_dda2, dQ_T_L_dda3, dQ_T_L_dda4, dQ_T_L_dda5 = f_ap5(tub, dQ_T_L_dda0, dQ_T_L_dda1, dQ_T_L_dda2, dQ_T_L_dda3, dQ_T_L_dda4, dQ_T_L_dda5, 0.03597963117954574, 0.2707440780398313, 0.5579946172579126, 0.7750987153971112, 0.9169589388254247);
				tqb, dQ_T_L_ddb0, dQ_T_L_ddb1, dQ_T_L_ddb2, dQ_T_L_ddb3, dQ_T_L_ddb4, dQ_T_L_ddb5 = f_ap5(tua, dQ_T_L_ddb0, dQ_T_L_ddb1, dQ_T_L_ddb2, dQ_T_L_ddb3, dQ_T_L_ddb4, dQ_T_L_ddb5, 0.13420095119429867, 0.41880485025469116, 0.677594451212584, 0.8531515291222292, 0.9728479509393618);
				tdr = 0.5 * (tqa + tqb) / max(dz_t_gi, 1e-9);
				tdy = ty - dQ_T_L_dcx + t_dcr * dQ_T_L_dcy;
				dQ_T_L_dcx = ty;
				dQ_T_L_dcy = fixdenorm(tdy);
				tbl = tdr + dz_t_mx * (tdy * dz_t_go - tdr);
				q3_L = q2_L + dz_t_w * (tbl - q2_L);
				tu_R = q2_R * dz_t_gi;
				tua, dQ_T_R_upa0, dQ_T_R_upa1, dQ_T_R_upa2, dQ_T_R_upa3, dQ_T_R_upa4, dQ_T_R_upa5 = f_ap5(tu_R, dQ_T_R_upa0, dQ_T_R_upa1, dQ_T_R_upa2, dQ_T_R_upa3, dQ_T_R_upa4, dQ_T_R_upa5, 0.03597963117954574, 0.2707440780398313, 0.5579946172579126, 0.7750987153971112, 0.9169589388254247);
				tub, dQ_T_R_upb0, dQ_T_R_upb1, dQ_T_R_upb2, dQ_T_R_upb3, dQ_T_R_upb4, dQ_T_R_upb5 = f_ap5(tu_R, dQ_T_R_upb0, dQ_T_R_upb1, dQ_T_R_upb2, dQ_T_R_upb3, dQ_T_R_upb4, dQ_T_R_upb5, 0.13420095119429867, 0.41880485025469116, 0.677594451212584, 0.8531515291222292, 0.9728479509393618);
				tya = f_tube(tua * t_k, t_b, t_ib);
				tla, dQ_T_R_ton = f_op(tya, dQ_T_R_ton, t_Gt);
				tyb = f_tube(tub * t_k, t_b, t_ib);
				tlb, dQ_T_R_ton = f_op(tyb, dQ_T_R_ton, t_Gt);
				dQ_T_R_ton = fixdenorm(dQ_T_R_ton);
				tpa, dQ_T_R_dna0, dQ_T_R_dna1, dQ_T_R_dna2, dQ_T_R_dna3, dQ_T_R_dna4, dQ_T_R_dna5 = f_ap5(tlb, dQ_T_R_dna0, dQ_T_R_dna1, dQ_T_R_dna2, dQ_T_R_dna3, dQ_T_R_dna4, dQ_T_R_dna5, 0.03597963117954574, 0.2707440780398313, 0.5579946172579126, 0.7750987153971112, 0.9169589388254247);
				tpb, dQ_T_R_dnb0, dQ_T_R_dnb1, dQ_T_R_dnb2, dQ_T_R_dnb3, dQ_T_R_dnb4, dQ_T_R_dnb5 = f_ap5(tla, dQ_T_R_dnb0, dQ_T_R_dnb1, dQ_T_R_dnb2, dQ_T_R_dnb3, dQ_T_R_dnb4, dQ_T_R_dnb5, 0.13420095119429867, 0.41880485025469116, 0.677594451212584, 0.8531515291222292, 0.9728479509393618);
				ty = 0.5 * (tpa + tpb) * t_ko;
				tqa, dQ_T_R_dda0, dQ_T_R_dda1, dQ_T_R_dda2, dQ_T_R_dda3, dQ_T_R_dda4, dQ_T_R_dda5 = f_ap5(tub, dQ_T_R_dda0, dQ_T_R_dda1, dQ_T_R_dda2, dQ_T_R_dda3, dQ_T_R_dda4, dQ_T_R_dda5, 0.03597963117954574, 0.2707440780398313, 0.5579946172579126, 0.7750987153971112, 0.9169589388254247);
				tqb, dQ_T_R_ddb0, dQ_T_R_ddb1, dQ_T_R_ddb2, dQ_T_R_ddb3, dQ_T_R_ddb4, dQ_T_R_ddb5 = f_ap5(tua, dQ_T_R_ddb0, dQ_T_R_ddb1, dQ_T_R_ddb2, dQ_T_R_ddb3, dQ_T_R_ddb4, dQ_T_R_ddb5, 0.13420095119429867, 0.41880485025469116, 0.677594451212584, 0.8531515291222292, 0.9728479509393618);
				tdr = 0.5 * (tqa + tqb) / max(dz_t_gi, 1e-9);
				tdy = ty - dQ_T_R_dcx + t_dcr * dQ_T_R_dcy;
				dQ_T_R_dcx = ty;
				dQ_T_R_dcy = fixdenorm(tdy);
				tbl = tdr + dz_t_mx * (tdy * dz_t_go - tdr);
				q3_R = q2_R + dz_t_w * (tbl - q2_R);
				mQ_tin = max(abs(tu_L), abs(tu_R));
				mQ_tout = max(abs(q3_L), abs(q3_R));
			}
		}
		if (dQ_m2 == 1) {
			if (dz_o_w > 0) {
				ou_L = q2_L * dz_o_gi;
				osc_L = (o_src < 0.5 ? dQ_O_L_yp : (o_src < 1.5 ? cin_L : key_L));
				ohl, dQ_O_L_hp = f_op(osc_L, dQ_O_L_hp, o_Ghp);
				osc_L = osc_L - ohl;
				oel, dQ_O_L_he = f_op(osc_L, dQ_O_L_he, o_Ge);
				osc_L = osc_L + 3 * dz_o_emz * (osc_L - oel);
				dQ_O_L_hp = fixdenorm(dQ_O_L_hp);
				dQ_O_L_he = fixdenorm(dQ_O_L_he);
				olv_L = abs(osc_L);
				ou_R = q2_R * dz_o_gi;
				osc_R = (o_src < 0.5 ? dQ_O_R_yp : (o_src < 1.5 ? cin_R : key_R));
				ohl, dQ_O_R_hp = f_op(osc_R, dQ_O_R_hp, o_Ghp);
				osc_R = osc_R - ohl;
				oel, dQ_O_R_he = f_op(osc_R, dQ_O_R_he, o_Ge);
				osc_R = osc_R + 3 * dz_o_emz * (osc_R - oel);
				dQ_O_R_hp = fixdenorm(dQ_O_R_hp);
				dQ_O_R_he = fixdenorm(dQ_O_R_he);
				olv_R = abs(osc_R);
				olm = max(olv_L, olv_R);
				ogr = 0;
				oe = o_prg * (olv_L + dz_o_lkz * (olm - olv_L));
				dQ_O_L_lt = fixdenorm(dQ_O_L_lt + (oe - dQ_O_L_lt) * (oe > dQ_O_L_lt ? o_aela : o_ael));
				dQ_O_L_cf = fixdenorm(dQ_O_L_cf + (dQ_O_L_lt - dQ_O_L_cf) * (dQ_O_L_lt > dQ_O_L_cf ? o_aatt : o_afr));
				dQ_O_L_mem = fixdenorm(dQ_O_L_mem + (dQ_O_L_lt - dQ_O_L_mem) * (dQ_O_L_lt > dQ_O_L_mem ? o_amu : o_amd));
				oasr = 1 - exp(-1 / ((0.5 + 4.5 * clamp(dQ_O_L_mem, 0, 1)) * fs));
				dQ_O_L_cs = fixdenorm(dQ_O_L_cs + (dQ_O_L_lt - dQ_O_L_cs) * (dQ_O_L_lt > dQ_O_L_cs ? o_asa : oasr));
				oc = o_K * (0.6 * dQ_O_L_cf + 0.4 * dQ_O_L_cs);
				oG = 1 / (1 + pow(oc, o_p));
				oy = ou_L * oG;
				dQ_O_L_yp = oy;
				ogr = max(ogr, -20 * log10(oG));
				q3_L = q2_L + dz_o_w * dz_o_mx * (oy * dz_o_go - q2_L);
				mQ_osc_L = osc_L;
				oe = o_prg * (olv_R + dz_o_lkz * (olm - olv_R));
				dQ_O_R_lt = fixdenorm(dQ_O_R_lt + (oe - dQ_O_R_lt) * (oe > dQ_O_R_lt ? o_aela : o_ael));
				dQ_O_R_cf = fixdenorm(dQ_O_R_cf + (dQ_O_R_lt - dQ_O_R_cf) * (dQ_O_R_lt > dQ_O_R_cf ? o_aatt : o_afr));
				dQ_O_R_mem = fixdenorm(dQ_O_R_mem + (dQ_O_R_lt - dQ_O_R_mem) * (dQ_O_R_lt > dQ_O_R_mem ? o_amu : o_amd));
				oasr = 1 - exp(-1 / ((0.5 + 4.5 * clamp(dQ_O_R_mem, 0, 1)) * fs));
				dQ_O_R_cs = fixdenorm(dQ_O_R_cs + (dQ_O_R_lt - dQ_O_R_cs) * (dQ_O_R_lt > dQ_O_R_cs ? o_asa : oasr));
				oc = o_K * (0.6 * dQ_O_R_cf + 0.4 * dQ_O_R_cs);
				oG = 1 / (1 + pow(oc, o_p));
				oy = ou_R * oG;
				dQ_O_R_yp = oy;
				ogr = max(ogr, -20 * log10(oG));
				q3_R = q2_R + dz_o_w * dz_o_mx * (oy * dz_o_go - q2_R);
				mQ_osc_R = osc_R;
				mQ_oin = max(abs(ou_L), abs(ou_R));
				mQ_oout = max(abs(q3_L), abs(q3_R));
				mQ_ogr = ogr;
			}
		}
		if (dQ_m2 == 2) {
			if (dz_v_w > 0) {
				vu_L = q2_L * dz_v_gi;
				vs = (v_src < 0.5 ? (v_type > 0.5 ? dQ_V_L_yp : vu_L) : (v_src < 1.5 ? cin_L : key_L));
				vhl, dQ_V_L_hp = f_op(vs, dQ_V_L_hp, v_Ghp);
				vs = vs - vhl;
				v1l, dQ_V_L_t1 = f_op(vs, dQ_V_L_t1, v_G1);
				v2l, dQ_V_L_t2 = f_op(vs, dQ_V_L_t2, v_G2);
				dQ_V_L_hp = fixdenorm(dQ_V_L_hp);
				dQ_V_L_t1 = fixdenorm(dQ_V_L_t1);
				dQ_V_L_t2 = fixdenorm(dQ_V_L_t2);
				vst_L = v_thrust < 0.5 ? vs : (v_thrust < 1.5 ? 0.5 * vs + 0.5 * (vs - v1l) : 0.25 * vs + 0.75 * (vs - v1l) + 0.5 * (vs - v2l));
				dQ_V_L_ms = fixdenorm(dQ_V_L_ms + (vst_L * vst_L - dQ_V_L_ms) * v_arms);
				vlv_L = 10 * log10(dQ_V_L_ms + 1e-20) + 3.0103;
				vu_R = q2_R * dz_v_gi;
				vs = (v_src < 0.5 ? (v_type > 0.5 ? dQ_V_R_yp : vu_R) : (v_src < 1.5 ? cin_R : key_R));
				vhl, dQ_V_R_hp = f_op(vs, dQ_V_R_hp, v_Ghp);
				vs = vs - vhl;
				v1l, dQ_V_R_t1 = f_op(vs, dQ_V_R_t1, v_G1);
				v2l, dQ_V_R_t2 = f_op(vs, dQ_V_R_t2, v_G2);
				dQ_V_R_hp = fixdenorm(dQ_V_R_hp);
				dQ_V_R_t1 = fixdenorm(dQ_V_R_t1);
				dQ_V_R_t2 = fixdenorm(dQ_V_R_t2);
				vst_R = v_thrust < 0.5 ? vs : (v_thrust < 1.5 ? 0.5 * vs + 0.5 * (vs - v1l) : 0.25 * vs + 0.75 * (vs - v1l) + 0.5 * (vs - v2l));
				dQ_V_R_ms = fixdenorm(dQ_V_R_ms + (vst_R * vst_R - dQ_V_R_ms) * v_arms);
				vlv_R = 10 * log10(dQ_V_R_ms + 1e-20) + 3.0103;
				vlk = 10 * log10(0.5 * (dQ_V_L_ms + dQ_V_R_ms) + 1e-20) + 3.0103;
				vgr = 0;
				vlv = vlv_L + dz_v_lkz * (vlk - vlv_L);
				vgc = f_gc(vlv, dz_v_thz, v_slope, v_W);
				dQ_V_L_gr = fixdenorm(dQ_V_L_gr + (vgc - dQ_V_L_gr) * (vgc < dQ_V_L_gr ? v_aat : v_are));
				vy = vu_L * exp(0.11512925465 * dQ_V_L_gr);
				dQ_V_L_yp = vy;
				vgr = max(vgr, -dQ_V_L_gr);
				q3_L = q2_L + dz_v_w * dz_v_mx * (vy * v_mk * dz_v_go - q2_L);
				mQ_vsc_L = vst_L;
				vlv = vlv_R + dz_v_lkz * (vlk - vlv_R);
				vgc = f_gc(vlv, dz_v_thz, v_slope, v_W);
				dQ_V_R_gr = fixdenorm(dQ_V_R_gr + (vgc - dQ_V_R_gr) * (vgc < dQ_V_R_gr ? v_aat : v_are));
				vy = vu_R * exp(0.11512925465 * dQ_V_R_gr);
				dQ_V_R_yp = vy;
				vgr = max(vgr, -dQ_V_R_gr);
				q3_R = q2_R + dz_v_w * dz_v_mx * (vy * v_mk * dz_v_go - q2_R);
				mQ_vsc_R = vst_R;
				mQ_vin = max(abs(vu_L), abs(vu_R));
				mQ_vout = max(abs(q3_L), abs(q3_R));
				mQ_vgr = vgr;
			}
		}
		dout_L = dout_L + d_wQ * q3_L;
		dout_R = dout_R + d_wQ * q3_R;
	}
	dm_tin = dz_d_act < 0.5 ? mP_tin : mQ_tin;
	dm_tout = dz_d_act < 0.5 ? mP_tout : mQ_tout;
	dm_oin = dz_d_act < 0.5 ? mP_oin : mQ_oin;
	dm_oout = dz_d_act < 0.5 ? mP_oout : mQ_oout;
	dm_ogr = dz_d_act < 0.5 ? mP_ogr : mQ_ogr;
	dm_vin = dz_d_act < 0.5 ? mP_vin : mQ_vin;
	dm_vout = dz_d_act < 0.5 ? mP_vout : mQ_vout;
	dm_vgr = dz_d_act < 0.5 ? mP_vgr : mQ_vgr;
	dm_osc_L = dz_d_act < 0.5 ? mP_osc_L : mQ_osc_L;
	dm_osc_R = dz_d_act < 0.5 ? mP_osc_R : mQ_osc_R;
	dm_vsc_L = dz_d_act < 0.5 ? mP_vsc_L : mQ_vsc_L;
	dm_vsc_R = dz_d_act < 0.5 ? mP_vsc_R : mQ_vsc_R;
	y_L = dout_L;
	y_R = dout_R;
	dm_cout = max(abs(y_L), abs(y_R));
}
gk_L = 0;
gk_R = 0;
if (dz_g_w > 0) {
	gk_L = (g_src < 0.5 ? y_L : (g_src < 1.5 ? cin_L : key_L));
	ghl, dg_hpL = f_op(gk_L, dg_hpL, g_Ghp);
	gk_L = gk_L - ghl;
	gk_L, dg_lpL = f_op(gk_L, dg_lpL, g_Glp);
	dg_hpL = fixdenorm(dg_hpL);
	dg_lpL = fixdenorm(dg_lpL);
	gk_R = (g_src < 0.5 ? y_R : (g_src < 1.5 ? cin_R : key_R));
	ghl, dg_hpR = f_op(gk_R, dg_hpR, g_Ghp);
	gk_R = gk_R - ghl;
	gk_R, dg_lpR = f_op(gk_R, dg_lpR, g_Glp);
	dg_hpR = fixdenorm(dg_hpR);
	dg_lpR = fixdenorm(dg_lpR);
	gkm = max(abs(gk_L), abs(gk_R));
	dg_env = fixdenorm(gkm > dg_env ? gkm : dg_env * g_dec);
	gdb = 20 * log10(dg_env + 1e-9);
	if (gdb > g_thr) {
		dg_open = 1;
		dg_hold = g_hs;
	} else if (gdb < g_thr - 4) {
		if (dg_hold > 0) {
			dg_hold = dg_hold - 1;
		} else {
			dg_open = 0;
		}
	}
	gtd = dg_open > 0.5 ? 0 : -g_rdb;
	dg_g = gtd > dg_g ? min(gtd, dg_g + g_sat) : max(gtd, dg_g - g_sre);
	gg = dg_open > 0.5 || dg_g > -g_rdb + 0.001 ? exp(0.11512925465 * dg_g) : g_floor;
	y_L = y_L + dz_g_w * (y_L * gg - y_L);
	y_R = y_R + dz_g_w * (y_R * gg - y_R);
	dm_g = gg;
}
if (dz_kl_w > 0) {
	kls = dz_kl_sel < 1.5 ? dm_osc_L : (dz_kl_sel < 2.5 ? dm_vsc_L : gk_L);
	y_L = y_L + dz_kl_w * (kls - y_L);
	kls = dz_kl_sel < 1.5 ? dm_osc_R : (dz_kl_sel < 2.5 ? dm_vsc_R : gk_R);
	y_R = y_R + dz_kl_w * (kls - y_R);
}

// ---- DC blocker (1st order, 2 Hz), output gain, soft clip, duck ----
dcr = 1 - 2 * pi * 2 / fs;
og = H_og + a_par * (exp(0.11512925465 * clamp(out_db, -24, 12)) - H_og);
dy_L = y_L - dc_L_x + dcr * dc_L_y;
dc_L_x = y_L;
dc_L_y = fixdenorm(dy_L);
q_L = dy_L * og;
if (softclip > 0.5) {
	aq = abs(q_L);
	if (aq > 0.7) {
		q_L = (q_L > 0 ? 1 : -1) * (0.7 + 0.3 * tanh((aq - 0.7) / 0.3));
	}
}
q_L = q_L * duck;
q_L = q_L == q_L ? q_L : 0;
dy_R = y_R - dc_R_x + dcr * dc_R_y;
dc_R_x = y_R;
dc_R_y = fixdenorm(dy_R);
q_R = dy_R * og;
if (softclip > 0.5) {
	aq = abs(q_R);
	if (aq > 0.7) {
		q_R = (q_R > 0 ? 1 : -1) * (0.7 + 0.3 * tanh((aq - 0.7) / 0.3));
	}
}
q_R = q_R * duck;
q_R = q_R == q_R ? q_R : 0;
out1 = q_L;
out2 = q_R;
out3 = dm_tin;
out4 = dm_tout;
out5 = dm_oin;
out6 = dm_oout;
out7 = dm_ogr * 0.0333333;
