	h_L_x2_s1 = 0;
	h_L_x2_s2 = 0;
	h_R_x2_s1 = 0;
	h_R_x2_s2 = 0;
}

// ================= BPF controls (v1.2) =================
b_lc = H_b_lc + a_cut * (log2(clamp(b_freq, 30, 12000)) - H_b_lc);
b_bwz = H_b_bwz + a_par * (clamp(b_bw, 0.2, 6) - H_b_bwz);
b_lq = H_b_lq + a_par * (log2(clamp(b_q, 0.5, 10)) - H_b_lq);
b_rz = H_b_rz + a_par * (clamp(b_res, 0, 100) * 0.01 - H_b_rz);
b_drv = H_b_drv + a_par * (clamp(b_drive, 0, 100) * 0.01 - H_b_drv);
b_cmp = H_b_cmp + a_par * (clamp(b_comp, 0, 100) * 0.01 - H_b_cmp);
b_mxt = clamp(b_mix, 0, 100) * 0.01;
b_mx = H_b_mx + a_mix * (b_mxt - H_b_mx);
if (abs(b_mx - b_mxt) < 0.0001 && (b_mxt < 0.0001 || b_mxt > 0.9999)) {
	b_mx = b_mxt;
}
b_ent = b_on > 0.5 ? 1 : 0;
b_en = H_b_en + a_mix * (b_ent - H_b_en);
if (b_ent < 0.5 && b_en < 0.0001) {
	b_en = 0;
}
if (b_ent > 0.5 && b_en > 0.9999) {
	b_en = 1;
}
b_wet = b_en * b_mx;
b_run = b_en > 0 ? 1 : 0;
b_fc = min(exp2(b_lc), 0.45 * fso);
b_qq = exp2(b_lq);
b_d = 0.25 * exp2(5 * b_drv);
b_osc = (1 / b_d) * exp2(5 * b_drv * (1 - 0.5 * b_cmp));
b_cfg = clamp(floor(b_model + 0.5), 0, 4) * 3 + clamp(floor(b_arch + 0.5), 0, 2);
b_ca = H_b_ca;
b_cb = H_b_cb;
b_act = H_b_act;
b_fade = H_b_fade;
b_ccur = b_act < 0.5 ? b_ca : b_cb;
b_newA = 0;
b_newB = 0;
if (b_cfg != b_ccur) {
	if (b_act < 0.5) {
		b_cb = b_cfg;
		b_act = 1;
		b_newB = 1;
	} else {
		b_ca = b_cfg;
		b_act = 0;
		b_newA = 1;
	}
	b_fade = 0;
}
b_fade = min(1, b_fade + fstep);
b_wA = b_act < 0.5 ? b_fade : 1 - b_fade;
b_wB = 1 - b_wA;
// slot A: per-slot coefficients
bA_run = (b_run > 0.5 && b_wA > 0) ? 1 : 0;
bA_m = floor(b_ca / 3 + 0.001);
bA_a = b_ca - 3 * bA_m;
bA_typ = (bA_m < 0.5 ? 0.0 : (bA_m < 1.5 ? 0.0 : (bA_m < 2.5 ? 0.0 : (bA_m < 3.5 ? 1.0 : 0.0))));
bA_sc = (bA_m < 0.5 ? 0.6 : (bA_m < 1.5 ? 0.7 : (bA_m < 2.5 ? 1.0 : (bA_m < 3.5 ? 1.4 : 0.5))));
bA_rg = (bA_m < 0.5 ? 0.0 : (bA_m < 1.5 ? 1.0 : (bA_m < 2.5 ? 0.0 : (bA_m < 3.5 ? 0.0 : 0.0))));
bA_r = (bA_m < 0.5 ? 0.9 : (bA_m < 1.5 ? 1.06 : (bA_m < 2.5 ? 1.06 : (bA_m < 3.5 ? 1.06 : 1.06)))) * pow(b_rz, 1.3);
bA_k = (bA_m < 0.5 ? 3.6 : (bA_m < 1.5 ? 4.3 : (bA_m < 2.5 ? 4.3 : (bA_m < 3.5 ? 4.3 : 4.3)))) * pow(b_rz, 1.3);
bA_roll = (bA_m < 0.5 ? 0.0 : (bA_m < 1.5 ? 0.0 : (bA_m < 2.5 ? 0.0 : (bA_m < 3.5 ? 1.0 : 0.0))));
bA_gc = tan(pi * b_fc / fso);
bA_R = 0.5 / b_qq;
bA_fh = clamp(b_fc * exp2(-0.5 * b_bwz), 10, 0.45 * fso);
bA_fl = clamp(b_fc * exp2(0.5 * b_bwz), 10, 0.45 * fso);
bA_gh = tan(pi * bA_fh / fso);
bA_gl = tan(pi * bA_fl / fso);
bA_cn = 1 / (f_bmag(bA_gc / bA_gh, b_qq, 1) * f_bmag(bA_gc / bA_gl, b_qq, 0));
bA_wb = clamp((b_bwz - 1) * 0.5, 0, 1);
bA_kk = min(bA_k, 4.3);
bA_cmm = ((((0.000804 * bA_kk - 0.009901) * bA_kk + 0.039923) * bA_kk - 0.03441) * bA_kk - 0.07288) * bA_kk + 0.998285;
bA_gm = bA_gc / bA_cmm;
bA_raw = bA_a < 0.5 ? b_qq : (bA_a < 1.5 ? 1 / bA_cn : 1);
bA_ocmp = pow(bA_raw, 1 - b_cmp);
bA_gro = tan(pi * min(14000, 0.45 * fso) / fso);
bA_Gro = bA_gro / (1 + bA_gro);
if (bA_run < 0.5 || b_newA > 0.5) {
	bA_L_yp = 0;
	bA_L_ro = 0;
	bA_L_v_s1 = 0;
	bA_L_v_s2 = 0;
	bA_L_v_hq = 0;
	bA_L_v_bq = 0;
	bA_L_c_s1 = 0;
	bA_L_c_s2 = 0;
	bA_L_c_hq = 0;
	bA_L_c_bq = 0;
	bA_L_c_t1 = 0;
	bA_L_c_t2 = 0;
	bA_L_c_tq = 0;
	bA_L_c_tb = 0;
	bA_L_m_s1 = 0;
	bA_L_m_s2 = 0;
	bA_L_m_s3 = 0;
	bA_L_m_s4 = 0;
	bA_L_m_p0 = 0;
	bA_L_m_p1 = 0;
	bA_L_m_p2 = 0;
	bA_L_m_p3 = 0;
	bA_L_m_p4 = 0;
	bA_R_yp = 0;
	bA_R_ro = 0;
	bA_R_v_s1 = 0;
	bA_R_v_s2 = 0;
	bA_R_v_hq = 0;
	bA_R_v_bq = 0;
	bA_R_c_s1 = 0;
	bA_R_c_s2 = 0;
	bA_R_c_hq = 0;
	bA_R_c_bq = 0;
	bA_R_c_t1 = 0;
	bA_R_c_t2 = 0;
	bA_R_c_tq = 0;
	bA_R_c_tb = 0;
	bA_R_m_s1 = 0;
	bA_R_m_s2 = 0;
	bA_R_m_s3 = 0;
	bA_R_m_s4 = 0;
	bA_R_m_p0 = 0;
	bA_R_m_p1 = 0;
	bA_R_m_p2 = 0;
	bA_R_m_p3 = 0;
	bA_R_m_p4 = 0;
}
// slot B: per-slot coefficients
bB_run = (b_run > 0.5 && b_wB > 0) ? 1 : 0;
bB_m = floor(b_cb / 3 + 0.001);
bB_a = b_cb - 3 * bB_m;
bB_typ = (bB_m < 0.5 ? 0.0 : (bB_m < 1.5 ? 0.0 : (bB_m < 2.5 ? 0.0 : (bB_m < 3.5 ? 1.0 : 0.0))));
bB_sc = (bB_m < 0.5 ? 0.6 : (bB_m < 1.5 ? 0.7 : (bB_m < 2.5 ? 1.0 : (bB_m < 3.5 ? 1.4 : 0.5))));
bB_rg = (bB_m < 0.5 ? 0.0 : (bB_m < 1.5 ? 1.0 : (bB_m < 2.5 ? 0.0 : (bB_m < 3.5 ? 0.0 : 0.0))));
bB_r = (bB_m < 0.5 ? 0.9 : (bB_m < 1.5 ? 1.06 : (bB_m < 2.5 ? 1.06 : (bB_m < 3.5 ? 1.06 : 1.06)))) * pow(b_rz, 1.3);
bB_k = (bB_m < 0.5 ? 3.6 : (bB_m < 1.5 ? 4.3 : (bB_m < 2.5 ? 4.3 : (bB_m < 3.5 ? 4.3 : 4.3)))) * pow(b_rz, 1.3);
bB_roll = (bB_m < 0.5 ? 0.0 : (bB_m < 1.5 ? 0.0 : (bB_m < 2.5 ? 0.0 : (bB_m < 3.5 ? 1.0 : 0.0))));
bB_gc = tan(pi * b_fc / fso);
bB_R = 0.5 / b_qq;
bB_fh = clamp(b_fc * exp2(-0.5 * b_bwz), 10, 0.45 * fso);
bB_fl = clamp(b_fc * exp2(0.5 * b_bwz), 10, 0.45 * fso);
bB_gh = tan(pi * bB_fh / fso);
bB_gl = tan(pi * bB_fl / fso);
bB_cn = 1 / (f_bmag(bB_gc / bB_gh, b_qq, 1) * f_bmag(bB_gc / bB_gl, b_qq, 0));
bB_wb = clamp((b_bwz - 1) * 0.5, 0, 1);
bB_kk = min(bB_k, 4.3);
bB_cmm = ((((0.000804 * bB_kk - 0.009901) * bB_kk + 0.039923) * bB_kk - 0.03441) * bB_kk - 0.07288) * bB_kk + 0.998285;
bB_gm = bB_gc / bB_cmm;
bB_raw = bB_a < 0.5 ? b_qq : (bB_a < 1.5 ? 1 / bB_cn : 1);
bB_ocmp = pow(bB_raw, 1 - b_cmp);
bB_gro = tan(pi * min(14000, 0.45 * fso) / fso);
bB_Gro = bB_gro / (1 + bB_gro);
if (bB_run < 0.5 || b_newB > 0.5) {
	bB_L_yp = 0;
	bB_L_ro = 0;
	bB_L_v_s1 = 0;
	bB_L_v_s2 = 0;
	bB_L_v_hq = 0;
	bB_L_v_bq = 0;
	bB_L_c_s1 = 0;
	bB_L_c_s2 = 0;
	bB_L_c_hq = 0;
	bB_L_c_bq = 0;
	bB_L_c_t1 = 0;
	bB_L_c_t2 = 0;
	bB_L_c_tq = 0;
	bB_L_c_tb = 0;
	bB_L_m_s1 = 0;
	bB_L_m_s2 = 0;
	bB_L_m_s3 = 0;
	bB_L_m_s4 = 0;
	bB_L_m_p0 = 0;
	bB_L_m_p1 = 0;
	bB_L_m_p2 = 0;
	bB_L_m_p3 = 0;
	bB_L_m_p4 = 0;
	bB_R_yp = 0;
	bB_R_ro = 0;
	bB_R_v_s1 = 0;
	bB_R_v_s2 = 0;
	bB_R_v_hq = 0;
	bB_R_v_bq = 0;
	bB_R_c_s1 = 0;
	bB_R_c_s2 = 0;
	bB_R_c_hq = 0;
	bB_R_c_bq = 0;
	bB_R_c_t1 = 0;
	bB_R_c_t2 = 0;
	bB_R_c_tq = 0;
	bB_R_c_tb = 0;
	bB_R_m_s1 = 0;
	bB_R_m_s2 = 0;
	bB_R_m_s3 = 0;
	bB_R_m_s4 = 0;
	bB_R_m_p0 = 0;
	bB_R_m_p1 = 0;
	bB_R_m_p2 = 0;
	bB_R_m_p3 = 0;
	bB_R_m_p4 = 0;
}

// ================= order / oversampling switching (duck) =================
cfg_o = order_sel > 0.5 ? 1 : 0;
cfg_s = ovs_sel > 0.5 ? 1 : 0;
cfg_p = b_pos > 0.5 ? 1 : 0;
b_cur_pos = H_b_cur_pos;
pend = (cfg_o != cur_order || cfg_s != cur_os || cfg_p != b_cur_pos) ? 1 : 0;
duck = H_duck;
duck = pend > 0.5 ? max(0, duck - dstep) : min(1, duck + dstep);
new_order = cur_order;
new_os = cur_os;
new_pos = b_cur_pos;
rst = 0;
if (pend > 0.5 && duck <= 0) {
	new_order = cfg_o;
	new_os = cfg_s;
	new_pos = cfg_p;
	rst = cfg_s != cur_os ? 1 : 0;
}

// ================= input (2x upsampler when oversampling) =================
xa_L = x_L;
xb_L = 0;
xa_R = x_R;
xb_R = 0;
if (ovs > 1.5) {
	xa_L, os_L_upa0, os_L_upa1, os_L_upa2, os_L_upa3, os_L_upa4, os_L_upa5 = f_ap5(x_L, os_L_upa0, os_L_upa1, os_L_upa2, os_L_upa3, os_L_upa4, os_L_upa5, 0.035979631179546, 0.270744078039831, 0.557994617257913, 0.775098715397111, 0.916958938825425);
	xb_L, os_L_upb0, os_L_upb1, os_L_upb2, os_L_upb3, os_L_upb4, os_L_upb5 = f_ap5(x_L, os_L_upb0, os_L_upb1, os_L_upb2, os_L_upb3, os_L_upb4, os_L_upb5, 0.134200951194299, 0.418804850254691, 0.677594451212584, 0.853151529122229, 0.972847950939362);
	xa_R, os_R_upa0, os_R_upa1, os_R_upa2, os_R_upa3, os_R_upa4, os_R_upa5 = f_ap5(x_R, os_R_upa0, os_R_upa1, os_R_upa2, os_R_upa3, os_R_upa4, os_R_upa5, 0.035979631179546, 0.270744078039831, 0.557994617257913, 0.775098715397111, 0.916958938825425);
	xb_R, os_R_upb0, os_R_upb1, os_R_upb2, os_R_upb3, os_R_upb4, os_R_upb5 = f_ap5(x_R, os_R_upb0, os_R_upb1, os_R_upb2, os_R_upb3, os_R_upb4, os_R_upb5, 0.134200951194299, 0.418804850254691, 0.677594451212584, 0.853151529122229, 0.972847950939362);
}

zb_L = 0;
zb_R = 0;
// ================= processing chain, subsample a =================
if (b_cur_pos > 0.5) {
	if (b_run > 0.5) {
		bo_L = 0;
		if (bA_run > 0.5) {
			bx = xa_L * b_d;
			by = 0;
			bt = f_bsat(bA_L_yp * 3.3333333333, bA_rg);
			if (bA_a < 0.5) {
				ah, bh, ab, bb, al, bl = f_bsva(bA_L_v_s1, bA_L_v_s2, bA_L_v_hq, bA_L_v_bq, bA_gc, bA_R, bA_sc);
				nA = 2 * bA_R * ab;
				nB = 2 * bA_R * bb;
				bu = (bx + bA_r * bt * nB) / (1 - bA_r * bt * nA);
				hh, b1, l1, bA_L_v_s1, bA_L_v_s2 = f_bsvs(bu, bA_L_v_s1, bA_L_v_s2, bA_L_v_hq, bA_L_v_bq, bA_gc, bA_R, bA_sc);
				bA_L_v_hq = hh;
				bA_L_v_bq = b1;
				by = 2 * bA_R * b1;
			}
			if (bA_a > 0.5 && bA_a < 1.5) {
				ah, bh, ab, bb, al, bl = f_bsva(bA_L_c_s1, bA_L_c_s2, bA_L_c_hq, bA_L_c_bq, bA_gh, bA_R, bA_sc);
				ah2, bh2, ab2, bb2, al2, bl2 = f_bsva(bA_L_c_t1, bA_L_c_t2, bA_L_c_tq, bA_L_c_tb, bA_gl, bA_R, bA_sc);
				nA = bA_cn * al2 * ah;
				nB = bA_cn * (al2 * bh + bl2);
				bu = (bx + bA_r * bt * nB) / (1 - bA_r * bt * nA);
				hh, b1, l1, bA_L_c_s1, bA_L_c_s2 = f_bsvs(bu, bA_L_c_s1, bA_L_c_s2, bA_L_c_hq, bA_L_c_bq, bA_gh, bA_R, bA_sc);
				bA_L_c_hq = hh;
				bA_L_c_bq = b1;
				hh2, b2, l2, bA_L_c_t1, bA_L_c_t2 = f_bsvs(hh, bA_L_c_t1, bA_L_c_t2, bA_L_c_tq, bA_L_c_tb, bA_gl, bA_R, bA_sc);
				bA_L_c_tq = hh2;
				bA_L_c_tb = b2;
				by = bA_cn * l2;
			}
			if (bA_a > 1.5) {
				by, bA_L_m_s1, bA_L_m_s2, bA_L_m_s3, bA_L_m_s4, bA_L_m_p0, bA_L_m_p1, bA_L_m_p2, bA_L_m_p3, bA_L_m_p4 = f_bmm(bx, bA_L_m_s1, bA_L_m_s2, bA_L_m_s3, bA_L_m_s4, bA_L_m_p0, bA_L_m_p1, bA_L_m_p2, bA_L_m_p3, bA_L_m_p4, bA_gm, bA_k, bA_typ, bA_sc, bA_wb);
			}
			bA_L_yp = by;
			if (bA_roll > 0.5) {
				by, bA_L_ro = f_op(by, bA_L_ro, bA_Gro);
				bA_L_ro = fixdenorm(bA_L_ro);
			}
			bo_L = bo_L + b_wA * by * bA_ocmp * b_osc;
		}
		if (bB_run > 0.5) {
			bx = xa_L * b_d;
			by = 0;
			bt = f_bsat(bB_L_yp * 3.3333333333, bB_rg);
			if (bB_a < 0.5) {
				ah, bh, ab, bb, al, bl = f_bsva(bB_L_v_s1, bB_L_v_s2, bB_L_v_hq, bB_L_v_bq, bB_gc, bB_R, bB_sc);
				nA = 2 * bB_R * ab;
				nB = 2 * bB_R * bb;
				bu = (bx + bB_r * bt * nB) / (1 - bB_r * bt * nA);
				hh, b1, l1, bB_L_v_s1, bB_L_v_s2 = f_bsvs(bu, bB_L_v_s1, bB_L_v_s2, bB_L_v_hq, bB_L_v_bq, bB_gc, bB_R, bB_sc);
				bB_L_v_hq = hh;
				bB_L_v_bq = b1;
				by = 2 * bB_R * b1;
			}
			if (bB_a > 0.5 && bB_a < 1.5) {
				ah, bh, ab, bb, al, bl = f_bsva(bB_L_c_s1, bB_L_c_s2, bB_L_c_hq, bB_L_c_bq, bB_gh, bB_R, bB_sc);
				ah2, bh2, ab2, bb2, al2, bl2 = f_bsva(bB_L_c_t1, bB_L_c_t2, bB_L_c_tq, bB_L_c_tb, bB_gl, bB_R, bB_sc);
				nA = bB_cn * al2 * ah;
				nB = bB_cn * (al2 * bh + bl2);
				bu = (bx + bB_r * bt * nB) / (1 - bB_r * bt * nA);
				hh, b1, l1, bB_L_c_s1, bB_L_c_s2 = f_bsvs(bu, bB_L_c_s1, bB_L_c_s2, bB_L_c_hq, bB_L_c_bq, bB_gh, bB_R, bB_sc);
				bB_L_c_hq = hh;
				bB_L_c_bq = b1;
				hh2, b2, l2, bB_L_c_t1, bB_L_c_t2 = f_bsvs(hh, bB_L_c_t1, bB_L_c_t2, bB_L_c_tq, bB_L_c_tb, bB_gl, bB_R, bB_sc);
				bB_L_c_tq = hh2;
				bB_L_c_tb = b2;
				by = bB_cn * l2;
			}
			if (bB_a > 1.5) {
				by, bB_L_m_s1, bB_L_m_s2, bB_L_m_s3, bB_L_m_s4, bB_L_m_p0, bB_L_m_p1, bB_L_m_p2, bB_L_m_p3, bB_L_m_p4 = f_bmm(bx, bB_L_m_s1, bB_L_m_s2, bB_L_m_s3, bB_L_m_s4, bB_L_m_p0, bB_L_m_p1, bB_L_m_p2, bB_L_m_p3, bB_L_m_p4, bB_gm, bB_k, bB_typ, bB_sc, bB_wb);
			}
			bB_L_yp = by;
			if (bB_roll > 0.5) {
				by, bB_L_ro = f_op(by, bB_L_ro, bB_Gro);
				bB_L_ro = fixdenorm(bB_L_ro);
			}
			bo_L = bo_L + b_wB * by * bB_ocmp * b_osc;
		}
		xa_L = xa_L + b_wet * (bo_L - xa_L);
		bo_R = 0;
		if (bA_run > 0.5) {
			bx = xa_R * b_d;
			by = 0;
			bt = f_bsat(bA_R_yp * 3.3333333333, bA_rg);
			if (bA_a < 0.5) {
				ah, bh, ab, bb, al, bl = f_bsva(bA_R_v_s1, bA_R_v_s2, bA_R_v_hq, bA_R_v_bq, bA_gc, bA_R, bA_sc);
				nA = 2 * bA_R * ab;
				nB = 2 * bA_R * bb;
				bu = (bx + bA_r * bt * nB) / (1 - bA_r * bt * nA);
				hh, b1, l1, bA_R_v_s1, bA_R_v_s2 = f_bsvs(bu, bA_R_v_s1, bA_R_v_s2, bA_R_v_hq, bA_R_v_bq, bA_gc, bA_R, bA_sc);
				bA_R_v_hq = hh;
				bA_R_v_bq = b1;
				by = 2 * bA_R * b1;
			}
			if (bA_a > 0.5 && bA_a < 1.5) {
				ah, bh, ab, bb, al, bl = f_bsva(bA_R_c_s1, bA_R_c_s2, bA_R_c_hq, bA_R_c_bq, bA_gh, bA_R, bA_sc);
				ah2, bh2, ab2, bb2, al2, bl2 = f_bsva(bA_R_c_t1, bA_R_c_t2, bA_R_c_tq, bA_R_c_tb, bA_gl, bA_R, bA_sc);
				nA = bA_cn * al2 * ah;
				nB = bA_cn * (al2 * bh + bl2);
				bu = (bx + bA_r * bt * nB) / (1 - bA_r * bt * nA);
				hh, b1, l1, bA_R_c_s1, bA_R_c_s2 = f_bsvs(bu, bA_R_c_s1, bA_R_c_s2, bA_R_c_hq, bA_R_c_bq, bA_gh, bA_R, bA_sc);
				bA_R_c_hq = hh;
				bA_R_c_bq = b1;
				hh2, b2, l2, bA_R_c_t1, bA_R_c_t2 = f_bsvs(hh, bA_R_c_t1, bA_R_c_t2, bA_R_c_tq, bA_R_c_tb, bA_gl, bA_R, bA_sc);
				bA_R_c_tq = hh2;
				bA_R_c_tb = b2;
				by = bA_cn * l2;
			}
			if (bA_a > 1.5) {
				by, bA_R_m_s1, bA_R_m_s2, bA_R_m_s3, bA_R_m_s4, bA_R_m_p0, bA_R_m_p1, bA_R_m_p2, bA_R_m_p3, bA_R_m_p4 = f_bmm(bx, bA_R_m_s1, bA_R_m_s2, bA_R_m_s3, bA_R_m_s4, bA_R_m_p0, bA_R_m_p1, bA_R_m_p2, bA_R_m_p3, bA_R_m_p4, bA_gm, bA_k, bA_typ, bA_sc, bA_wb);
			}
			bA_R_yp = by;
			if (bA_roll > 0.5) {
				by, bA_R_ro = f_op(by, bA_R_ro, bA_Gro);
				bA_R_ro = fixdenorm(bA_R_ro);
			}
			bo_R = bo_R + b_wA * by * bA_ocmp * b_osc;
		}
		if (bB_run > 0.5) {
			bx = xa_R * b_d;
			by = 0;
			bt = f_bsat(bB_R_yp * 3.3333333333, bB_rg);
			if (bB_a < 0.5) {
				ah, bh, ab, bb, al, bl = f_bsva(bB_R_v_s1, bB_R_v_s2, bB_R_v_hq, bB_R_v_bq, bB_gc, bB_R, bB_sc);
				nA = 2 * bB_R * ab;
				nB = 2 * bB_R * bb;
				bu = (bx + bB_r * bt * nB) / (1 - bB_r * bt * nA);
				hh, b1, l1, bB_R_v_s1, bB_R_v_s2 = f_bsvs(bu, bB_R_v_s1, bB_R_v_s2, bB_R_v_hq, bB_R_v_bq, bB_gc, bB_R, bB_sc);
				bB_R_v_hq = hh;
				bB_R_v_bq = b1;
				by = 2 * bB_R * b1;
			}
			if (bB_a > 0.5 && bB_a < 1.5) {
				ah, bh, ab, bb, al, bl = f_bsva(bB_R_c_s1, bB_R_c_s2, bB_R_c_hq, bB_R_c_bq, bB_gh, bB_R, bB_sc);
				ah2, bh2, ab2, bb2, al2, bl2 = f_bsva(bB_R_c_t1, bB_R_c_t2, bB_R_c_tq, bB_R_c_tb, bB_gl, bB_R, bB_sc);
				nA = bB_cn * al2 * ah;
				nB = bB_cn * (al2 * bh + bl2);
				bu = (bx + bB_r * bt * nB) / (1 - bB_r * bt * nA);
				hh, b1, l1, bB_R_c_s1, bB_R_c_s2 = f_bsvs(bu, bB_R_c_s1, bB_R_c_s2, bB_R_c_hq, bB_R_c_bq, bB_gh, bB_R, bB_sc);
				bB_R_c_hq = hh;
				bB_R_c_bq = b1;
				hh2, b2, l2, bB_R_c_t1, bB_R_c_t2 = f_bsvs(hh, bB_R_c_t1, bB_R_c_t2, bB_R_c_tq, bB_R_c_tb, bB_gl, bB_R, bB_sc);
				bB_R_c_tq = hh2;
				bB_R_c_tb = b2;
				by = bB_cn * l2;
			}
			if (bB_a > 1.5) {
				by, bB_R_m_s1, bB_R_m_s2, bB_R_m_s3, bB_R_m_s4, bB_R_m_p0, bB_R_m_p1, bB_R_m_p2, bB_R_m_p3, bB_R_m_p4 = f_bmm(bx, bB_R_m_s1, bB_R_m_s2, bB_R_m_s3, bB_R_m_s4, bB_R_m_p0, bB_R_m_p1, bB_R_m_p2, bB_R_m_p3, bB_R_m_p4, bB_gm, bB_k, bB_typ, bB_sc, bB_wb);
			}
			bB_R_yp = by;
			if (bB_roll > 0.5) {
				by, bB_R_ro = f_op(by, bB_R_ro, bB_Gro);
				bB_R_ro = fixdenorm(bB_R_ro);
			}
			bo_R = bo_R + b_wB * by * bB_ocmp * b_osc;
		}
		xa_R = xa_R + b_wet * (bo_R - xa_R);
	}
}
hya_L = 0;
hya_R = 0;
if (cur_order > 0.5) {
	// ---- HPF stage, subsample a ----
	hya_L = xa_L;
	hya_R = xa_R;
	if (h_run > 0.5) {
		hi_L = xa_L * h_d;
		hb_L = 0;
		if (h_ash > 0.5) {
			o12, o24, h_L_sh_s1a, h_L_sh_s2a, h_L_sh_ba, h_L_sh_s1b, h_L_sh_s2b, h_L_sh_bb, h_L_sh_yp = f_sherman(hi_L, h_L_sh_s1a, h_L_sh_s2a, h_L_sh_ba, h_L_sh_s1b, h_L_sh_s2b, h_L_sh_bb, h_L_sh_yp, h_sh_g, h_sh_R1, h_sh_R, h_sh_fb, h_ti, 1);
			hb_L = hb_L + h_msh * (o12 + h_ti * (o24 - o12));
		}
		if (h_ak3 > 0.5) {
			o1, h_L_k3_s1, h_L_k3_s2, h_L_k3_s3, h_L_k3_yp = f_k35hp(hi_L, h_L_k3_s1, h_L_k3_s2, h_L_k3_s3, h_L_k3_yp, h_k3_g, h_k3_K, h_k3_L);
			hb_L = hb_L + h_mk3 * o1;
		}
		if (h_ald > 0.5) {
			o12, o24, h_L_ld_s1, h_L_ld_s2, h_L_ld_s3, h_L_ld_s4, h_L_ld_p0, h_L_ld_p1, h_L_ld_p2, h_L_ld_p3, h_L_ld_p4 = f_ladder(hi_L, h_L_ld_s1, h_L_ld_s2, h_L_ld_s3, h_L_ld_s4, h_L_ld_p0, h_L_ld_p1, h_L_ld_p2, h_L_ld_p3, h_L_ld_p4, h_ld_g, h_ld_k, h_ld_bc, h_ld_hs, 1);
			hb_L = hb_L + h_mld * (o12 + h_ti * (o24 - o12));
		}
		if (h_ast > 0.5) {
			o1, h_L_st_s1, h_L_st_s2, h_L_st_d1, h_L_st_d2, h_L_st_vb = f_steiner(hi_L * (1 - h_chr) * 0, hi_L * h_chr, hi_L * (1 - h_chr) * 1, h_L_st_s1, h_L_st_s2, h_L_st_d1, h_L_st_d2, h_L_st_vb, h_st_g, h_st_K);
			hb_L = hb_L + h_mst * o1 * h_st_kd;
		}
		if (h_ase > 0.5) {
			o1, h_L_se_s1, h_L_se_s2, h_L_se_hq, h_L_se_bq = f_sem(hi_L, h_L_se_s1, h_L_se_s2, h_L_se_hq, h_L_se_bq, h_se_g, h_se_R, h_chr, 1);
			hb_L = hb_L + h_mse * o1;
		}
		e0 = hb_L;
		e1 = 0;
		e2 = 0;
		e3 = 0;
		if (h_xa > 0.5) {
			eh, eb, el, h_L_x0_s1, h_L_x0_s2 = f_svf(e0, h_L_x0_s1, h_L_x0_s2, h_gx, 0.7071067811865476);
			h_L_x0_s1 = fixdenorm(h_L_x0_s1);
			h_L_x0_s2 = fixdenorm(h_L_x0_s2);
			e1 = eh;
		}
		if (h_xb > 0.5) {
			eh, eb, el, h_L_x1_s1, h_L_x1_s2 = f_svf(e1, h_L_x1_s1, h_L_x1_s2, h_gx, 0.7071067811865476);
			h_L_x1_s1 = fixdenorm(h_L_x1_s1);
			h_L_x1_s2 = fixdenorm(h_L_x1_s2);
			e2 = eh;
		}
		if (h_xc > 0.5) {
			eh, eb, el, h_L_x2_s1, h_L_x2_s2 = f_svf(e2, h_L_x2_s1, h_L_x2_s2, h_gx, 0.7071067811865476);
			h_L_x2_s1 = fixdenorm(h_L_x2_s1);
			h_L_x2_s2 = fixdenorm(h_L_x2_s2);
			e3 = eh;
		}
		wet_L = (h_w0 * e0 + h_w1 * e1 + h_w2 * e2 + h_w3 * e3) * h_osc;
		hya_L = xa_L + h_wet * (wet_L - xa_L);
		hi_R = xa_R * h_d;
		hb_R = 0;
		if (h_ash > 0.5) {
			o12, o24, h_R_sh_s1a, h_R_sh_s2a, h_R_sh_ba, h_R_sh_s1b, h_R_sh_s2b, h_R_sh_bb, h_R_sh_yp = f_sherman(hi_R, h_R_sh_s1a, h_R_sh_s2a, h_R_sh_ba, h_R_sh_s1b, h_R_sh_s2b, h_R_sh_bb, h_R_sh_yp, h_sh_g, h_sh_R1, h_sh_R, h_sh_fb, h_ti, 1);
			hb_R = hb_R + h_msh * (o12 + h_ti * (o24 - o12));
		}
		if (h_ak3 > 0.5) {
			o1, h_R_k3_s1, h_R_k3_s2, h_R_k3_s3, h_R_k3_yp = f_k35hp(hi_R, h_R_k3_s1, h_R_k3_s2, h_R_k3_s3, h_R_k3_yp, h_k3_g, h_k3_K, h_k3_L);
			hb_R = hb_R + h_mk3 * o1;
		}
		if (h_ald > 0.5) {
			o12, o24, h_R_ld_s1, h_R_ld_s2, h_R_ld_s3, h_R_ld_s4, h_R_ld_p0, h_R_ld_p1, h_R_ld_p2, h_R_ld_p3, h_R_ld_p4 = f_ladder(hi_R, h_R_ld_s1, h_R_ld_s2, h_R_ld_s3, h_R_ld_s4, h_R_ld_p0, h_R_ld_p1, h_R_ld_p2, h_R_ld_p3, h_R_ld_p4, h_ld_g, h_ld_k, h_ld_bc, h_ld_hs, 1);
			hb_R = hb_R + h_mld * (o12 + h_ti * (o24 - o12));
		}
		if (h_ast > 0.5) {
			o1, h_R_st_s1, h_R_st_s2, h_R_st_d1, h_R_st_d2, h_R_st_vb = f_steiner(hi_R * (1 - h_chr) * 0, hi_R * h_chr, hi_R * (1 - h_chr) * 1, h_R_st_s1, h_R_st_s2, h_R_st_d1, h_R_st_d2, h_R_st_vb, h_st_g, h_st_K);
			hb_R = hb_R + h_mst * o1 * h_st_kd;
		}
		if (h_ase > 0.5) {
			o1, h_R_se_s1, h_R_se_s2, h_R_se_hq, h_R_se_bq = f_sem(hi_R, h_R_se_s1, h_R_se_s2, h_R_se_hq, h_R_se_bq, h_se_g, h_se_R, h_chr, 1);
			hb_R = hb_R + h_mse * o1;
		}
		e0 = hb_R;
		e1 = 0;
		e2 = 0;
		e3 = 0;
		if (h_xa > 0.5) {
			eh, eb, el, h_R_x0_s1, h_R_x0_s2 = f_svf(e0, h_R_x0_s1, h_R_x0_s2, h_gx, 0.7071067811865476);
			h_R_x0_s1 = fixdenorm(h_R_x0_s1);
			h_R_x0_s2 = fixdenorm(h_R_x0_s2);
			e1 = eh;
		}
		if (h_xb > 0.5) {
			eh, eb, el, h_R_x1_s1, h_R_x1_s2 = f_svf(e1, h_R_x1_s1, h_R_x1_s2, h_gx, 0.7071067811865476);
			h_R_x1_s1 = fixdenorm(h_R_x1_s1);
			h_R_x1_s2 = fixdenorm(h_R_x1_s2);
			e2 = eh;
		}
		if (h_xc > 0.5) {
			eh, eb, el, h_R_x2_s1, h_R_x2_s2 = f_svf(e2, h_R_x2_s1, h_R_x2_s2, h_gx, 0.7071067811865476);
			h_R_x2_s1 = fixdenorm(h_R_x2_s1);
			h_R_x2_s2 = fixdenorm(h_R_x2_s2);
			e3 = eh;
		}
		wet_R = (h_w0 * e0 + h_w1 * e1 + h_w2 * e2 + h_w3 * e3) * h_osc;
		hya_R = xa_R + h_wet * (wet_R - xa_R);
	}
}
lsrc_L = cur_order > 0.5 ? hya_L : xa_L;
lsrc_R = cur_order > 0.5 ? hya_R : xa_R;
// ---- LPF stage, subsample a ----
lya_L = lsrc_L;
lya_R = lsrc_R;
if (l_run > 0.5) {
	li_L = lsrc_L * l_d;
	lb_L = 0;
	if (l_ash > 0.5) {
		o12, o24, l_L_sh_s1a, l_L_sh_s2a, l_L_sh_ba, l_L_sh_s1b, l_L_sh_s2b, l_L_sh_bb, l_L_sh_yp = f_sherman(li_L, l_L_sh_s1a, l_L_sh_s2a, l_L_sh_ba, l_L_sh_s1b, l_L_sh_s2b, l_L_sh_bb, l_L_sh_yp, l_sh_g, l_sh_R1, l_sh_R, l_sh_fb, l_ti, 0);
		lb_L = lb_L + l_msh * (o12 + l_ti * (o24 - o12));
	}
	if (l_ak3 > 0.5) {
		o1, l_L_k3_s1, l_L_k3_s2, l_L_k3_s3, l_L_k3_yp = f_k35lp(li_L, l_L_k3_s1, l_L_k3_s2, l_L_k3_s3, l_L_k3_yp, l_k3_g, l_k3_K, l_k3_L);
		lb_L = lb_L + l_mk3 * o1;
	}
	if (l_ald > 0.5) {
		o12, o24, l_L_ld_s1, l_L_ld_s2, l_L_ld_s3, l_L_ld_s4, l_L_ld_p0, l_L_ld_p1, l_L_ld_p2, l_L_ld_p3, l_L_ld_p4 = f_ladder(li_L, l_L_ld_s1, l_L_ld_s2, l_L_ld_s3, l_L_ld_s4, l_L_ld_p0, l_L_ld_p1, l_L_ld_p2, l_L_ld_p3, l_L_ld_p4, l_ld_g, l_ld_k, l_ld_bc, l_ld_hs, 0);
		lb_L = lb_L + l_mld * (o12 + l_ti * (o24 - o12));
	}
	if (l_ast > 0.5) {
		o1, l_L_st_s1, l_L_st_s2, l_L_st_d1, l_L_st_d2, l_L_st_vb = f_steiner(li_L * (1 - l_chr) * 1, li_L * l_chr, li_L * (1 - l_chr) * 0, l_L_st_s1, l_L_st_s2, l_L_st_d1, l_L_st_d2, l_L_st_vb, l_st_g, l_st_K);
		lb_L = lb_L + l_mst * o1 * l_st_kd;
	}
	if (l_ase > 0.5) {
		o1, l_L_se_s1, l_L_se_s2, l_L_se_hq, l_L_se_bq = f_sem(li_L, l_L_se_s1, l_L_se_s2, l_L_se_hq, l_L_se_bq, l_se_g, l_se_R, l_chr, 0);
		lb_L = lb_L + l_mse * o1;
	}
	if (l_adi > 0.5) {
		o1, l_L_di_s1, l_L_di_s2, l_L_di_s3, l_L_di_s4, l_L_di_v1, l_L_di_v2, l_L_di_v3, l_L_di_v4, l_L_di_sf, l_L_di_sc = f_diode(li_L, l_L_di_s1, l_L_di_s2, l_L_di_s3, l_L_di_s4, l_L_di_v1, l_L_di_v2, l_L_di_v3, l_L_di_v4, l_L_di_sf, l_L_di_sc, l_di_g, l_di_k, l_di_Gf, l_cmp);
		lb_L = lb_L + l_mdi * o1;
	}
	e0 = lb_L;
	e1 = 0;
	e2 = 0;
	e3 = 0;
	if (l_xa > 0.5) {
		eh, eb, el, l_L_x0_s1, l_L_x0_s2 = f_svf(e0, l_L_x0_s1, l_L_x0_s2, l_gx, 0.7071067811865476);
		l_L_x0_s1 = fixdenorm(l_L_x0_s1);
		l_L_x0_s2 = fixdenorm(l_L_x0_s2);
		e1 = el;
	}
	if (l_xb > 0.5) {
		eh, eb, el, l_L_x1_s1, l_L_x1_s2 = f_svf(e1, l_L_x1_s1, l_L_x1_s2, l_gx, 0.7071067811865476);
		l_L_x1_s1 = fixdenorm(l_L_x1_s1);
		l_L_x1_s2 = fixdenorm(l_L_x1_s2);
		e2 = el;
	}
	if (l_xc > 0.5) {
		eh, eb, el, l_L_x2_s1, l_L_x2_s2 = f_svf(e2, l_L_x2_s1, l_L_x2_s2, l_gx, 0.7071067811865476);
		l_L_x2_s1 = fixdenorm(l_L_x2_s1);
		l_L_x2_s2 = fixdenorm(l_L_x2_s2);
		e3 = el;
	}
	wet_L = (l_w0 * e0 + l_w1 * e1 + l_w2 * e2 + l_w3 * e3) * l_osc;
	lya_L = lsrc_L + l_wet * (wet_L - lsrc_L);
	li_R = lsrc_R * l_d;
	lb_R = 0;
	if (l_ash > 0.5) {
		o12, o24, l_R_sh_s1a, l_R_sh_s2a, l_R_sh_ba, l_R_sh_s1b, l_R_sh_s2b, l_R_sh_bb, l_R_sh_yp = f_sherman(li_R, l_R_sh_s1a, l_R_sh_s2a, l_R_sh_ba, l_R_sh_s1b, l_R_sh_s2b, l_R_sh_bb, l_R_sh_yp, l_sh_g, l_sh_R1, l_sh_R, l_sh_fb, l_ti, 0);
		lb_R = lb_R + l_msh * (o12 + l_ti * (o24 - o12));
	}
	if (l_ak3 > 0.5) {
		o1, l_R_k3_s1, l_R_k3_s2, l_R_k3_s3, l_R_k3_yp = f_k35lp(li_R, l_R_k3_s1, l_R_k3_s2, l_R_k3_s3, l_R_k3_yp, l_k3_g, l_k3_K, l_k3_L);
		lb_R = lb_R + l_mk3 * o1;
	}
	if (l_ald > 0.5) {
		o12, o24, l_R_ld_s1, l_R_ld_s2, l_R_ld_s3, l_R_ld_s4, l_R_ld_p0, l_R_ld_p1, l_R_ld_p2, l_R_ld_p3, l_R_ld_p4 = f_ladder(li_R, l_R_ld_s1, l_R_ld_s2, l_R_ld_s3, l_R_ld_s4, l_R_ld_p0, l_R_ld_p1, l_R_ld_p2, l_R_ld_p3, l_R_ld_p4, l_ld_g, l_ld_k, l_ld_bc, l_ld_hs, 0);
		lb_R = lb_R + l_mld * (o12 + l_ti * (o24 - o12));
	}
	if (l_ast > 0.5) {
		o1, l_R_st_s1, l_R_st_s2, l_R_st_d1, l_R_st_d2, l_R_st_vb = f_steiner(li_R * (1 - l_chr) * 1, li_R * l_chr, li_R * (1 - l_chr) * 0, l_R_st_s1, l_R_st_s2, l_R_st_d1, l_R_st_d2, l_R_st_vb, l_st_g, l_st_K);
		lb_R = lb_R + l_mst * o1 * l_st_kd;
	}
	if (l_ase > 0.5) {
		o1, l_R_se_s1, l_R_se_s2, l_R_se_hq, l_R_se_bq = f_sem(li_R, l_R_se_s1, l_R_se_s2, l_R_se_hq, l_R_se_bq, l_se_g, l_se_R, l_chr, 0);
		lb_R = lb_R + l_mse * o1;
	}
	if (l_adi > 0.5) {
		o1, l_R_di_s1, l_R_di_s2, l_R_di_s3, l_R_di_s4, l_R_di_v1, l_R_di_v2, l_R_di_v3, l_R_di_v4, l_R_di_sf, l_R_di_sc = f_diode(li_R, l_R_di_s1, l_R_di_s2, l_R_di_s3, l_R_di_s4, l_R_di_v1, l_R_di_v2, l_R_di_v3, l_R_di_v4, l_R_di_sf, l_R_di_sc, l_di_g, l_di_k, l_di_Gf, l_cmp);
		lb_R = lb_R + l_mdi * o1;
	}
	e0 = lb_R;
	e1 = 0;
	e2 = 0;
	e3 = 0;
	if (l_xa > 0.5) {
		eh, eb, el, l_R_x0_s1, l_R_x0_s2 = f_svf(e0, l_R_x0_s1, l_R_x0_s2, l_gx, 0.7071067811865476);
		l_R_x0_s1 = fixdenorm(l_R_x0_s1);
		l_R_x0_s2 = fixdenorm(l_R_x0_s2);
		e1 = el;
	}
	if (l_xb > 0.5) {
		eh, eb, el, l_R_x1_s1, l_R_x1_s2 = f_svf(e1, l_R_x1_s1, l_R_x1_s2, l_gx, 0.7071067811865476);
		l_R_x1_s1 = fixdenorm(l_R_x1_s1);
		l_R_x1_s2 = fixdenorm(l_R_x1_s2);
		e2 = el;
	}
	if (l_xc > 0.5) {
		eh, eb, el, l_R_x2_s1, l_R_x2_s2 = f_svf(e2, l_R_x2_s1, l_R_x2_s2, l_gx, 0.7071067811865476);
		l_R_x2_s1 = fixdenorm(l_R_x2_s1);
