dQ_O_L_he = H_dQ_O_L_he;
dQ_O_R_lt = H_dQ_O_R_lt;
dQ_O_R_cf = H_dQ_O_R_cf;
dQ_O_R_cs = H_dQ_O_R_cs;
dQ_O_R_mem = H_dQ_O_R_mem;
dQ_O_R_yp = H_dQ_O_R_yp;
dQ_O_R_hp = H_dQ_O_R_hp;
dQ_O_R_he = H_dQ_O_R_he;
dQ_V_L_hp = H_dQ_V_L_hp;
