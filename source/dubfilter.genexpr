	l_L_sh_hha = 0;
	l_L_sh_hba = 0;
	l_L_sh_hla = 0;
	l_L_sh_hhb = 0;
	l_L_sh_hbb = 0;
	l_L_sh_hlb = 0;
	l_L_sh_eb = 0;
	l_R_sh_s1a = 0;
	l_R_sh_s2a = 0;
	l_R_sh_ba = 0;
	l_R_sh_s1b = 0;
	l_R_sh_s2b = 0;
	l_R_sh_bb = 0;
	l_R_sh_yp = 0;
	l_R_sh_pa = 0;
	l_R_sh_pb = 0;
	l_R_sh_hha = 0;
	l_R_sh_hba = 0;
	l_R_sh_hla = 0;
	l_R_sh_hhb = 0;
	l_R_sh_hbb = 0;
	l_R_sh_hlb = 0;
	l_R_sh_eb = 0;
	l_dzsh = 0;
}
if (l_ash > 0.5) {
	l_dzsh = 1;
}
l_dzk3 = H_l_dzk3;
if (l_ak3 < 0.5 && l_dzk3 > 0.5) {
