			if (h_ast > 0.5) {
				o1, h_R_st_s1, h_R_st_s2, h_R_st_d1, h_R_st_d2, h_R_st_vb = f_steiner(hi_R * (1 - h_chr) * 0, hi_R * h_chr, hi_R * (1 - h_chr) * 1, h_R_st_s1, h_R_st_s2, h_R_st_d1, h_R_st_d2, h_R_st_vb, h_st_g, h_st_K);
				hb_R = hb_R + h_mst * o1 * h_st_kd;
			}
			if (h_ase > 0.5) {
				o1, h_R_se_s1, h_R_se_s2, h_R_se_hq, h_R_se_bq = f_sem(hi_R, h_R_se_s1, h_R_se_s2, h_R_se_hq, h_R_se_bq, h_se_g, h_se_R, h_chr, 1);
				hb_R = hb_R + h_mse * o1;
			}
			e0 = hb_R;
			e1 = 0;
			e2 = 0;
			e3 = 0;
			if (h_xa > 0.5) {
				eh, eb, el, h_R_x0_s1, h_R_x0_s2 = f_svf(e0, h_R_x0_s1, h_R_x0_s2, h_gx, 0.7071067811865476);
				h_R_x0_s1 = fixdenorm(h_R_x0_s1);
				h_R_x0_s2 = fixdenorm(h_R_x0_s2);
				e1 = eh;
			}
			if (h_xb > 0.5) {
				eh, eb, el, h_R_x1_s1, h_R_x1_s2 = f_svf(e1, h_R_x1_s1, h_R_x1_s2, h_gx, 0.7071067811865476);
				h_R_x1_s1 = fixdenorm(h_R_x1_s1);
				h_R_x1_s2 = fixdenorm(h_R_x1_s2);
				e2 = eh;
			}
			if (h_xc > 0.5) {
				eh, eb, el, h_R_x2_s1, h_R_x2_s2 = f_svf(e2, h_R_x2_s1, h_R_x2_s2, h_gx, 0.7071067811865476);
				h_R_x2_s1 = fixdenorm(h_R_x2_s1);
				h_R_x2_s2 = fixdenorm(h_R_x2_s2);
				e3 = eh;
			}
			wet_R = (h_w0 * e0 + h_w1 * e1 + h_w2 * e2 + h_w3 * e3) * h_osc;
			hyb_R = lyb_R + h_wet * (wet_R - lyb_R);
		}
		zb_L = hyb_L;
		zb_R = hyb_R;
	}
	if (b_cur_pos < 0.5) {
		if (b_run > 0.5) {
			bo_L = 0;
			if (bA_run > 0.5) {
				bx = zb_L * b_d;
				by = 0;
				bt = f_bsat(bA_L_yp * 3.3333333333, bA_rg);
				if (bA_a < 0.5) {
					ah, bh, ab, bb, al, bl = f_bsva(bA_L_v_s1, bA_L_v_s2, bA_L_v_hq, bA_L_v_bq, bA_gc, bA_R, bA_sc);
					nA = 2 * bA_R * ab;
					nB = 2 * bA_R * bb;
					bu = (bx + bA_r * bt * nB) / (1 - bA_r * bt * nA);
					hh, b1, l1, bA_L_v_s1, bA_L_v_s2 = f_bsvs(bu, bA_L_v_s1, bA_L_v_s2, bA_L_v_hq, bA_L_v_bq, bA_gc, bA_R, bA_sc);
					bA_L_v_hq = hh;
					bA_L_v_bq = b1;
					by = 2 * bA_R * b1;
				}
				if (bA_a > 0.5 && bA_a < 1.5) {
					ah, bh, ab, bb, al, bl = f_bsva(bA_L_c_s1, bA_L_c_s2, bA_L_c_hq, bA_L_c_bq, bA_gh, bA_R, bA_sc);
					ah2, bh2, ab2, bb2, al2, bl2 = f_bsva(bA_L_c_t1, bA_L_c_t2, bA_L_c_tq, bA_L_c_tb, bA_gl, bA_R, bA_sc);
					nA = bA_cn * al2 * ah;
					nB = bA_cn * (al2 * bh + bl2);
					bu = (bx + bA_r * bt * nB) / (1 - bA_r * bt * nA);
					hh, b1, l1, bA_L_c_s1, bA_L_c_s2 = f_bsvs(bu, bA_L_c_s1, bA_L_c_s2, bA_L_c_hq, bA_L_c_bq, bA_gh, bA_R, bA_sc);
					bA_L_c_hq = hh;
					bA_L_c_bq = b1;
					hh2, b2, l2, bA_L_c_t1, bA_L_c_t2 = f_bsvs(hh, bA_L_c_t1, bA_L_c_t2, bA_L_c_tq, bA_L_c_tb, bA_gl, bA_R, bA_sc);
					bA_L_c_tq = hh2;
					bA_L_c_tb = b2;
					by = bA_cn * l2;
				}
				if (bA_a > 1.5) {
					by, bA_L_m_s1, bA_L_m_s2, bA_L_m_s3, bA_L_m_s4, bA_L_m_p0, bA_L_m_p1, bA_L_m_p2, bA_L_m_p3, bA_L_m_p4 = f_bmm(bx, bA_L_m_s1, bA_L_m_s2, bA_L_m_s3, bA_L_m_s4, bA_L_m_p0, bA_L_m_p1, bA_L_m_p2, bA_L_m_p3, bA_L_m_p4, bA_gm, bA_k, bA_typ, bA_sc, bA_wb);
				}
				bA_L_yp = by;
				if (bA_roll > 0.5) {
					by, bA_L_ro = f_op(by, bA_L_ro, bA_Gro);
					bA_L_ro = fixdenorm(bA_L_ro);
				}
				bo_L = bo_L + b_wA * by * bA_ocmp * b_osc;
			}
			if (bB_run > 0.5) {
				bx = zb_L * b_d;
				by = 0;
				bt = f_bsat(bB_L_yp * 3.3333333333, bB_rg);
				if (bB_a < 0.5) {
					ah, bh, ab, bb, al, bl = f_bsva(bB_L_v_s1, bB_L_v_s2, bB_L_v_hq, bB_L_v_bq, bB_gc, bB_R, bB_sc);
					nA = 2 * bB_R * ab;
					nB = 2 * bB_R * bb;
					bu = (bx + bB_r * bt * nB) / (1 - bB_r * bt * nA);
					hh, b1, l1, bB_L_v_s1, bB_L_v_s2 = f_bsvs(bu, bB_L_v_s1, bB_L_v_s2, bB_L_v_hq, bB_L_v_bq, bB_gc, bB_R, bB_sc);
					bB_L_v_hq = hh;
					bB_L_v_bq = b1;
					by = 2 * bB_R * b1;
				}
				if (bB_a > 0.5 && bB_a < 1.5) {
					ah, bh, ab, bb, al, bl = f_bsva(bB_L_c_s1, bB_L_c_s2, bB_L_c_hq, bB_L_c_bq, bB_gh, bB_R, bB_sc);
					ah2, bh2, ab2, bb2, al2, bl2 = f_bsva(bB_L_c_t1, bB_L_c_t2, bB_L_c_tq, bB_L_c_tb, bB_gl, bB_R, bB_sc);
					nA = bB_cn * al2 * ah;
					nB = bB_cn * (al2 * bh + bl2);
					bu = (bx + bB_r * bt * nB) / (1 - bB_r * bt * nA);
					hh, b1, l1, bB_L_c_s1, bB_L_c_s2 = f_bsvs(bu, bB_L_c_s1, bB_L_c_s2, bB_L_c_hq, bB_L_c_bq, bB_gh, bB_R, bB_sc);
					bB_L_c_hq = hh;
					bB_L_c_bq = b1;
					hh2, b2, l2, bB_L_c_t1, bB_L_c_t2 = f_bsvs(hh, bB_L_c_t1, bB_L_c_t2, bB_L_c_tq, bB_L_c_tb, bB_gl, bB_R, bB_sc);
					bB_L_c_tq = hh2;
					bB_L_c_tb = b2;
					by = bB_cn * l2;
				}
				if (bB_a > 1.5) {
					by, bB_L_m_s1, bB_L_m_s2, bB_L_m_s3, bB_L_m_s4, bB_L_m_p0, bB_L_m_p1, bB_L_m_p2, bB_L_m_p3, bB_L_m_p4 = f_bmm(bx, bB_L_m_s1, bB_L_m_s2, bB_L_m_s3, bB_L_m_s4, bB_L_m_p0, bB_L_m_p1, bB_L_m_p2, bB_L_m_p3, bB_L_m_p4, bB_gm, bB_k, bB_typ, bB_sc, bB_wb);
				}
				bB_L_yp = by;
				if (bB_roll > 0.5) {
					by, bB_L_ro = f_op(by, bB_L_ro, bB_Gro);
					bB_L_ro = fixdenorm(bB_L_ro);
				}
				bo_L = bo_L + b_wB * by * bB_ocmp * b_osc;
			}
			zb_L = zb_L + b_wet * (bo_L - zb_L);
			bo_R = 0;
			if (bA_run > 0.5) {
				bx = zb_R * b_d;
				by = 0;
				bt = f_bsat(bA_R_yp * 3.3333333333, bA_rg);
				if (bA_a < 0.5) {
					ah, bh, ab, bb, al, bl = f_bsva(bA_R_v_s1, bA_R_v_s2, bA_R_v_hq, bA_R_v_bq, bA_gc, bA_R, bA_sc);
					nA = 2 * bA_R * ab;
					nB = 2 * bA_R * bb;
					bu = (bx + bA_r * bt * nB) / (1 - bA_r * bt * nA);
					hh, b1, l1, bA_R_v_s1, bA_R_v_s2 = f_bsvs(bu, bA_R_v_s1, bA_R_v_s2, bA_R_v_hq, bA_R_v_bq, bA_gc, bA_R, bA_sc);
					bA_R_v_hq = hh;
					bA_R_v_bq = b1;
					by = 2 * bA_R * b1;
				}
				if (bA_a > 0.5 && bA_a < 1.5) {
					ah, bh, ab, bb, al, bl = f_bsva(bA_R_c_s1, bA_R_c_s2, bA_R_c_hq, bA_R_c_bq, bA_gh, bA_R, bA_sc);
					ah2, bh2, ab2, bb2, al2, bl2 = f_bsva(bA_R_c_t1, bA_R_c_t2, bA_R_c_tq, bA_R_c_tb, bA_gl, bA_R, bA_sc);
					nA = bA_cn * al2 * ah;
					nB = bA_cn * (al2 * bh + bl2);
					bu = (bx + bA_r * bt * nB) / (1 - bA_r * bt * nA);
					hh, b1, l1, bA_R_c_s1, bA_R_c_s2 = f_bsvs(bu, bA_R_c_s1, bA_R_c_s2, bA_R_c_hq, bA_R_c_bq, bA_gh, bA_R, bA_sc);
					bA_R_c_hq = hh;
					bA_R_c_bq = b1;
					hh2, b2, l2, bA_R_c_t1, bA_R_c_t2 = f_bsvs(hh, bA_R_c_t1, bA_R_c_t2, bA_R_c_tq, bA_R_c_tb, bA_gl, bA_R, bA_sc);
					bA_R_c_tq = hh2;
					bA_R_c_tb = b2;
					by = bA_cn * l2;
				}
				if (bA_a > 1.5) {
					by, bA_R_m_s1, bA_R_m_s2, bA_R_m_s3, bA_R_m_s4, bA_R_m_p0, bA_R_m_p1, bA_R_m_p2, bA_R_m_p3, bA_R_m_p4 = f_bmm(bx, bA_R_m_s1, bA_R_m_s2, bA_R_m_s3, bA_R_m_s4, bA_R_m_p0, bA_R_m_p1, bA_R_m_p2, bA_R_m_p3, bA_R_m_p4, bA_gm, bA_k, bA_typ, bA_sc, bA_wb);
				}
				bA_R_yp = by;
				if (bA_roll > 0.5) {
					by, bA_R_ro = f_op(by, bA_R_ro, bA_Gro);
					bA_R_ro = fixdenorm(bA_R_ro);
				}
				bo_R = bo_R + b_wA * by * bA_ocmp * b_osc;
			}
			if (bB_run > 0.5) {
				bx = zb_R * b_d;
				by = 0;
				bt = f_bsat(bB_R_yp * 3.3333333333, bB_rg);
				if (bB_a < 0.5) {
					ah, bh, ab, bb, al, bl = f_bsva(bB_R_v_s1, bB_R_v_s2, bB_R_v_hq, bB_R_v_bq, bB_gc, bB_R, bB_sc);
					nA = 2 * bB_R * ab;
					nB = 2 * bB_R * bb;
					bu = (bx + bB_r * bt * nB) / (1 - bB_r * bt * nA);
					hh, b1, l1, bB_R_v_s1, bB_R_v_s2 = f_bsvs(bu, bB_R_v_s1, bB_R_v_s2, bB_R_v_hq, bB_R_v_bq, bB_gc, bB_R, bB_sc);
					bB_R_v_hq = hh;
					bB_R_v_bq = b1;
					by = 2 * bB_R * b1;
				}
				if (bB_a > 0.5 && bB_a < 1.5) {
					ah, bh, ab, bb, al, bl = f_bsva(bB_R_c_s1, bB_R_c_s2, bB_R_c_hq, bB_R_c_bq, bB_gh, bB_R, bB_sc);
					ah2, bh2, ab2, bb2, al2, bl2 = f_bsva(bB_R_c_t1, bB_R_c_t2, bB_R_c_tq, bB_R_c_tb, bB_gl, bB_R, bB_sc);
					nA = bB_cn * al2 * ah;
					nB = bB_cn * (al2 * bh + bl2);
					bu = (bx + bB_r * bt * nB) / (1 - bB_r * bt * nA);
					hh, b1, l1, bB_R_c_s1, bB_R_c_s2 = f_bsvs(bu, bB_R_c_s1, bB_R_c_s2, bB_R_c_hq, bB_R_c_bq, bB_gh, bB_R, bB_sc);
					bB_R_c_hq = hh;
					bB_R_c_bq = b1;
					hh2, b2, l2, bB_R_c_t1, bB_R_c_t2 = f_bsvs(hh, bB_R_c_t1, bB_R_c_t2, bB_R_c_tq, bB_R_c_tb, bB_gl, bB_R, bB_sc);
					bB_R_c_tq = hh2;
					bB_R_c_tb = b2;
					by = bB_cn * l2;
				}
				if (bB_a > 1.5) {
					by, bB_R_m_s1, bB_R_m_s2, bB_R_m_s3, bB_R_m_s4, bB_R_m_p0, bB_R_m_p1, bB_R_m_p2, bB_R_m_p3, bB_R_m_p4 = f_bmm(bx, bB_R_m_s1, bB_R_m_s2, bB_R_m_s3, bB_R_m_s4, bB_R_m_p0, bB_R_m_p1, bB_R_m_p2, bB_R_m_p3, bB_R_m_p4, bB_gm, bB_k, bB_typ, bB_sc, bB_wb);
				}
				bB_R_yp = by;
				if (bB_roll > 0.5) {
					by, bB_R_ro = f_op(by, bB_R_ro, bB_Gro);
					bB_R_ro = fixdenorm(bB_R_ro);
				}
				bo_R = bo_R + b_wB * by * bB_ocmp * b_osc;
			}
			zb_R = zb_R + b_wet * (bo_R - zb_R);
		}
	}
}

// ================= output (2x downsampler when oversampling) =================
y_L = za_L;
y_R = za_R;
if (ovs > 1.5) {
	pa, os_L_dna0, os_L_dna1, os_L_dna2, os_L_dna3, os_L_dna4, os_L_dna5 = f_ap5(zb_L, os_L_dna0, os_L_dna1, os_L_dna2, os_L_dna3, os_L_dna4, os_L_dna5, 0.035979631179546, 0.270744078039831, 0.557994617257913, 0.775098715397111, 0.916958938825425);
	pb, os_L_dnb0, os_L_dnb1, os_L_dnb2, os_L_dnb3, os_L_dnb4, os_L_dnb5 = f_ap5(za_L, os_L_dnb0, os_L_dnb1, os_L_dnb2, os_L_dnb3, os_L_dnb4, os_L_dnb5, 0.134200951194299, 0.418804850254691, 0.677594451212584, 0.853151529122229, 0.972847950939362);
	y_L = 0.5 * (pa + pb);
	pa, os_R_dna0, os_R_dna1, os_R_dna2, os_R_dna3, os_R_dna4, os_R_dna5 = f_ap5(zb_R, os_R_dna0, os_R_dna1, os_R_dna2, os_R_dna3, os_R_dna4, os_R_dna5, 0.035979631179546, 0.270744078039831, 0.557994617257913, 0.775098715397111, 0.916958938825425);
	pb, os_R_dnb0, os_R_dnb1, os_R_dnb2, os_R_dnb3, os_R_dnb4, os_R_dnb5 = f_ap5(za_R, os_R_dnb0, os_R_dnb1, os_R_dnb2, os_R_dnb3, os_R_dnb4, os_R_dnb5, 0.134200951194299, 0.418804850254691, 0.677594451212584, 0.853151529122229, 0.972847950939362);
	y_R = 0.5 * (pa + pb);
}

// ================= dynamics controls (v1.3) =================
dz_t_gi = H_dz_t_gi + a_par * (exp(0.11512925465 * clamp(t_in, -24, 24)) - H_dz_t_gi);
dz_t_go = H_dz_t_go + a_par * (exp(0.11512925465 * clamp(t_out, -24, 24)) - H_dz_t_go);
dz_t_mx = H_dz_t_mx + a_mix * (clamp(t_mix, 0, 100) * 0.01 - H_dz_t_mx);
if (abs(dz_t_mx - (clamp(t_mix, 0, 100) * 0.01)) < 0.0001) {
	dz_t_mx = clamp(t_mix, 0, 100) * 0.01;
}
dz_t_wt = t_on > 0.5 ? 1 : 0;
dz_t_w = H_dz_t_w + a_mix * (dz_t_wt - H_dz_t_w);
if (abs(dz_t_w - (dz_t_wt)) < 0.0001) {
	dz_t_w = dz_t_wt;
}
dz_o_gi = H_dz_o_gi + a_par * (exp(0.11512925465 * clamp(o_in, -24, 24)) - H_dz_o_gi);
dz_o_go = H_dz_o_go + a_par * (exp(0.11512925465 * clamp(o_out, -24, 24)) - H_dz_o_go);
dz_o_mx = H_dz_o_mx + a_mix * (clamp(o_mix, 0, 100) * 0.01 - H_dz_o_mx);
if (abs(dz_o_mx - (clamp(o_mix, 0, 100) * 0.01)) < 0.0001) {
	dz_o_mx = clamp(o_mix, 0, 100) * 0.01;
}
dz_o_wt = o_on > 0.5 ? 1 : 0;
dz_o_w = H_dz_o_w + a_mix * (dz_o_wt - H_dz_o_w);
if (abs(dz_o_w - (dz_o_wt)) < 0.0001) {
	dz_o_w = dz_o_wt;
}
dz_v_gi = H_dz_v_gi + a_par * (exp(0.11512925465 * clamp(v_in, -24, 24)) - H_dz_v_gi);
dz_v_go = H_dz_v_go + a_par * (exp(0.11512925465 * clamp(v_out, -24, 24)) - H_dz_v_go);
dz_v_mx = H_dz_v_mx + a_mix * (clamp(v_mix, 0, 100) * 0.01 - H_dz_v_mx);
if (abs(dz_v_mx - (clamp(v_mix, 0, 100) * 0.01)) < 0.0001) {
	dz_v_mx = clamp(v_mix, 0, 100) * 0.01;
}
dz_v_wt = v_on > 0.5 ? 1 : 0;
dz_v_w = H_dz_v_w + a_mix * (dz_v_wt - H_dz_v_w);
if (abs(dz_v_w - (dz_v_wt)) < 0.0001) {
	dz_v_w = dz_v_wt;
}
dz_t_dz = H_dz_t_dz + a_par * (clamp(t_drive, 0, 100) * 0.01 - H_dz_t_dz);
dz_t_bz = H_dz_t_bz + a_par * (clamp(t_bias, -100, 100) * 0.01 - H_dz_t_bz);
t_D = exp2(5.98 * dz_t_dz);
t_k = 0.3 * t_D;
t_b = 0.6 * dz_t_bz;
t_tb = tanh((t_b > 0 ? 1.25 : 0.85) * t_b);
t_ib = 1 / (1 - t_tb * t_tb);
t_ref = 0.5 * (abs(f_tube(0.25 * t_k, t_b, t_ib)) + abs(f_tube(-0.25 * t_k, t_b, t_ib)));
t_ko = t_auto > 0.5 ? 0.25 / max(t_ref, 1e-9) : 1 / (0.3 * sqrt(t_D));
t_gt = tan(pi * min(clamp(t_tone, 1000, 20000), 0.45 * 2 * fs) / (2 * fs));
t_Gt = t_gt / (1 + t_gt);
t_dcr = 1 - 2 * pi * 8 / fs;
dz_o_prz = H_dz_o_prz + a_par * (clamp(o_pr, 0, 100) * 0.01 - H_dz_o_prz);
dz_o_emz = H_dz_o_emz + a_par * (clamp(o_emph, 0, 100) * 0.01 - H_dz_o_emz);
dz_o_lkz = H_dz_o_lkz + a_par * (clamp(o_link, 0, 100) * 0.01 - H_dz_o_lkz);
o_prg = exp(0.11512925465 * (50 * dz_o_prz - 12));
o_lim = o_mode > 0.5 ? 1 : 0;
o_K = o_lim > 0.5 ? 4 : 1.6;
o_p = o_lim > 0.5 ? 9 : 2;
o_aatt = 1 - exp(-1 / (0.0045 * fs));
o_aela = 1 - exp(-1 / (0.002 * fs));
o_ael = 1 - exp(-1 / (0.004 * fs));
o_afr = 1 - exp(-1 / (0.040 * fs));
o_asa = 1 - exp(-1 / (0.150 * fs));
o_amu = 1 - exp(-1 / (4.0 * fs));
o_amd = 1 - exp(-1 / (20.0 * fs));
o_ghp = tan(pi * clamp(o_hpf, 20, 500) / fs);
o_Ghp = o_ghp / (1 + o_ghp);
o_ge = tan(pi * 2500 / fs);
o_Ge = o_ge / (1 + o_ge);
dz_v_thz = H_dz_v_thz + a_par * (clamp(v_thr, -50, 0) - H_dz_v_thz);
dz_v_lkz = H_dz_v_lkz + a_par * (clamp(v_link, 0, 100) * 0.01 - H_dz_v_lkz);
v_slope = (clamp(floor(v_ratio + 0.5), 0, 6) < 0.5 ? -0.33333333333333337 : (clamp(floor(v_ratio + 0.5), 0, 6) < 1.5 ? -0.5 : (clamp(floor(v_ratio + 0.5), 0, 6) < 2.5 ? -0.6666666666666667 : (clamp(floor(v_ratio + 0.5), 0, 6) < 3.5 ? -0.75 : (clamp(floor(v_ratio + 0.5), 0, 6) < 4.5 ? -0.8333333333333334 : (clamp(floor(v_ratio + 0.5), 0, 6) < 5.5 ? -0.9 : -1))))));
v_ams = (clamp(floor(v_att + 0.5), 0, 6) < 0.5 ? 0.03 : (clamp(floor(v_att + 0.5), 0, 6) < 1.5 ? 0.1 : (clamp(floor(v_att + 0.5), 0, 6) < 2.5 ? 0.3 : (clamp(floor(v_att + 0.5), 0, 6) < 3.5 ? 1 : (clamp(floor(v_att + 0.5), 0, 6) < 4.5 ? 3 : (clamp(floor(v_att + 0.5), 0, 6) < 5.5 ? 10 : 30))))));
v_aat = 1 - exp(-1 / (0.001 * v_ams * fs));
v_are = 1 - exp(-1 / (clamp(v_rel, 0.05, 3) * fs));
v_arms = 1 - exp(-1 / (0.003 * fs));
v_W = v_knee < 0.5 ? 0.0001 : (v_knee < 1.5 ? 6 : 12);
v_ghp = tan(pi * clamp(v_hpf, 20, 500) / fs);
v_Ghp = v_ghp / (1 + v_ghp);
v_g1 = tan(pi * 200 / fs);
v_G1 = v_g1 / (1 + v_g1);
v_g2 = tan(pi * 3000 / fs);
v_G2 = v_g2 / (1 + v_g2);
v_mk = v_auto > 0.5 ? exp(0.11512925465 * 0.5 * (-v_slope) * (-dz_v_thz)) : 1;
dz_g_wt = g_on > 0.5 ? 1 : 0;
dz_g_w = H_dz_g_w + a_mix * (dz_g_wt - H_dz_g_w);
if (abs(dz_g_w - (dz_g_wt)) < 0.0001) {
	dz_g_w = dz_g_wt;
}
g_ghp = tan(pi * clamp(g_hpf, 20, 2000) / fs);
g_Ghp = g_ghp / (1 + g_ghp);
g_glp = tan(pi * min(clamp(g_lpf, 200, 20000), 0.45 * fs) / fs);
g_Glp = g_glp / (1 + g_glp);
g_dec = exp(-1 / (0.030 * fs));
g_rdb = -clamp(g_range, -80, 0) + 0.0001;
g_sat = g_rdb / (0.001 * clamp(g_att, 0.1, 50) * fs);
g_sre = g_rdb / (0.001 * clamp(g_rel, 5, 2000) * fs);
g_hs = 0.001 * clamp(g_hold, 0, 500) * fs;
g_floor = exp(0.11512925465 * clamp(g_range, -80, 0));
dz_kl_t = key_listen > 0.5 ? 1 : 0;
dz_kl_w = H_dz_kl_w + a_mix * (dz_kl_t - H_dz_kl_w);
if (abs(dz_kl_w - (dz_kl_t)) < 0.0001) {
	dz_kl_w = dz_kl_t;
}
dz_kl_sel = key_listen > 0.5 ? clamp(floor(key_listen + 0.5), 1, 3) : H_dz_kl_sel;
dz_d_oP = H_dz_d_oP;
dz_d_oQ = H_dz_d_oQ;
dz_d_act = H_dz_d_act;
dz_d_fade = H_dz_d_fade;
d_ot = clamp(floor(c_order + 0.5), 0, 5);
d_ocur = dz_d_act < 0.5 ? dz_d_oP : dz_d_oQ;
d_cpPQ = 0;
d_cpQP = 0;
if (d_ot != d_ocur) {
	if (dz_d_act < 0.5) {
		d_cpPQ = 1;
		dz_d_oQ = d_ot;
		dz_d_act = 1;
	} else {
		d_cpQP = 1;
		dz_d_oP = d_ot;
		dz_d_act = 0;
	}
	dz_d_fade = 0;
}
dz_d_fade = min(1, dz_d_fade + fstep);
d_wP = dz_d_act < 0.5 ? dz_d_fade : 1 - dz_d_fade;
d_wQ = 1 - d_wP;
d_any = (dz_t_w + dz_o_w + dz_v_w) > 0 ? 1 : 0;
dP_run = (d_any > 0.5 && d_wP > 0) ? 1 : 0;
dQ_run = (d_any > 0.5 && d_wQ > 0) ? 1 : 0;
if (d_cpPQ > 0.5) {
	dQ_T_L_upa0 = dP_T_L_upa0;
	dQ_T_L_upa1 = dP_T_L_upa1;
	dQ_T_L_upa2 = dP_T_L_upa2;
	dQ_T_L_upa3 = dP_T_L_upa3;
	dQ_T_L_upa4 = dP_T_L_upa4;
	dQ_T_L_upa5 = dP_T_L_upa5;
	dQ_T_L_upb0 = dP_T_L_upb0;
	dQ_T_L_upb1 = dP_T_L_upb1;
	dQ_T_L_upb2 = dP_T_L_upb2;
	dQ_T_L_upb3 = dP_T_L_upb3;
	dQ_T_L_upb4 = dP_T_L_upb4;
	dQ_T_L_upb5 = dP_T_L_upb5;
	dQ_T_L_dna0 = dP_T_L_dna0;
	dQ_T_L_dna1 = dP_T_L_dna1;
	dQ_T_L_dna2 = dP_T_L_dna2;
	dQ_T_L_dna3 = dP_T_L_dna3;
	dQ_T_L_dna4 = dP_T_L_dna4;
	dQ_T_L_dna5 = dP_T_L_dna5;
	dQ_T_L_dnb0 = dP_T_L_dnb0;
	dQ_T_L_dnb1 = dP_T_L_dnb1;
	dQ_T_L_dnb2 = dP_T_L_dnb2;
	dQ_T_L_dnb3 = dP_T_L_dnb3;
	dQ_T_L_dnb4 = dP_T_L_dnb4;
	dQ_T_L_dnb5 = dP_T_L_dnb5;
	dQ_T_L_ton = dP_T_L_ton;
	dQ_T_L_dcx = dP_T_L_dcx;
	dQ_T_L_dcy = dP_T_L_dcy;
	dQ_T_L_dda0 = dP_T_L_dda0;
	dQ_T_L_dda1 = dP_T_L_dda1;
	dQ_T_L_dda2 = dP_T_L_dda2;
	dQ_T_L_dda3 = dP_T_L_dda3;
	dQ_T_L_dda4 = dP_T_L_dda4;
	dQ_T_L_dda5 = dP_T_L_dda5;
	dQ_T_L_ddb0 = dP_T_L_ddb0;
	dQ_T_L_ddb1 = dP_T_L_ddb1;
	dQ_T_L_ddb2 = dP_T_L_ddb2;
