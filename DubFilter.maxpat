_s4dnb1(0.0);\nHistory H_os_R_s4dnb2(0.0);\nHistory H_os_R_s4dnb3(0.0);\nHistory H_os_R_s4dnb4(0.0);\nHistory H_os_R_s4dnb5(0.0);\nHistory H_cur_tos(1);\nHistory H_cur_k35(0);\nHistory H_sh_lr(0);\nHistory H_ef_en(0);\nHistory H_ef_mx(1);\nHistory H_ef_e(0);\nHistory H_ef_ld(0);\nHistory H_ef_L1(0);\nHistory H_ef_L2(0);\nHistory H_ef_R1(0);\nHistory H_ef_R2(0);\nHistory H_l_dzsh(0.0);\nHistory H_l_dzk3(0.0);\nHistory H_l_dzld(0.0);\nHistory H_l_dzst(0.0);\nHistory H_l_dzse(0.0);\nHistory H_l_dzdi(0.0);\nHistory H_l_dzar(0.0);\nHistory H_l_dzx0(0.0);\nHistory H_l_dzx1(0.0);\nHistory H_l_dzx2(0.0);\nHistory H_h_dzsh(0.0);\nHistory H_h_dzk3(0.0);\nHistory H_h_dzld(0.0);\nHistory H_h_dzst(0.0);\nHistory H_h_dzse(0.0);\nHistory H_h_dzx0(0.0);\nHistory H_h_dzx1(0.0);\nHistory H_h_dzx2(0.0);\n\n// ---------- helpers ----------\n// TPT one-pole lowpass. returns lp, new_state\nf_op(x, s, G) {\n\tv = (x - s) * G;\n\tlp = v + s;\n\treturn lp, lp + v;\n}\n\n// secant gain of tanh: tanh(v)/v  (1 at v=0)\nf_tg(v) {\n\ta = abs(v);\n\tr = 1 - a * a * 0.333333333;\n\tif (a > 0.001) {\n\t\tr = tanh(v) / v;\n\t}\n\treturn r;\n}\n\n// secant gain of an asymmetric diode-like curve with unit slope at 0\n// curve: (tanh(v + b) - tanh(b)) / (1 - tanh(b)^2), b = 0.35\nf_dg(v) {\n\ta = abs(v);\n\tr = 1 - 0.3363755443363322 * v;\n\tif (a > 0.001) {\n\t\tr = (tanh(v + 0.35) - 0.3363755443363322) / (v * 0.8868514931724362);\n\t}\n\treturn max(r, 0);\n}\n\n// secant gain of algebraic hard-knee sigmoid v/sqrt(1+v^2)\n// v1.6: Steiner diode-string conductance secant (Electronic Design, 6 Dec 1974). The string is fed in mirror\n// from both ends, so signal current runs against the bias in one half and with it in the other:\n// i = 2I sinh(v/V'), and conductance RISES with level (even orders cancel). The 2k feed resistors in series\n// bound it: secant = (1 + rho) / (1 / (sinh(a)/a) + rho), rho = 2 pi fc 4.7nF 2k (1 at small signal).\nf_sg(v, rho) {\n\ta = min(abs(v), 20);\n\tt = a > 0.0001 ? (exp(a) - exp(-a)) * 0.5 / a : 1 + a * a * 0.166666667;\n\treturn (1 + rho) / (1 / t + rho);      // normalised: exactly 1 at small signal\n}\n\nf_ag(v) {\n\treturn 1 / sqrt(1 + v * v);\n}\n\n// asymmetric soft clip with unit slope at 0\nf_asym(x) {\n\treturn (tanh(x + 0.35) - 0.3363755443363322) / 0.8868514931724362;\n}\n\n// ---------- TPT state-variable filter (Zavalishin) ----------\n// returns hp, bp, lp, new_s1, new_s2\nf_svf(x, s1, s2, g, R) {\n\th = (x - (2 * R + g) * s1 - s2) / (1 + 2 * R * g + g * g);\n\tb = g * h + s1;\n\tl = g * b + s2;\n\treturn h, b, l, g * h + b, g * b + l;\n}\n\n// ---------- 4x4 tridiagonal solve (Thomas algorithm) ----------\n// rows: [B1 C1 . .], [A2 B2 C2 .], [. A3 B3 C3], [. . A4 B4]\nf_tri4(d1, d2, d3, d4, B1, C1, A2, B2, C2, A3, B3, C3, A4, B4) {\n\tc1 = C1 / B1;\n\te1 = d1 / B1;\n\tm2 = B2 - A2 * c1;\n\tc2 = C2 / m2;\n\te2 = (d2 - A2 * e1) / m2;\n\tm3 = B3 - A3 * c2;\n\tc3 = C3 / m3;\n\te3 = (d3 - A3 * e2) / m3;\n\ty4 = (d4 - A4 * e3) / (B4 - A4 * c3);\n\ty3 = e3 - c3 * y4;\n\ty2 = e2 - c2 * y3;\n\ty1 = e1 - c1 * y2;\n\treturn y1, y2, y3, y4;\n}\n\n// ================= MODEL 01: Sherman Filterbank-inspired =================\n// No schematic is public. Structure follows the published description: input\n// overdrive stage -> filter 1 -> filter 2 in series (24 dB when tuned equal),\n// filter 2 more resonant than filter 1. Plus a saturated feedback path\n// (output -> input, unit delay) for the Filterbank's howl.\n// R1: filter-1 damping (mild); Rt: filter-2 damping (to self-oscillation).\n// ti: 0 = filter 2 alone (12 dB), 1 = filter 1 -> filter 2 (24 dB)\n// returns y, y, s1a, s2a, ba, s1b, s2b, bb, yprev\n// v1.6 Filterbank 2 manual features (behavioural; docs/independent-review/SHERMAN_MANUAL_CHECK.md):\n// panel modes (Lp/Bp/Hp balance + correction knob -Bp ... 0 ... -Bp+Lp+Hp), harmonics (filter 2 at f1/n,\n// series only), Limit (lower level into the filters after the overdrive, made up after; mechanism invented).\n// With pm = 0, g2 = g and lk = 1 the arithmetic is exactly the v1.5 model.\nf_shout(h, b, l, hp, pm, bal, cor) {\n\to = hp > 0.5 ? h : l;\n\tif (pm > 0.5) {\n\t\to = bal < 0.5 ? (1 - 2 * bal) * l + 2 * bal * b : (2 - 2 * bal) * b + (2 * bal - 1) * h;\n\t\to = cor < 0 ? o + cor * b : o + cor * (l + h - b);\n\t}\n\treturn o;\n}\n\n// v1.6 Sherman CLOCK (behavioural; all constants are assumptions): switched-capacitor filters run on a clock\n// fclk = SC_N x fc (SC_N = 100, the LTC1060 100:1 mode). While fclk < the engine rate, the filter updates only\n// on clock ticks with its fixed switched-capacitor coefficient tan(pi / SC_N) and holds its outputs in between\n// (staircase / stepping at low cutoff). Otherwise the continuous filter runs (same in-band response).\nf_svfclk(u, s1, s2, g, R, fr, ph, hh, hb, hl) {\n\th = hh; b = hb; l = hl; n1 = s1; n2 = s2;\n\tnp = ph + fr;\n\tif (np >= 1) {\n\t\tnp = np - floor(np);\n\t\th, b, l, n1, n2 = f_svf(u, s1, s2, 0.0314262660, R);\n\t}\n\treturn h, b, l, n1, n2, np;\n}\n\nf_sherman(x, s1a, s2a, ba, s1b, s2b, bb, yp, pa, pb, hha, hba, hla, hhb, hbb, hlb, eb, g, g2, R1, Rt, fb, ti, hp, pm, bal, cor, lk, ck, rel) {\n\tu = f_asym(1.6 * (x + fb * yp)) * 0.625;\n\tif (lk < 0.999) {\n\t\tu = u * lk;\n\t}\n\tRa = 1 - (1 - R1) * f_tg(ba);\n\tge = g + ti * (g2 - g);\n\tfra = 31.8309886 * atan(g);\n\tfrb = 31.8309886 * atan(ge);\n\tnpa = pa; npb = pb; ft = 0;\n\th1 = 0; b1 = 0; l1 = 0; n1a = s1a; n2a = s2a;\n\tif (ck > 0.5 && fra < 1) {\n\t\th1, b1, l1, n1a, n2a, npa = f_svfclk(u, s1a, s2a, g, Ra, fra, pa, hha, hba, hla);\n\t\tft = fra < 0.5 ? ft + sin(6.28318531 * npa) : ft;\n\t} else {\n\t\th1, b1, l1, n1a, n2a = f_svf(u, s1a, s2a, g, Ra);\n\t}\n\to1 = f_shout(h1, b1, l1, hp, pm, bal, cor);\n\ti2 = u + ti * (o1 - u);\n\th2 = hhb; b2 = hbb; l2 = hlb; n1b = s1b; n2b = s2b;\n\tgs = ge;\n\ttick = 1;\n\tif (ck > 0.5 && frb < 1) {\n\t\tgs = 0.0314262660;\n\t\tnpb = pb + frb;\n\t\ttick = npb >= 1 ? 1 : 0;\n\t\tnpb = npb - floor(npb);\n\t\tft = frb < 0.5 ? ft + sin(6.28318531 * npb) : ft;\n\t}\n\tif (tick > 0.5) {\n\t\tRb = 1 - (1 - Rt) / sqrt(1 + 2 * bb * bb + 2 * eb);\n\t\th2, b2, l2, n1b, n2b = f_svf(i2, s1b, s2b, gs, Rb);\n\t\t// v1.6: re-evaluate the amplitude-dependent damping at the CURRENT band value\n\t\t// (one fixed-point step). The lagged value alone lets the limiter sample an\n\t\t// oscillation near fs/4 at its zero crossings and pump it (period-2 parametric\n\t\t// instability, docs/independent-review/INDEPENDENT_AUDIT_REVIEW.md section 3.1).\n\t\tRb = 1 - (1 - Rt) / sqrt(1 + 2 * b2 * b2 + 2 * eb);\n\t\th2, b2, l2, n1b, n2b = f_svf(i2, s1b, s2b, gs, Rb);\n\t}\n\t// v1.6 resonance limiter (after the heRman FilterBank Reaktor reconstruction): half of filter 2's\n\t// amplitude-dependent damping now follows the band-pass power averaged over ~30 ms instead of the\n\t// instantaneous value, so a loud resonance stays held back for a moment. A plain one-pole average of b^2\n\t// (no abs, max or attack/release switch), so it adds no corners and no wideband distortion.\n\tebn = eb + rel * (b2 * b2 - eb);\n\to2 = f_shout(h2, b2, l2, hp, pm, bal, cor);\n\tif (lk < 0.999) {\n\t\to2 = o2 * 2.7;          // makeup (not 1/lk): keeps the output level within ~1.5 dB of Limit off\n\t}\n\tif (ck > 0.5) {\n\t\to2 = o2 + 0.0005 * ft;  // clock feedthrough (-66 dBFS per filter, assumed): the manual's low-frequency \"eee\"\n\t}\n\tynext = tanh(o2);\n\treturn o2, o2, fixdenorm(n1a), fixdenorm(n2a), b1, fixdenorm(n1b), fixdenorm(n2b), b2, ynext, npa, npb, h1, b1, l1, h2, b2, l2, fixdenorm(ebn);\n}\n\n// ================= MODEL 02: Korg 35 / MS-20, OTA (LM13600, \"Mk2\") circuit =================\n// v1.6: relabelled. Stinchcombe 2006 shows this structure (two buffered one-poles, 1/(s^2+(2-K)s+1),\n// clipping in the feedback path) is the later OTA circuit, not the original Korg35 (see f_k35m1).\n// Sallen-Key style: LP1 -> sum -> LP2 -> y ; y*K -> HP1 -> sum   (lowpass)\n//                   HP1 -> sum -> HP2 -> y ; y*K -> LP1 -> sum   (highpass)\n// Zero-delay-feedback solve, tanh in the loop, and diode-style limiting of\n// the feedback gain K (secant of tanh at level L, from previous output).\n// returns y, s1, s2, s3, yprev\nf_k35lp(x, s1, s2, s3, yp, g, K0, L) {\n\tG = g / (1 + g);\n\tig = 1 / (1 + g);\n\tK = K0 * f_tg(K0 * yp / L);\n\ty1, n1 = f_op(x, s1, G);\n\tu = (y1 + ig * (K * ig * s2 - s3)) / (1 - K * G * ig);\n\tu = 0.85 * tanh(u * 1.17647058824);\n\ty, n2 = f_op(u, s2, G);\n\tl3, n3 = f_op(K * y, s3, G);\n\treturn y, fixdenorm(n1), fixdenorm(n2), fixdenorm(n3), y;\n}\n\n// v1.6: the MS-20 high-pass as built (Stinchcombe 2006, section 7): the low-pass input is grounded and the\n// signal drives the lifted end of stage 2's capacitor, so  y = x + LP2(u - x),  u = HP1(K * y).\n// Transfer function s(s + 1) / (s^2 + (2 - K)s + 1): a 12 dB high-pass plus a band-pass term, so the\n// slope below cutoff is 6 dB/oct (v1.5 used s^2/(...), 12 dB/oct). s1 is unused.\nf_k35hp(x, s1, s2, s3, yp, g, K0, L) {\n\tG = g / (1 + g);\n\tig = 1 / (1 + g);\n\tK = K0 * f_tg(K0 * yp / L);\n\t// The input reaches the output through stage 2's capacitor, so the passband is clean in the circuit.\n\t// The OTA saturation is kept on the feedback signal, as in v1.5. (Saturating stage 2's differential\n\t// input instead was tried and rejected: it detuned self-oscillation by up to +39 cents and let it\n\t// reach +4 dBFS, for no passband benefit.)\n\ty = ig * (x - G * s3 + s2) / (1 - K * G * ig);\n\tu = ig * (K * y - s3);\n\tu = 0.85 * tanh(u * 1.17647058824);\n\tl2, n2 = f_op(u - x, s2, G);\n\ty = x + l2;\n\tl3, n3 = f_op(K * y, s3, G);\n\treturn y, fixdenorm(s1), fixdenorm(n2), fixdenorm(n3), y;\n}\n\n// ================= MODEL 02b: Korg35 (MS-10 / early MS-20, \"Mk1\") Sallen-Key =================\n// v1.6, from Stinchcombe 2006 (Figures 1, 3, 17; sections 2.2, 5, 7). Sallen-Key low-pass with C1 = 3 C2 and\n// R1 = R2/3 (the study's assumption; equal section frequencies): 1 / (s^2 + (7/3 - k)s + 1).\n// Forward-path X1 stage: gain 1 + 270k/4.7k = 58.45 with back-to-back diodes across 270k, so it is\n// v = Vf/57.45 + c sinh(Vf/nVt) with Vo = v + Vf (Fig. 17 fit: nVt = 52 mV, c = 1.617e-5 V).\n// Units are volts: x * A is the voltage at the core input (A = 5 V peak per unit x R59/(R57+R59), times\n// CHARACTER drive; output makeup follows Drive's level compensation). HP variant (section 7): signal into C2's lifted end, k1 s(s + 4/3) / (same).\n// Each sample is one scalar monotone equation in Vf, solved by four step-limited Newton iterations from a\n// closed-form start (offline worst relative residual 1.2e-5, about -98 dB; tests/review/ms20/solver.py). returns y, s1, s2, Vf, yprev\nf_k35m1(x, s1, s2, s3, yp, g, K0, A, Am, hp) {\n\tk2 = K0 * 0.0203116;          // (7/6) K0 / 57.4385 (small-signal X1 gain incl. diode leakage, Fig. 17 fit)\n\txin = x * A;\n\txl = hp > 0.5 ? 0 : xin;\n\txh = hp > 0.5 ? xin : 0;\n\tD = 1 + 1.33333333333 * g;\n\tE = (1 + g) - g * g / (3 * D);\n\tAa = (s2 + xh + g * (s1 + g * xl) / D) / E;\n\tB = g * k2 / (D * E);\n\tvt = Aa / (1 - B);\n\tav = abs(vt);\n\tV = (vt < 0 ? -1 : 1) * min(av * 57.4468, 0.052 * log(av / 0.00001617 + sqrt(av * av / 0.000000000261469 + 1)));\n\tfor (i = 0; i < 4; i += 1) {\n\t\tex = exp(V * 19.2307692308);\n\t\tfv = (1 - B) * (V * 0.0174074 + 0.00001617 * 0.5 * (ex - 1 / ex)) - B * V - Aa;\n\t\tdv = (1 - B) * (0.0174074 + 0.000310962 * 0.5 * (ex + 1 / ex)) - B;\n\t\tV = V - clamp(fv / dv, -0.05, 0.05);\n\t}\n\tex = exp(V * 19.2307692308);\n\tv3 = V * 0.0174074 + 0.00001617 * 0.5 * (ex - 1 / ex);\n\tvo = v3 + V;\n\tv2 = (s1 + g * xl + 0.333333333333 * g * v3 + k2 * vo) / D;\n\tn1 = 2 * (v2 - k2 * vo) - s1;\n\tn2 = 2 * (v3 - xh) - s2;\n\ty = vo / Am;\n\treturn y, fixdenorm(n1), fixdenorm(n2), V, y;\n}\n\n// ================= MODEL 03: Moog transistor ladder-inspired =================\n// Circuit: each ladder stage is a transistor differential pair loaded by a\n// capacitor, so each stage obeys  dy_i/dt = w (tanh(y_{i-1}) - tanh(y_i)),\n// driven by the input pair tanh(x - k y4)  (Huovilainen, DAFx-04).\n// Solved here with zero-delay feedback: every tanh is replaced by its secant\n// gain at the previous sample (T = tanh(v)/v), which makes each stage\n// linear for the current sample, so the global feedback is solved exactly.\n// hs scales the stage pairs' saturation (CHARACTER: STAGE SAT).\n// v1.6, Minimoog Model D filter board (service manual fig. 9-11): the ladder's top nodes are AC-coupled\n// (C5/C1 0.22 uF into 47k: 15.4 Hz) into the \"gain recovery\" pair Q7/Q5, an undegenerated differential\n// pair (tanh at the ladder's own 2 V_T scale). Emphasis is taken from that amplifier through C10 (10 uF)\n// and the R14 rheostat, so the feedback loop holds both high-passes and the output pair's saturation.\n// returns y12, y24, s1..s4, p0..p4, h1, h2, pz\nf_ladder(x, s1, s2, s3, s4, p0, p1, p2, p3, p4, h1, h2, pz, g, k, bc, hs, hp, ga, gb) {\n\tT0 = f_tg(1.4 * p0);\n\tT1 = f_tg(1.4 * hs * p1);\n\tT2 = f_tg(1.4 * hs * p2);\n\tT3 = f_tg(1.4 * hs * p3);\n\tT4 = f_tg(1.4 * hs * p4);\n\ti1 = 1 / (1 + g * T1);\n\ti2 = 1 / (1 + g * T2);\n\ti3 = 1 / (1 + g * T3);\n\ti4 = 1 / (1 + g * T4);\n\tG1 = g * T0 * i1;\n\tG2 = g * T1 * i2;\n\tG3 = g * T2 * i3;\n\tG4 = g * T3 * i4;\n\tS = G2 * G3 * G4 * s1 * i1 + G3 * G4 * s2 * i2 + G4 * s3 * i3 + s4 * i4;\n\tP = G1 * G2 * G3 * G4;\n\tGa = ga / (1 + ga);\n\tGb = gb / (1 + gb);\n\tc1 = 1 - Ga;\n\tc2 = 1 - Gb;\n\t// output-pair secant: lagged estimate, then one re-solve at the current value (the lag alone\n\t// detunes self-oscillation at high cutoffs). The HP ALT pole-mix is not a Minimoog: no output pair there.\n\tT5 = hp > 0.5 ? 1 : f_tg(1.4 * pz);\n\tu = (x * (1 + k * bc) - k * c2 * (T5 * c1 * (S - h1) - h2)) / (1 + k * c2 * T5 * c1 * P);\n\tif (hp < 0.5) {\n\t\tT5 = f_tg(1.4 * (c1 * (P * u + S - h1)));\n\t\tu = (x * (1 + k * bc) - k * c2 * (T5 * c1 * (S - h1) - h2)) / (1 + k * c2 * T5 * c1 * P);\n\t}\n\ty1 = G1 * u + s1 * i1;\n\ty2 = G2 * y1 + s2 * i2;\n\ty3 = G3 * y2 + s3 * i3;\n\ty4 = G4 * y3 + s4 * i4;\n\tva = (y4 - h1) * Ga;\n\tz = y4 - (va + h1);          // C5/C1 coupling (15.4 Hz)\n\tw = T5 * z;                  // gain-recovery pair Q7/Q5\n\tvb = (w - h2) * Gb;          // C10 coupling into the Emphasis rheostat\n\to12 = tanh(1.4 * y2) * 0.714285714;   // the 12 dB tap (not on a Minimoog) through the same output pair\n\to24 = w;\n\tif (abs(y4) + abs(y2) > 1000000) {   // numerical fault: pass the raw state so fault containment sees it\n\t\to12 = y2;\n\t\to24 = y4;\n\t}\n\t// HP: Moog 904B (R. A. Moog drawing 1118, 6/23/70): four C-R high-pass sections in series (0.39 uF coupling\n\t// capacitors into the transistor stages), no regeneration path, so k = 0 and the binomial pole-mix of the\n\t// four-pole core is exactly (s/(s+1))^4. Input attenuated ~1:111 (R15 33k / R16 300) before the stages and\n\t// restored by the audio amp (68k / 510), so the stages stay near-linear; overall gain ~1.2 (not modelled).\n\tif (hp > 0.5) {\n\t\to12 = u - 2 * y1 + y2;\n\t\to24 = u - 4 * y1 + 6 * y2 - 4 * y3 + y4;\n\t}\n\treturn o12, o24, fixdenorm(2 * y1 - s1), fixdenorm(2 * y2 - s2), fixdenorm(2 * y3 - s3), fixdenorm(2 * y4 - s4), u, y1, y2, y3, y4, fixdenorm(va * 2 + h1), fixdenorm(vb * 2 + h2), z;\n}\n\n// ================= MODEL 07: ARP 2600 VCF (4012 module) =================\n// ARP 4012 voltage-controlled low-pass (ARP Instruments 1970; module schematic redrawn by J. Verghese 1997,\n// supplied by the user) in the 2600 (service manual, Board 3, also supplied):\n//  - input: Q1/Q2 pair, emitter-degenerated (R8/R9 3.32k, tail R10 56k): linear to about 0.6 V, then a hard\n//    limit at about 0.85 V (\"signal limiter\"); drives the ladder's bottom pair Q6/Q7. Audio enters pin 1 through\n//    100k into R11 220R (x0.00218); the resonance feedback enters pin 2 through the slider + 150k into R12 2k2.\n//  - Moog-type ladder: four matched TZ-81 pairs (Q6-Q15), C1-C4 0.01 uF, bias string R1-R5; output across the top\n//    capacitor C4 through a dual-FET buffer (Q17) and a level shifter (Q18/Q19, Q20) into an LM301A\n//    differential amplifier (A1, +/-15 V). DC-coupled throughout: no coupling capacitors in the loop.\n// Level: 1 model unit = 5 V (the 2600's 10 V p-p audio); the ladder state p is in units of 2 V_T / 1.4 as in\n// the ladder model, so the input scale 0.608 per stage unit (x 0.25 at Drive 0) puts 11 mV per 5 V into the pair.\n// The output amplifier is calibrated for unity gain from one 100k input (GAIN trim; assumed) and clips at\n// about +/-13 V (2.6 audio units; the stage runs at 0.25 x audio at Drive 0, so 0.65 stage units). returns y, s1..s4, p0..p4\nf_arp4012(x, s1, s2, s3, s4, p0, p1, p2, p3, p4, g, k, bc, hs) {\n\tT0 = f_tg(1.4 * p0);\n\tT1 = f_tg(1.4 * hs * p1);\n\tT2 = f_tg(1.4 * hs * p2);\n\tT3 = f_tg(1.4 * hs * p3);\n\tT4 = f_tg(1.4 * hs * p4);\n\ti1 = 1 / (1 + g * T1);\n\ti2 = 1 / (1 + g * T2);\n\ti3 = 1 / (1 + g * T3);\n\ti4 = 1 / (1 + g * T4);\n\tG1 = g * T0 * i1;\n\tG2 = g * T1 * i2;\n\tG3 = g * T2 * i3;\n\tG4 = g * T3 * i4;\n\tS = G2 * G3 * G4 * s1 * i1 + G3 * G4 * s2 * i2 + G4 * s3 * i3 + s4 * i4;\n\tP = G1 * G2 * G3 * G4;\n\txi = 0.608 * x * (1 + k * bc);\n\tu = (xi - k * S) / (1 + k * P);\n\ty1 = G1 * u + s1 * i1;\n\ty2 = G2 * y1 + s2 * i2;\n\ty3 = G3 * y2 + s3 * i3;\n\ty4 = G4 * y3 + s4 * i4;\n\t// one re-solve with the pair secants at the current solution (k reaches 6.6 here; the lagged secants\n\t// alone overshoot to about +11 dBFS near fs/4 at 1x)\n\tT0 = f_tg(1.4 * u);\n\tT1 = f_tg(1.4 * hs * y1);\n\tT2 = f_tg(1.4 * hs * y2);\n\tT3 = f_tg(1.4 * hs * y3);\n\tT4 = f_tg(1.4 * hs * y4);\n\ti1 = 1 / (1 + g * T1);\n\ti2 = 1 / (1 + g * T2);\n\ti3 = 1 / (1 + g * T3);\n\ti4 = 1 / (1 + g * T4);\n\tG1 = g * T0 * i1;\n\tG2 = g * T1 * i2;\n\tG3 = g * T2 * i3;\n\tG4 = g * T3 * i4;\n\tS = G2 * G3 * G4 * s1 * i1 + G3 * G4 * s2 * i2 + G4 * s3 * i3 + s4 * i4;\n\tP = G1 * G2 * G3 * G4;\n\tu = (xi - k * S) / (1 + k * P);\n\ty1 = G1 * u + s1 * i1;\n\ty2 = G2 * y1 + s2 * i2;\n\ty3 = G3 * y2 + s3 * i3;\n\ty4 = G4 * y3 + s4 * i4;\n\to = 0.65 * tanh(y4 * 2.53036);          // A1 at its rails: +/-13 V = 2.6 audio units = 0.65 stage units (x 0.25 at Drive 0)\n\tif (abs(y4) > 1000000) {\n\t\to = y4;\n\t}\n\treturn o, fixdenorm(2 * y1 - s1), fixdenorm(2 * y2 - s2), fixdenorm(2 * y3 - s3), fixdenorm(2 * y4 - s4), u, y1, y2, y3, y4;\n}\n\n// ================= MODEL 04: Steiner-Parker Synthacon-inspired =================\n// Circuit (Steiner, Electronic Design 25, 1974; CGS35 notes): a Sallen-Key\n// network whose two resistors are biased diode strings (voltage-controlled\n// resistors), with Q set by the gain K of a non-inverting amplifier\n// (self-oscillation at K = 3, Q constant while sweeping). LP, BP and HP are\n// obtained by injecting the signal at three different points of the SAME\n// network:  xl -> R1 (LP),  xb -> feedback node of C1 (BP),  xh -> C2 (HP).\n// Linear: H_LP = K/D, H_BP = K s/D, H_HP = K s(s+2)/D,  D = s^2 + (3-K)s + 1.\n// Nonlinear: diode-string currents saturate (tanh secant of the voltage\n// across each string), the amplifier clips (hard-knee sigmoid secant on K).\n// Zero-delay 2x2 trapezoidal solve per sample.\n// returns y, s1, s2, d1, d2, vb\n// one linear solve of the Sallen-Key network for given element secants t1, t2 and amp gain Ke\nf_stsolve(xl, xb, xh, s1, s2, t1, t2, Ke, g) {\n\ta11 = 1 + g * (t1 + t2);\n\ta12 = -g * (t1 * Ke + t2 * (Ke - 1));\n\ta21 = g * t2;\n\ta22 = 1 - g * t2 * (Ke - 1);\n\tc2 = g * t2 * ((Ke - 1) * xh + xb);\n\tb1 = g * t1 * (Ke * xh + xb - xl) + c2 + s1;\n\tb2 = c2 + s2;\n\tidet = 1 / (a11 * a22 - a12 * a21);\n\tq1 = (b1 * a22 - a12 * b2) * idet;\n\tq2 = (a11 * b2 - a21 * b1) * idet;\n\tvB = q2 + xh;\n\tvA = Ke * vB + xb - q1;\n\treturn q1, q2, vA, vB;\n}\n\nf_steiner(xl, xb, xh, s1, s2, d1p, d2p, vbp, g, K, rho) {\n\t// argument: one model unit = the article's 0 dBm input at the LP node (1.1 V pk / 48 = 22.9 mV);\n\t// V' = 2 n Vt = 98 mV per diode pair, so a = d * 0.233.\n\tt1 = f_sg(d1p * 0.233, rho);\n\tt2 = f_sg(d2p * 0.233, rho);\n\tKe = K * f_ag(K * vbp * 0.7);\n\tq1, q2, vA, vB = f_stsolve(xl, xb, xh, s1, s2, t1, t2, Ke, g);\n\t// v1.6: re-evaluate the diode-string secants and amplifier limit at the current\n\t// solution (one fixed-point step) - removes the fs/4 overshoot (+30 dBFS) of v1.5.\n\tt1 = f_sg((xl - vA) * 0.233, rho);\n\tt2 = f_sg((vA - vB) * 0.233, rho);\n\tKe = K * f_ag(K * vB * 0.7);\n\tq1, q2, vA, vB = f_stsolve(xl, xb, xh, s1, s2, t1, t2, Ke, g);\n\treturn Ke * vB, fixdenorm(2 * q1 - s1), fixdenorm(2 * q2 - s2), xl - vA, vA - vB, vB;\n}\n\n// ================= MODEL 05: Oberheim SEM-inspired =================\n// Circuit: 2-pole state-variable filter whose integrators are CA3080 OTAs\n// driving capacitors; an OTA's output current is gm*tanh(vin/2Vt), so each\n// integrator's input saturates. Damping (resonance pot) never reaches zero:\n// no self-oscillation. Mode knob mixes LP and HP (notch at the centre).\n// Secant-linearised OTA gains (g1, g2) inside a zero-delay SVF solve.\n// m: LP->notch (LPF stage) or HP->notch (HPF stage)\n// returns y, s1, s2, hprev, bprev\n// SEM op-amp / buffer rails: +-13 V = 2.6 units at 5 V/unit, sharp knee (|x| = 0.5 -> error ~1e-7)\nf_rail(x) {\n\tr = x * 0.384615385;\n\tr = r * r; r = r * r; r = r * r;\n\treturn x / sqrt(sqrt(sqrt(1 + r)));\n}\n\n// SEM D11/D12 limiter: extra half-damping 0.5 * 0.926 * smoothmax(0, 0.175 |BP| - 0.45 V) / |BP|, BP in volts (5 V/unit)\nf_semd(bp) {\n\tbv = abs(bp) * 5 + 0.000001;\n\tex = 0.175 * bv - 0.45;\n\tsm = 0.5 * (ex + sqrt(ex * ex + 0.0004)) - 0.000222;      // smooth max(0, ex), exactly 0 at bv = 0\n\treturn 0.463 * max(sm, 0) / bv;\n}\n\nf_sem(x, s1, s2, hpp, bpp, g, R, m, hp) {\n\t// v1.6 (Oberheim SEM-1A schematic): the input summer A12 is a linear op-amp stage (the old 2*tanh(x/2)\n\t// had no circuit origin). Damping 2R comes from the RES pot (linear) plus the D11/D12 limiter: buffered BP ->\n\t// 47k/10k (x0.175) -> antiparallel 1N4148 -> 100k into the summer, adding damping once |BP| > ~2.6 V\n\t// (level reference 5 V per unit). Evaluated at the lagged BP, then re-solved at the current BP.\n\tu = x;\n\tg1 = g * f_tg(hpp * 0.6);\n\tg2 = g * f_tg(bpp * 0.6);\n\tRt = R + f_semd(bpp);\n\th = (u - (2 * Rt + g2) * s1 - s2) / (1 + 2 * Rt * g1 + g1 * g2);\n\tb = g1 * h + s1;\n\tRt = R + f_semd(b);\n\th = f_rail((u - (2 * Rt + g2) * s1 - s2) / (1 + 2 * Rt * g1 + g1 * g2));\n\tb = f_rail(g1 * h + s1);\n\tl = f_rail(g2 * b + s2);\n\ty = hp > 0.5 ? h + m * l : l + m * h;\n\treturn y, fixdenorm(2 * b - s1), fixdenorm(2 * l - s2), h, b;\n}\n\n// ================= MODEL 06: Roland TB-303-inspired (diode ladder) =================\n// Circuit (Stinchcombe 2008, \"TB-303 configuration\": one diode at the top of\n// the ladder, bottom capacitor C/2): current-driven 4-node RC ladder whose\n// rungs are diode pairs. Linear core:\n//   0.5 v1' = u - (v1-v2);  v2' = (v1-v2)-(v2-v3);  v3' = (v2-v3)-(v3-v4);\n//   v4' = (v3-v4) - v4\n// -> denominator s^4 + 6.727 s^3 + 14.142 s^2 + 9.514 s + 1 (after scaling),\n// self-oscillation at k = 17, w = sqrt(2). Feedback drives the input pair\n// through a one-pole highpass (as in the 303). Nonlinear: input pair tanh,\n// each diode rung's conductance follows the tanh secant of its voltage.\n// returns y, s1..s4, v1..v4, sf, sc\nf_diode(x, s1, s2, s3, s4, v1p, v2p, v3p, v4p, sf, sc, g, k, Gf, bc) {\n\tt1 = f_tg(0.5 * (v1p - v2p));\n\tt2 = f_tg(0.5 * (v2p - v3p));\n\tt3 = f_tg(0.5 * (v3p - v4p));\n\tt4 = f_tg(0.5 * v4p);\n\tB1 = 1 + 2 * g * t1;\n\tC1 = -2 * g * t1;\n\tA2 = -g * t1;\n\tB2 = 1 + g * (t1 + t2);\n\tC2 = -g * t2;\n\tA3 = -g * t2;\n\tB3 = 1 + g * (t2 + t3);\n\tC3 = -g * t3;\n\tA4 = -g * t3;\n\tB4 = 1 + g * (t3 + t4);\n\ta1, a2, a3, a4 = f_tri4(2 * g, 0, 0, 0, B1, C1, A2, B2, C2, A3, B3, C3, A4, B4);\n\tb1, b2, b3, b4 = f_tri4(s1, s2, s3, s4, B1, C1, A2, B2, C2, A3, B3, C3, A4, B4);\n\txi = tanh(x);\n\tlc, nsc = f_op(xi, sc, Gf);\n\txc = xi + k * bc * (xi - lc);\n\tigf = 1 - Gf;\n\tu = (xc - k * igf * (b4 - sf)) / (1 + k * igf * a4);\n\tu = 2 * tanh(0.5 * u);\n\ty1 = b1 + u * a1;\n\ty2 = b2 + u * a2;\n\ty3 = b3 + u * a3;\n\ty4 = b4 + u * a4;\n\tlf, nsf = f_op(y4, sf, Gf);\n\treturn y4, fixdenorm(2 * y1 - s1), fixdenorm(2 * y2 - s2), fixdenorm(2 * y3 - s3), fixdenorm(2 * y4 - s4), y1, y2, y3, y4, fixdenorm(nsf), fixdenorm(nsc);\n}\n\n// ---------- 2x polyphase IIR half-band (5+5 first-order allpasses) ----------\n// one allpass chain step: returns y, z0..z5 (z0 = x[n-1] of section 1, zi = y[n-1] of section i)\nf_ap5(x, z0, z1, z2, z3, z4, z5, c1, c2, c3, c4, c5) {\n\ty1 = c1 * (x - z1) + z0;\n\ty2 = c2 * (y1 - z2) + z1;\n\ty3 = c3 * (y2 - z3) + z2;\n\ty4 = c4 * (y3 - z4) + z3;\n\ty5 = c5 * (y4 - z5) + z4;\n\treturn y5, x, y1, y2, y3, y4, y5;\n}\n\n\n// ======================= BAND-PASS ENGINE (v1.2) =======================\n// Secant gain of the model's nonlinear element (rg selects the curve):\n//   0: tanh (OTA, transistor pair, diode pair)   1: hard-knee amplifier clip\nf_bsat(v, rg) {\n\treturn rg > 0.5 ? f_ag(v) : f_tg(v);\n}\n\n// SVF section with saturating integrators (element secants from the previous\n// sample's integrator inputs). Affine form: every output = a * x + b for the\n// current sample, used to solve the regeneration loop with zero delay.\n// returns ah, bh, ab, bb, al, bl\nf_bsva(s1, s2, hq, bq, g, R, sc) {\n\tg1 = g * f_tg(sc * hq);\n\tg2 = g * f_tg(sc * bq);\n\tiD = 1 / (1 + 2 * R * g1 + g1 * g2);\n\tbh = -((2 * R + g2) * s1 + s2) * iD;\n\tab = g1 * iD;\n\tbb = g1 * bh + s1;\n\treturn iD, bh, ab, bb, g2 * ab, g2 * bb + s2;\n}\n\n// same section, state update for a known input. returns h, b, l, s1, s2\nf_bsvs(x, s1, s2, hq, bq, g, R, sc) {\n\tg1 = g * f_tg(sc * hq);\n\tg2 = g * f_tg(sc * bq);\n\th = (x - (2 * R + g2) * s1 - s2) / (1 + 2 * R * g1 + g1 * g2);\n\tb = g1 * h + s1;\n\tl = g2 * b + s2;\n\treturn h, b, l, fixdenorm(2 * b - s1), fixdenorm(2 * l - s2);\n}\n\n// 4-pole ladder core (MULTIMODE). Element type typ: 0 = difference-type\n// (dy/dt = w f(in - y): OTA / diode rung / transconductor), 1 = separate-type\n// (dy/dt = w (f(in) - f(y)): transistor differential pairs). Global feedback\n// u = x - k*y4 solved with zero delay; band-pass by pole mixing:\n//   BP4 = 4 (y2 - 2 y3 + y4) = 4 s^2 / ((1+s)^4 + k)      (narrow, 12 dB/oct skirts)\n//   BP2 = 2 (y1 - y2)        = 2 s (1+s)^2 / ((1+s)^4 + k) (wide, 6 dB/oct skirts)\n// wb crossfades BP4 -> BP2. returns y, s1..s4, p0..p4\nf_bmm(x, s1, s2, s3, s4, p0, p1, p2, p3, p4, g, k, typ, sc, wb) {\n\td1 = f_tg(sc * (p0 - p1));\n\td2 = f_tg(sc * (p1 - p2));\n\td3 = f_tg(sc * (p2 - p3));\n\td4 = f_tg(sc * (p3 - p4));\n\tti1 = typ > 0.5 ? f_tg(sc * p0) : d1;\n\tti2 = typ > 0.5 ? f_tg(sc * p1) : d2;\n\tti3 = typ > 0.5 ? f_tg(sc * p2) : d3;\n\tti4 = typ > 0.5 ? f_tg(sc * p3) : d4;\n\tto1 = typ > 0.5 ? f_tg(sc * p1) : d1;\n\tto2 = typ > 0.5 ? f_tg(sc * p2) : d2;\n\tto3 = typ > 0.5 ? f_tg(sc * p3) : d3;\n\tto4 = typ > 0.5 ? f_tg(sc * p4) : d4;\n\ti1 = 1 / (1 + g * to1);\n\ti2 = 1 / (1 + g * to2);\n\ti3 = 1 / (1 + g * to3);\n\ti4 = 1 / (1 + g * to4);\n\tG1 = g * ti1 * i1;\n\tG2 = g * ti2 * i2;\n\tG3 = g * ti3 * i3;\n\tG4 = g * ti4 * i4;\n\tS = G2 * G3 * G4 * s1 * i1 + G3 * G4 * s2 * i2 + G4 * s3 * i3 + s4 * i4;\n\tu = (x - k * S) / (1 + k * G1 * G2 * G3 * G4);\n\tu = 0.35 * tanh(u * 2.857142857);\n\ty1 = G1 * u + s1 * i1;\n\ty2 = G2 * y1 + s2 * i2;\n\ty3 = G3 * y2 + s3 * i3;\n\ty4 = G4 * y3 + s4 * i4;\n\tbp4 = 4 * (y2 - 2 * y3 + y4);\n\tbp2 = 2 * (y1 - y2);\n\ty = bp4 + wb * (bp2 - bp4);\n\treturn y, fixdenorm(2 * y1 - s1), fixdenorm(2 * y2 - s2), fixdenorm(2 * y3 - s3), fixdenorm(2 * y4 - s4), u, y1, y2, y3, y4;\n}\n\n// v1.6: ARP 2600 band-pass on the 4012 core (the LPF engine's f_arp4012 ladder: matched pairs, DC-coupled,\n// Board 3 resonance law, secant re-solve), band-pass taken by pole mixing as in MULTIMODE (the 2600 has no\n// band-pass output: still \"derived\"). Input / output in the 4012's level convention (0.608 per unit, rail 0.65 stage units = 13 V).\n// returns y, s1..s4, p0..p4\nf_barp(x, s1, s2, s3, s4, p0, p1, p2, p3, p4, g, k, wb) {\n\to, n1, n2, n3, n4, u, y1, y2, y3, y4 = f_arp4012(x, s1, s2, s3, s4, p0, p1, p2, p3, p4, g, k, 0, 1);\n\tbp4 = 4 * (y2 - 2 * y3 + y4);\n\tbp2 = 2 * (y1 - y2);\n\t// the 2600 has no band-pass: the derived pole-mix runs 12 dB above the 4-pole output at oscillation, so its\n\t// output stage is limited at 0.3 stage units (+1.6 dBFS at Drive 0), the level of the module's own\n\t// oscillation (LPF 07: +1.4 dBFS), instead of at the 13 V rail\n\ty = 0.3 * tanh((bp4 + wb * (bp2 - bp4)) * 5.48245614);   // / 0.608 (ladder units) / 0.3\n\treturn y, n1, n2, n3, n4, u, y1, y2, y3, y4;\n}\n\n// v1.6: analogue magnitude of a 1-pole HP at normalised frequency rho (MS-20 HPF, Stinchcombe)\nf_bmag1(rho) {\n\treturn rho / sqrt(1 + rho * rho);\n}\n\n// analogue magnitude of a 2-pole HP (hp=1) or LP (hp=0) at normalised frequency rho\nf_bmag(rho, Q, hp) {\n\tm = 1 / sqrt((1 - rho * rho) * (1 - rho * rho) + rho * rho / (Q * Q));\n\treturn hp > 0.5 ? m * rho * rho : m;\n}\n\n\n// ======================= DYNAMICS CHAIN (v1.3) =======================\n// Triode-stage transfer: asymmetric (grid conduction on the positive side is\n// harder), unit slope at 0 -> even + odd harmonics.\nf_tsh(v) {\n\treturn v > 0 ? tanh(1.25 * v) * 0.8 : tanh(0.85 * v) * 1.176470588235;\n}\n// biased stage, idle point removed, small-signal gain normalised by ib\nf_tube(x, b, ib) {\n\treturn (f_tsh(x + b) - f_tsh(b)) * ib;\n}\n// API-style gain computer (dB in -> gain change in dB, <= 0); slope = 1/R - 1, W = knee width\nf_gc(lv, thr, slope, W) {\n\to = lv - thr;\n\tr = 0;\n\tif (2 * o > W) {\n\t\tr = slope * o;\n\t} else if (2 * o > -W) {\n\t\tr = slope * (o + 0.5 * W) * (o + 0.5 * W) / (2 * W);\n\t}\n\treturn r;\n}\n\n// ======================= MAIN =======================\nfs = samplerate;\ncur_order = H_cur_order;\ncur_os = H_cur_os;\ncur_tos = H_cur_tos;\ncur_k35 = H_cur_k35;\nsh_pm = sh_mode > 0.5 ? 1 : 0;\nsh_b = clamp(sh_bal * 0.01, 0, 1);\nsh_c = clamp(sh_corr * 0.01, -1, 1);\nsh_ht = (clamp(floor(sh_harm + 0.5), 0, 10) < 0.5 ? 0.0 : (clamp(floor(sh_harm + 0.5), 0, 10) < 1.5 ? 0.584962501 : (clamp(floor(sh_harm + 0.5), 0, 10) < 2.5 ? 1.0 : (clamp(floor(sh_harm + 0.5), 0, 10) < 3.5 ? 1.584962501 : (clamp(floor(sh_harm + 0.5), 0, 10) < 4.5 ? 2.0 : (clamp(floor(sh_harm + 0.5), 0, 10) < 5.5 ? 2.321928095 : (clamp(floor(sh_harm + 0.5), 0, 10) < 6.5 ? 2.584962501 : (clamp(floor(sh_harm + 0.5), 0, 10) < 7.5 ? 2.807354922 : (clamp(floor(sh_harm + 0.5), 0, 10) < 8.5 ? 3.0 : (clamp(floor(sh_harm + 0.5), 0, 10) < 9.5 ? 3.169925001 : 4.0))))))))));\nsh_lr = H_sh_lr + (sh_ht - H_sh_lr) * min(1, 300 / samplerate);\nsh_lr = abs(sh_lr - sh_ht) < 0.000001 ? sh_ht : sh_lr;\nsh_hr = exp2(sh_lr);\nsh_lk = sh_limit > 0.5 ? 0.25 : 1;\nsh_ck = sh_clock > 0.5 ? 1 : 0;\novs = cur_os < 0.5 ? 1 : (cur_os < 1.5 ? 2 : (cur_os < 2.5 ? 4 : (cur_os < 3.5 ? 8 : 16)));\nfso = fs * ovs;\na_cut = 1 - exp(-1 / (0.006 * fs));\na_par = 1 - exp(-1 / (0.015 * fs));\na_mix = 1 - exp(-1 / (0.010 * fs));\nfstep = 1 / (0.025 * fs);\ndstep = 1 / (0.004 * fs);\nx_L = in1;\nx_R = in2;\n// ================= v1.6 envelope filter (Mu-Tron III, 1975 schematic) =================\nef_ent = ef_on > 0.5 ? 1 : 0;\nef_en = H_ef_en + a_mix * (ef_ent - H_ef_en);\nif (ef_ent < 0.5 && ef_en < 0.0001) {\n\tef_en = 0;\n}\nif (ef_ent > 0.5 && ef_en > 0.9999) {\n\tef_en = 1;\n}\nef_mx = H_ef_mx + a_par * (clamp(ef_mix, 0, 100) * 0.01 - H_ef_mx);\nef_e = H_ef_e;\nef_ld = H_ef_ld;\nef_rl = 0;\nef_rh = 0;\nef_rb = 0;\nef_g = exp2(clamp(ef_gain, -18.4, 31.2) * 0.166096405);\nef_pL = 0;\nef_pR = 0;\nef_fr = 1000;\nif (ef_en > 0 || ef_to_l != 0 || ef_to_h != 0 || ef_to_b != 0) {\n\tef_pL = 7.5 * tanh(x_L * ef_g * 0.13333333333333333);      // A1 preamp, op-amp rails\n\tef_pR = 7.5 * tanh(x_R * ef_g * 0.13333333333333333);\n\tef_up = ef_sweep < 0.5 ? 1 : 0;\n\tef_tg = min(max(max(ef_pL, ef_pR), 0) * (ef_up > 0.5 ? 45.4545455 : 128.787879), 7.5);   // A5 half-wave, 1M/22k or 1M/(22k||12k)\n\tef_tc = clamp(ef_att, 0.5, 50) * 0.001;\n\tef_td = clamp(ef_rel, 10, 1000) * 0.001;\n\tif (ef_tg > ef_e) {\n\t\tef_e = ef_e + (1 - exp(-1 / (ef_tc * fs))) * (ef_tg - ef_e);       // C9 charges through R17\n\t} else {\n\t\tef_e = max(ef_tg, (ef_e + 9) * exp(-1 / (ef_td * fs)) - 9);        // drains through R18 toward -9 V\n\t}\n\tef_lt = ef_up > 0.5 ? ef_e : max(7.2 - ef_e, 0);                  // A6: LED current x R23\n\tef_lq = log10(max(min(ef_lt, 5.6) * 0.2564102564102564, 0.000001));   // log10(LED mA)\n\tef_lk = ef_lq >= -1 ? 1.30166519 - 0.99354299 * ef_lq + 0.16560469 * ef_lq * ef_lq : 2.46081287 - 1.32475236 * (ef_lq + 1);\n\tef_lg = 1 / (1000 * exp(2.30258509 * ef_lk)) + 0.0000001;                        // P873-13 equilibrium conductance (fig. 5)\n\tef_ld = max(ef_ld + 454545.45454545453 * (ef_lg * ef_lg - ef_ld * ef_ld) / fs, 0.0000001);   // CdS recombination: dG/dt = k (Geq^2 - G^2)\n\tef_rx = 1 / (4.5454545454545455e-06 + ef_ld);                                   // R10 / R12 220k || LDR\n\tef_fr = 1 / (6.28318531 * ef_rx * (ef_range > 0.5 ? 1.8e-9 : 4.0e-9));\n\tef_ps = clamp(log2(220000.0 / ef_rx) * 0.2466735228647925, 0, 1);              // 0 at rest, 1 at the rail\n\tef_ps = ef_up > 0.5 ? ef_ps : -(1 - ef_ps);\n\tef_rl = ef_to_l * ef_ps;\n\tef_rh = ef_to_h * ef_ps;\n\tef_rb = ef_to_b * ef_ps;\n}\nif (ef_en > 0) {\n\tef_gq = tan(pi * min(ef_fr, 0.45 * fs) / fs);\n\tef_rp = 150000 * (exp(clamp(ef_peak, 0, 100) * 0.04394) - 1) * 0.0125057;   // PEAK 150k CW log (10 % at mid)\n\tef_rf = 12000 + ef_rp;                       // R9 + PEAK\n\tef_R = 4700 / (4700 + ef_rf);                 // b = 1/(2Q)\n\tef_a2 = 2 * ef_rf / (4700 + ef_rf);           // 2a: summer gain\n\tef_og = exp2(clamp(ef_out, -24, 12) * 0.166096405);\n\tef_sn = 1 / (1 + 2 * ef_R * ef_gq + ef_gq * ef_gq);\n\tefh_L = (ef_pL * ef_a2 - (2 * ef_R + ef_gq) * H_ef_L1 - H_ef_L2) * ef_sn;\n\tefh_L = 7.5 * tanh(efh_L * 0.13333333333333333);\n\tefb_L = 7.5 * tanh((ef_gq * efh_L + H_ef_L1) * 0.13333333333333333);\n\tefl_L = 7.5 * tanh((ef_gq * efb_L + H_ef_L2) * 0.13333333333333333);\n\tef_L1 = 2 * efb_L - H_ef_L1;\n\tef_L2 = 2 * efl_L - H_ef_L2;\n\tefo_L = (ef_mode < 0.5 ? efl_L : (ef_mode < 1.5 ? efb_L : efh_L)) * ef_og;\n\tefo_L = efo_L == efo_L ? efo_L : 0;\n\tx_L = x_L + ef_en * ef_mx * (efo_L - x_L);\n\tH_ef_L1 = fixdenorm(ef_L1);\n\tH_ef_L2 = fixdenorm(ef_L2);\n\tefh_R = (ef_pR * ef_a2 - (2 * ef_R + ef_gq) * H_ef_R1 - H_ef_R2) * ef_sn;\n\tefh_R = 7.5 * tanh(efh_R * 0.13333333333333333);\n\tefb_R = 7.5 * tanh((ef_gq * efh_R + H_ef_R1) * 0.13333333333333333);\n\tefl_R = 7.5 * tanh((ef_gq * efb_R + H_ef_R2) * 0.13333333333333333);\n\tef_R1 = 2 * efb_R - H_ef_R1;\n\tef_R2 = 2 * efl_R - H_ef_R2;\n\tefo_R = (ef_mode < 0.5 ? efl_R : (ef_mode < 1.5 ? efb_R : efh_R)) * ef_og;\n\tefo_R = efo_R == efo_R ? efo_R : 0;\n\tx_R = x_R + ef_en * ef_mx * (efo_R - x_R);\n\tH_ef_R1 = fixdenorm(ef_R1);\n\tH_ef_R2 = fixdenorm(ef_R2);\n}\nH_ef_en = ef_en;\nH_ef_mx = ef_mx;\nH_ef_e = fixdenorm(ef_e);\nH_ef_ld = fixdenorm(ef_ld);\n\nfault = 0;\n\n// ---- load state ----\nl_L_sh_s1a = H_l_L_sh_s1a;\nl_L_sh_s2a = H_l_L_sh_s2a;\nl_L_sh_ba = H_l_L_sh_ba;\nl_L_sh_s1b = H_l_L_sh_s1b;\nl_L_sh_s2b = H_l_L_sh_s2b;\nl_L_sh_bb = H_l_L_sh_bb;\nl_L_sh_yp = H_l_L_sh_yp;\nl_L_sh_pa = H_l_L_sh_pa;\nl_L_sh_pb = H_l_L_sh_pb;\nl_L_sh_hha = H_l_L_sh_hha;\nl_L_sh_hba = H_l_L_sh_hba;\nl_L_sh_hla = H_l_L_sh_hla;\nl_L_sh_hhb = H_l_L_sh_hhb;\nl_L_sh_hbb = H_l_L_sh_hbb;\nl_L_sh_hlb = H_l_L_sh_hlb;\nl_L_sh_eb = H_l_L_sh_eb;\nl_R_sh_s1a = H_l_R_sh_s1a;\nl_R_sh_s2a = H_l_R_sh_s2a;\nl_R_sh_ba = H_l_R_sh_ba;\nl_R_sh_s1b = H_l_R_sh_s1b;\nl_R_sh_s2b = H_l_R_sh_s2b;\nl_R_sh_bb = H_l_R_sh_bb;\nl_R_sh_yp = H_l_R_sh_yp;\nl_R_sh_pa = H_l_R_sh_pa;\nl_R_sh_pb = H_l_R_sh_pb;\nl_R_sh_hha = H_l_R_sh_hha;\nl_R_sh_hba = H_l_R_sh_hba;\nl_R_sh_hla = H_l_R_sh_hla;\nl_R_sh_hhb = H_l_R_sh_hhb;\nl_R_sh_hbb = H_l_R_s